@model List<Course>
@{
    ViewData["Title"] = "Catalogo Corsi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-bocconi mb-0"><i class="bi bi-book me-2"></i>Catalogo Corsi</h2>
    @if (User.IsInRole("Teacher") || User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-bocconi">
            <i class="bi bi-plus-lg me-1"></i>Nuovo corso
        </a>
    }
</div>

<div class="mb-3">
    <input type="text" id="searchInput" class="form-control" placeholder="Cerca corso..." />
</div>

@if (Model.Any())
{
    <div class="row g-3" id="coursesGrid">
        @foreach (var c in Model)
        {
            <div class="col-md-4 course-card" data-title="@c.Title.ToLower()" data-cat="@c.Category.ToLower()">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="badge" style="background-color:var(--bocconi-blue);">@c.Category</span>
                            <small class="text-muted"><i class="bi bi-people me-1"></i>@c.EnrolledCount</small>
                        </div>
                        <h5 class="card-title fw-bold">@c.Title</h5>
                        <p class="card-text text-muted small">
                            @(c.Description.Length > 120 ? c.Description[..120] + "..." : c.Description)
                        </p>
                        <div class="text-muted small">
                            <i class="bi bi-person me-1"></i>@c.TeacherName
                            @if (c.StartDate.HasValue)
                            {
                                <span class="ms-3"><i class="bi bi-calendar me-1"></i>@c.StartDate.Value.ToString("MMM yyyy")</span>
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-bocconi w-100">
                            Scopri il corso <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-book display-1 text-muted"></i>
        <p class="mt-3 text-muted">Nessun corso disponibile al momento.</p>
    </div>
}

@section Scripts {
    <script>
        $('#searchInput').on('keyup', function() {
            var val = $(this).val().toLowerCase();
            $('.course-card').each(function() {
                var title = $(this).data('title');
                var cat = $(this).data('cat');
                $(this).toggle(title.includes(val) || cat.includes(val));
            });
        });
    </script>
}
