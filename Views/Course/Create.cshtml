@model CourseFormViewModel
@{
    ViewData["Title"] = "Nuovo corso";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <h2 class="fw-bold text-bocconi mb-4"><i class="bi bi-plus-circle me-2"></i>Crea nuovo corso</h2>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    @await Html.PartialAsync("_CourseForm", Model)
                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-bocconi px-4">Crea corso</button>
                        <a asp-action="Dashboard" class="btn btn-outline-secondary">Annulla</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
