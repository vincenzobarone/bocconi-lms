@model List<Enrollment>
@{
    var course = ViewBag.Course as Course;
    ViewData["Title"] = $"{T["course.students"]} - {course?.Title}";
}


<h2 class="fw-bold text-bocconi mb-4"><i class="bi bi-people me-2"></i>@T["course.enrolled_students"]</h2>

@if (Model.Any())
{
    <div class="card">
        <div class="card-body">
            <table id="studentsTable" class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th scope="col">@T["course.col_student"]</th>
                        <th scope="col">@T["course.col_enrolled_at"]</th>
                        <th scope="col">@T["course.col_completed_lessons"]</th>
                        <th scope="col">@T["course.col_progress"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td><i class="bi bi-person-circle me-2 text-muted"></i>@e.UserName</td>
                            <td>@e.EnrolledAt.ToString("dd/MM/yyyy")</td>
                            <td>@e.CompletedLessons / @e.TotalLessons</td>
                            <td style="min-width:150px;">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1">
                                        <div class="progress-bar" style="width:@e.ProgressPercent%; background-color:var(--bocconi-blue);"></div>
                                    </div>
                                    <small class="fw-semibold">@e.ProgressPercent%</small>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>@T["course.no_students"]</div>
}

@section Scripts {
    <script>$(document).ready(function(){ $('#studentsTable').DataTable({ language: window.dtLang() }); });</script>
}
