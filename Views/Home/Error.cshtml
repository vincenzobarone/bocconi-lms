@{
    ViewData["Title"] = T["error.page_title", "Errore"];
}
<div class="text-center py-5">
    <i class="bi bi-exclamation-triangle-fill display-1 text-danger"></i>
    <h2 class="mt-3">@T["error.heading", "Si è verificato un errore"]</h2>
    <p class="text-muted">@T["error.message", "Riprova o contatta il supporto tecnico."]</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-bocconi">@T["error.back_home", "Torna alla home"]</a>
</div>
