@{
    ViewData["Title"] = T["error.page_title"];
}
<div class="text-center py-5">
    <i class="bi bi-exclamation-triangle-fill display-1 text-danger"></i>
    <h2 class="mt-3">@T["error.heading"]</h2>
    <p class="text-muted">@T["error.message"]</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-bocconi">@T["error.back_home"]</a>
</div>
