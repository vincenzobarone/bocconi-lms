@model List<Course>
@{
    ViewData["Title"] = T["nav.dashboard"];
}

@if (ViewBag.DbError == true)
{
    <div class="alert alert-warning d-flex align-items-center gap-3 mb-4" role="alert">
        <i class="bi bi-database-exclamation fs-4"></i>
        <div>
            <strong>@T["home.db_error"]</strong>
            @T["home.db_error_detail"]
        </div>
    </div>
}

<div class="py-5 text-center bg-bocconi text-white rounded-3 mb-4" style="background: linear-gradient(135deg, #003087, #0050c8) !important;">
    <i class="bi bi-mortarboard-fill display-4 mb-3 d-block" style="color: #c8a96e;"></i>
    <h1 class="fw-bold">Bocconi LMS</h1>
    <p class="lead mb-4">@T["home.tagline"]</p>
    @if (!User.Identity!.IsAuthenticated)
    {
        <a asp-controller="Account" asp-action="Login" class="btn btn-lg me-2" style="background:#c8a96e; color:#fff; border:none;">
            <i class="bi bi-box-arrow-in-right me-2"></i>@T["home.btn_login"]
        </a>
    }
    else
    {
        <a asp-controller="Home" asp-action="Dashboard" class="btn btn-lg me-2" style="background:#c8a96e; color:#fff; border:none;">
            <i class="bi bi-speedometer2 me-2"></i>@T["nav.dashboard"]
        </a>
    }
    <a asp-controller="Course" asp-action="Index" class="btn btn-lg btn-outline-light">
        <i class="bi bi-book me-2"></i>@T["home.btn_explore"]
    </a>
</div>

<div class="row g-3 mb-4 text-center">
    <div class="col-md-4">
        <div class="card p-4 stat-card">
            <i class="bi bi-book-fill display-5 text-bocconi mb-2"></i>
            <h5 class="fw-bold">@T["home.feature_courses"]</h5>
            <p class="text-muted mb-0">@T["home.feature_courses_desc"]</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 stat-card gold">
            <i class="bi bi-files display-5 mb-2" style="color:#c8a96e;"></i>
            <h5 class="fw-bold">@T["home.feature_docs"]</h5>
            <p class="text-muted mb-0">@T["home.feature_docs_desc"]</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 stat-card">
            <i class="bi bi-clipboard2-check-fill display-5 text-bocconi mb-2"></i>
            <h5 class="fw-bold">@T["home.feature_quiz"]</h5>
            <p class="text-muted mb-0">@T["home.feature_quiz_desc"]</p>
        </div>
    </div>
</div>

@if (Model.Any())
{
    <h3 class="fw-semibold mb-3">@T["home.featured"]</h3>
    <div class="row g-3">
        @foreach (var c in Model)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">@c.Category</span>
                        <h5 class="card-title">@c.Title</h5>
                        <p class="card-text text-muted small">@(c.Description.Length > 100 ? c.Description[..100] + "..." : c.Description)</p>
                        <div class="d-flex justify-content-between text-muted small">
                            <span><i class="bi bi-person me-1"></i>@c.TeacherName</span>
                            <span><i class="bi bi-people me-1"></i>@c.EnrolledCount @T.T("course.enrolled_count", "iscritti")</span>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent">
                        @if (User.Identity!.IsAuthenticated)
                        {
                            <a asp-controller="Course" asp-action="Details" asp-route-id="@c.Id"
                               class="btn btn-sm btn-bocconi w-100">@T.T("course.discover", "Scopri il corso")</a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login"
                               asp-route-returnUrl="@Url.Action("Details","Course",new{id=c.Id})"
                               class="btn btn-sm btn-bocconi w-100">@T.T("course.discover", "Scopri il corso")</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
