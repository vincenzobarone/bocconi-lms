@model DashboardViewModel
@{
    ViewData["Title"] = Model.IsAdmin
        ? T["dashboard.admin.title"]
        : T["dashboard.title"];
}

<div class="mb-4 d-flex align-items-center justify-content-between">
    <h2 class="fw-bold text-bocconi mb-0">
        @if (Model.IsAdmin)
        {
            <i class="bi bi-shield-lock-fill me-2"></i>@T["dashboard.admin.title"]
        }
        else
        {
            <i class="bi bi-house-door-fill me-2"></i>@T["dashboard.title"]
        }
    </h2>
    @if (!Model.IsPending)
    {
        var langCode = T.CurrentLanguage;
        var cultureTag = langCode == "en" ? "en-GB" : langCode == "es" ? "es-ES" : langCode == "de" ? "de-DE" : "it-IT";
        var cult = new System.Globalization.CultureInfo(cultureTag);
        <div class="text-muted small d-flex align-items-center gap-3 flex-wrap">
            <span><i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("dddd d MMMM yyyy", cult)</span>
            <span class="vr d-none d-sm-block"></span>
            <span>
                <i class="bi bi-clock me-1"></i><span id="liveClock">--:--:--</span>
                <span class="badge bg-light text-secondary border ms-1 fw-normal d-none" id="localTimeBadge"
                      title="@T["dashboard.local_time"]"></span>
            </span>
        </div>
    }
</div>

@* ── Utente in attesa di ruolo ────────────────────────────────────────────── *@
@if (Model.IsPending)
{
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-warning shadow-sm">
                <div class="card-body text-center p-5">
                    <i class="bi bi-hourglass-split display-3 text-warning mb-3 d-block"></i>
                    <h4 class="fw-bold">@T["dashboard.pending.title"]</h4>
                    <p class="text-muted mb-0">
                        @T["dashboard.pending.desc"]
                    </p>
                </div>
            </div>
        </div>
    </div>
}

@* ── Admin ────────────────────────────────────────────────────────────────── *@
@if (Model.IsAdmin)
{
    @* Shortcut cards *@
    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center p-4">
                    <i class="bi bi-sliders display-4 text-bocconi mb-3 d-block"></i>
                    <h5 class="fw-bold">@T["admin.platform_settings"]</h5>
                    <p class="text-muted">@T["admin.platform_settings_desc"]</p>
                    <a asp-controller="Admin" asp-action="PlatformFeatures" class="btn btn-bocconi">
                        @T["admin.configure"]
                    </a>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center p-4">
                    <i class="bi bi-envelope-at display-4 text-bocconi mb-3 d-block"></i>
                    <h5 class="fw-bold">@T["admin.email_settings"]</h5>
                    <p class="text-muted">@T["admin.email_settings_desc"]</p>
                    <a asp-controller="Admin" asp-action="EmailSettings" class="btn btn-bocconi">
                        @T["admin.configure_email"]
                    </a>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center p-4">
                    <i class="bi bi-database-gear display-4 text-bocconi mb-3 d-block"></i>
                    <h5 class="fw-bold">@T["admin.database"]</h5>
                    <p class="text-muted">@T["admin.database_desc"]</p>
                    <a asp-controller="Admin" asp-action="Database" class="btn btn-bocconi">
                        @T["admin.database_manage"]
                    </a>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center p-4">
                    <i class="bi bi-list-columns-reverse display-4 text-bocconi mb-3 d-block"></i>
                    <h5 class="fw-bold">@T["admin.system_logs"]</h5>
                    <p class="text-muted">@T["admin.system_logs_desc"]</p>
                    <a asp-controller="Admin" asp-action="SystemLogs" class="btn btn-bocconi">
                        @T["admin.system_logs_open"]
                    </a>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center p-4">
                    <i class="bi bi-key-fill display-4 text-bocconi mb-3 d-block"></i>
                    <h5 class="fw-bold">@T["admin.api_keys"]</h5>
                    <p class="text-muted">@T["admin.api_keys_desc"]</p>
                    <a asp-controller="Admin" asp-action="ApiKeys" class="btn btn-bocconi">
                        @T["admin.api_keys_manage"]
                    </a>
                </div>
            </div>
        </div>
    </div>

    @* Statistiche piattaforma *@
    @if (Model.AdminStats != null && (Model.CoursesEnabled || Model.MaterialsEnabled))
    {
        <h5 class="text-muted fw-semibold mb-3">
            <i class="bi bi-bar-chart-fill me-2"></i>@T["dashboard.admin.stats"]
        </h5>
        <div class="row g-3">
            @if (Model.CoursesEnabled)
            {
                <div class="col-6 col-md-3">
                    <div class="card text-center border-0 bg-light shadow-sm h-100">
                        <div class="card-body py-3">
                            <div class="display-6 fw-bold text-bocconi">@Model.AdminStats.TotalCourses</div>
                            <small class="text-muted">@T["dashboard.admin.courses"]</small>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center border-0 bg-light shadow-sm h-100">
                        <div class="card-body py-3">
                            <div class="display-6 fw-bold text-bocconi">@Model.AdminStats.ActiveStudents</div>
                            <small class="text-muted">@T["dashboard.admin.students"]</small>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center border-0 bg-light shadow-sm h-100">
                        <div class="card-body py-3">
                            <div class="display-6 fw-bold text-bocconi">@Model.AdminStats.ActiveTeachers</div>
                            <small class="text-muted">@T["dashboard.admin.teachers"]</small>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center border-0 bg-light shadow-sm h-100">
                        <div class="card-body py-3">
                            <div class="display-6 fw-bold text-bocconi">@Model.AdminStats.TotalEnrollments</div>
                            <small class="text-muted">@T["dashboard.admin.enrollments"]</small>
                        </div>
                    </div>
                </div>
            }
            @if (Model.MaterialsEnabled)
            {
                <div class="col-6 col-md-3">
                    <div class="card text-center border-0 bg-light shadow-sm h-100">
                        <div class="card-body py-3">
                            <div class="display-6 fw-bold text-bocconi">@Model.TotalMaterials</div>
                            <small class="text-muted">@T["dashboard.admin.materials"]</small>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center border-0 bg-light shadow-sm h-100">
                        <div class="card-body py-3">
                            <div class="display-6 fw-bold text-success">@Model.RecentMaterials</div>
                            <small class="text-muted">@T["dashboard.materials.recent"]</small>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center border-0 bg-light shadow-sm h-100">
                        <div class="card-body py-3">
                            <div class="display-6 fw-bold text-bocconi">@Model.AdminStats.TotalUsers</div>
                            <small class="text-muted">@T["dashboard.admin.users"]</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@* ── Docente ──────────────────────────────────────────────────────────────── *@
@if (Model.IsTeacher && !Model.IsAdmin)
{
    @* Contatori sintetici *@
    <div class="row g-3 mb-4">
        @if (Model.CoursesEnabled)
        {
            <div class="col-6 col-md-3">
                <div class="card text-center border-0 shadow-sm h-100">
                    <div class="card-body py-4">
                        <i class="bi bi-book-fill fs-2 text-bocconi mb-2 d-block"></i>
                        <div class="display-6 fw-bold">@Model.TeacherCourseCount</div>
                        <small class="text-muted">@T["dashboard.teacher.courses"]</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card text-center border-0 shadow-sm h-100">
                    <div class="card-body py-4">
                        <i class="bi bi-people-fill fs-2 text-bocconi mb-2 d-block"></i>
                        <div class="display-6 fw-bold">@Model.TeacherStudentCount</div>
                        <small class="text-muted">@T["dashboard.teacher.students"]</small>
                    </div>
                </div>
            </div>
        }
        @if (Model.MaterialsEnabled)
        {
            <div class="col-6 col-md-3">
                <div class="card text-center border-0 shadow-sm h-100">
                    <div class="card-body py-4">
                        <i class="bi bi-folder2-open fs-2 text-bocconi mb-2 d-block"></i>
                        <div class="display-6 fw-bold">@Model.TotalMaterials</div>
                        <small class="text-muted">@T["dashboard.materials.total"]</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card text-center border-0 shadow-sm h-100">
                    <div class="card-body py-4">
                        <i class="bi bi-clock-history fs-2 text-success mb-2 d-block"></i>
                        <div class="display-6 fw-bold text-success">@Model.RecentMaterials</div>
                        <small class="text-muted">@T["dashboard.materials.recent"]</small>
                    </div>
                </div>
            </div>
        }
    </div>

    @* Card preview corsi del docente *@
    @if (Model.CoursesEnabled)
    {
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="fw-semibold mb-0">
                <i class="bi bi-collection-play me-2 text-bocconi"></i>@T["dashboard.teacher.my_courses"]
            </h5>
            <a asp-controller="Course" asp-action="Create" class="btn btn-bocconi btn-sm">
                <i class="bi bi-plus-lg me-1"></i>@T["course.create"]
            </a>
        </div>

        @if (Model.TeacherCourses.Any())
        {
            <div class="row g-3 mb-4">
                @foreach (var c in Model.TeacherCourses)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 teacher-course-card" style="overflow:hidden;">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                                    <h6 class="fw-bold mb-0 lh-sm">
                                        <a asp-controller="Course" asp-action="Stats" asp-route-id="@c.Id"
                                           class="stretched-link text-decoration-none text-dark">@c.Title</a>
                                    </h6>
                                    @if (c.IsPublished)
                                    {
                                        <span class="badge bg-success text-nowrap flex-shrink-0" style="position:relative;z-index:1;">
                                            <i class="bi bi-globe2 me-1"></i>@T["course.published"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-nowrap flex-shrink-0" style="position:relative;z-index:1;">
                                            <i class="bi bi-pencil-square me-1"></i>@T["course.draft"]
                                        </span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(c.Description))
                                {
                                    <p class="text-muted small mb-3 flex-grow-1" style="
                                        display: -webkit-box;
                                        -webkit-line-clamp: 3;
                                        -webkit-box-orient: vertical;
                                        overflow: hidden;">@c.Description</p>
                                }
                                else
                                {
                                    <p class="text-muted small fst-italic mb-3 flex-grow-1">@T["course.no_description"]</p>
                                }

                                <div class="d-flex align-items-center justify-content-between mt-auto pt-2 border-top"
                                     style="position:relative;z-index:1;">
                                    <span class="small text-muted">
                                        <i class="bi bi-collection me-1"></i>
                                        @c.LessonCount @T["common.lessons"]
                                        @if (c.EnrolledCount > 0)
                                        {
                                            <span class="ms-2">
                                                <i class="bi bi-people me-1"></i>@c.EnrolledCount
                                            </span>
                                        }
                                    </span>
                                    <a asp-controller="Course" asp-action="Details" asp-route-id="@c.Id"
                                       class="btn btn-sm btn-outline-bocconi" style="position:relative;z-index:1;">
                                        <i class="bi bi-pencil-square me-1"></i>@T["dashboard.teacher.manage_btn"]
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info mb-4">
                <i class="bi bi-info-circle me-2"></i>@T["dashboard.teacher.no_courses"]
                <a asp-controller="Course" asp-action="Create">@T["dashboard.teacher.create_first"]</a>.
            </div>
        }
    }
}

@* ── Studente ─────────────────────────────────────────────────────────────── *@
@if (Model.IsStudent && !Model.IsAdmin)
{
    <div class="row g-3 mb-4">
        @if (Model.CoursesEnabled)
        {
            <div class="col-6 col-md-3">
                <div class="card text-center border-0 shadow-sm h-100">
                    <div class="card-body py-4">
                        <i class="bi bi-collection-play-fill fs-2 text-bocconi mb-2 d-block"></i>
                        <div class="display-6 fw-bold">@Model.StudentEnrolledCount</div>
                        <small class="text-muted">@T["dashboard.student.enrolled"]</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card text-center border-0 shadow-sm h-100">
                    <div class="card-body py-4">
                        <i class="bi bi-patch-check-fill fs-2 text-success mb-2 d-block"></i>
                        <div class="display-6 fw-bold text-success">@Model.StudentCompletedLessons</div>
                        <small class="text-muted">@T["dashboard.student.completed"]</small>
                    </div>
                </div>
            </div>
        }
        @if (Model.MaterialsEnabled)
        {
            <div class="col-6 col-md-3">
                <div class="card text-center border-0 shadow-sm h-100">
                    <div class="card-body py-4">
                        <i class="bi bi-folder2-open fs-2 text-bocconi mb-2 d-block"></i>
                        <div class="display-6 fw-bold">@Model.TotalMaterials</div>
                        <small class="text-muted">@T["dashboard.materials.total"]</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card text-center border-0 shadow-sm h-100">
                    <div class="card-body py-4">
                        <i class="bi bi-clock-history fs-2 text-info mb-2 d-block"></i>
                        <div class="display-6 fw-bold text-info">@Model.RecentMaterials</div>
                        <small class="text-muted">@T["dashboard.materials.recent"]</small>
                    </div>
                </div>
            </div>
        }
    </div>

    @* ── Elenco corsi con barra di avanzamento ─────────────────────────── *@
    @if (Model.CoursesEnabled)
    {
        <h5 class="fw-semibold mb-3 mt-2">@T["dashboard.student.my_courses"]</h5>
        @if (Model.StudentEnrollments.Any())
        {
            <div class="row g-3 mb-4">
                @foreach (var e in Model.StudentEnrollments)
                {
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h6 class="fw-bold mb-2">@e.CourseTitle</h6>
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>@e.CompletedLessons / @e.TotalLessons @T["common.lessons"]</span>
                                    <span class="fw-semibold @(e.ProgressPercent == 100 ? "text-success" : "text-bocconi")">@e.ProgressPercent%</span>
                                </div>
                                <div class="progress mb-3" style="height:6px;">
                                    <div class="progress-bar" role="progressbar"
                                         style="width:@e.ProgressPercent%; background-color:var(--bocconi-blue)!important;"
                                         aria-valuenow="@e.ProgressPercent" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                                <a asp-controller="Course" asp-action="Details" asp-route-id="@e.CourseId"
                                   class="btn btn-sm btn-outline-secondary w-100">
                                    @(e.ProgressPercent == 100
                                        ? T["dashboard.student.review_btn"]
                                        : T["dashboard.student.continue_btn"])
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info mb-4">
                <i class="bi bi-info-circle me-2"></i>@T["dashboard.student.no_courses"]
                <a asp-controller="Course" asp-action="Index">@T["dashboard.student.explore_catalog"]</a>.
            </div>
        }
    }

    @* ── Ultimi tentativi quiz ──────────────────────────────────────────── *@
    @if (Model.StudentRecentAttempts.Any())
    {
        <h5 class="fw-semibold mb-3">@T["dashboard.student.recent_quizzes"]</h5>
        <div class="table-responsive mb-4">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th scope="col">@T["quiz.col_quiz"]</th>
                        <th scope="col">@T["quiz.col_score"]</th>
                        <th scope="col">@T["quiz.col_result"]</th>
                        <th scope="col">@T["quiz.col_date"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.StudentRecentAttempts)
                    {
                        <tr>
                            <td>@a.QuizTitle</td>
                            <td><strong>@a.Score%</strong> <small class="text-muted">(@a.CorrectAnswers/@a.TotalQuestions)</small></td>
                            <td>
                                @if (a.Passed)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>@T["quiz.passed"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>@T["quiz.failed"]</span>
                                }
                            </td>
                            <td class="text-muted small">@a.AttemptedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@* ── Ruolo personalizzato (non Admin, Teacher, Student) ────────────────────── *@
@if (!Model.IsAdmin && !Model.IsTeacher && !Model.IsStudent && !Model.IsPending)
{
    <div class="row g-3 mb-4">
        @if (Model.MaterialsEnabled)
        {
            <div class="col-6 col-md-4">
                <div class="card text-center border-0 shadow-sm h-100">
                    <div class="card-body py-4">
                        <i class="bi bi-folder2-open fs-2 text-bocconi mb-2 d-block"></i>
                        <div class="display-6 fw-bold">@Model.TotalMaterials</div>
                        <small class="text-muted">@T["dashboard.materials.total"]</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="card text-center border-0 shadow-sm h-100">
                    <div class="card-body py-4">
                        <i class="bi bi-clock-history fs-2 text-success mb-2 d-block"></i>
                        <div class="display-6 fw-bold text-success">@Model.RecentMaterials</div>
                        <small class="text-muted">@T["dashboard.materials.recent"]</small>
                    </div>
                </div>
            </div>
        }
        @if (!Model.MaterialsEnabled && !Model.CoursesEnabled)
        {
            <div class="col-12">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    @T["dashboard.no_modules"]
                </div>
            </div>
        }
    </div>

}

@section Scripts {
    <script>
        (function () {
            var clockEl  = document.getElementById('liveClock');
            var badgeEl  = document.getElementById('localTimeBadge');
            if (!clockEl) return;

            var platformTz = @Json.Serialize(Model.PlatformTimezone);
            var browserTz  = Intl.DateTimeFormat().resolvedOptions().timeZone;

            var fmtPlatform = new Intl.DateTimeFormat(undefined, {
                timeZone: platformTz,
                hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false
            });
            var fmtBrowser = new Intl.DateTimeFormat(undefined, {
                timeZone: browserTz,
                hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false
            });

            function tick() {
                var now = new Date();
                clockEl.textContent = fmtPlatform.format(now);

                if (badgeEl && platformTz !== browserTz) {
                    badgeEl.textContent = '📍 ' + fmtBrowser.format(now);
                    badgeEl.title = browserTz;
                    badgeEl.classList.remove('d-none');
                }
            }

            tick();
            setInterval(tick, 1000);
        })();
    </script>
}
