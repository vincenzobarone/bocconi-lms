@using BocconiLMS.Data
@model TranslationRow
@{
    ViewData["Title"] = T["admin.translations.edit_title"] + ": " + Model.Key;
    var enabled = ViewBag.EnabledLanguages as List<string> ?? new List<string> { "en", "it", "es", "de" };
    bool showIt = enabled.Contains("it");
    bool showEs = enabled.Contains("es");
    bool showDe = enabled.Contains("de");
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Translations">@T["admin.translations.page_title"]</a></li>
        <li class="breadcrumb-item active font-monospace">@Model.Key</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <h2 class="fw-bold text-bocconi mb-1">
            <i class="bi bi-translate me-2"></i>@T["admin.translations.edit_title"]
        </h2>
        <p class="text-muted mb-4 font-monospace small">@Model.Key</p>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="EditTranslation" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Key" value="@Model.Key" />

                    @* ── English (sempre visibile come base/fallback) ───────── *@
                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            <span class="me-2">🇬🇧</span>English (base)
                            <span class="badge bg-secondary ms-1 fw-normal">EN</span>
                        </label>
                        <textarea name="En" class="form-control" rows="3"
                                  placeholder="English default value">@Model.En</textarea>
                        <div class="form-text">@T["admin.translations.en_hint"]</div>
                    </div>

                    @* ── Italiano ──────────────────────────────────────────── *@
                    @if (showIt)
                    {
                        <hr class="my-3" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <span class="me-2">🇮🇹</span>Italiano
                                <span class="badge bg-success ms-1 fw-normal">IT</span>
                            </label>
                            <textarea name="It" class="form-control" rows="3"
                                      placeholder="Traduzione italiana">@Model.It</textarea>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" name="It" value="@Model.It" />
                    }

                    @* ── Español ───────────────────────────────────────────── *@
                    @if (showEs)
                    {
                        <hr class="my-3" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <span class="me-2">🇪🇸</span>Español
                                <span class="badge bg-danger ms-1 fw-normal">ES</span>
                            </label>
                            <textarea name="Es" class="form-control" rows="3"
                                      placeholder="Traducción española">@Model.Es</textarea>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" name="Es" value="@Model.Es" />
                    }

                    @* ── Deutsch ───────────────────────────────────────────── *@
                    @if (showDe)
                    {
                        <hr class="my-3" />
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <span class="me-2">🇩🇪</span>Deutsch
                                <span class="badge bg-warning text-dark ms-1 fw-normal">DE</span>
                            </label>
                            <textarea name="De" class="form-control" rows="3"
                                      placeholder="Deutsche Übersetzung">@Model.De</textarea>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" name="De" value="@Model.De" />
                    }

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-bocconi px-4">
                            <i class="bi bi-check-lg me-1"></i>@T["admin.translations.save_btn"]
                        </button>
                        <a asp-action="Translations" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>@T["common.back"]
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
