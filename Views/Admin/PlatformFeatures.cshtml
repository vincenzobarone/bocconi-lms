@using BocconiLMS.Services
@{
    ViewData["Title"] = T["admin.platform_settings","Platform Settings"];
    bool coursesEnabled   = ViewBag.CoursesEnabled == true;
    bool materialsEnabled = ViewBag.MaterialsEnabled != false;
    var enabledLangs      = ViewBag.EnabledLanguages as List<string> ?? new List<string> { "en" };
    var missing           = ViewBag.MissingCounts as Dictionary<string, int> ?? new();
    var allOtherLangs     = TranslationService.AllLanguages.Where(l => l.Code != "en").ToList();
    var currentTz         = ViewBag.PlatformTimezone as string ?? "Europe/Rome";

    var timezones = new (string Group, (string Id, string Label)[] Zones)[]
    {
        ("Europa", new[]
        {
            ("Europe/Rome",      "🇮🇹 Roma (IT)"),
            ("Europe/London",    "🇬🇧 Londra (UK)"),
            ("Europe/Paris",     "🇫🇷 Parigi (FR)"),
            ("Europe/Berlin",    "🇩🇪 Berlino (DE)"),
            ("Europe/Madrid",    "🇪🇸 Madrid (ES)"),
            ("Europe/Zurich",    "🇨🇭 Zurigo (CH)"),
            ("Europe/Amsterdam", "🇳🇱 Amsterdam (NL)"),
            ("Europe/Lisbon",    "🇵🇹 Lisbona (PT)"),
            ("Europe/Warsaw",    "🇵🇱 Varsavia (PL)"),
            ("Europe/Moscow",    "🇷🇺 Mosca (RU)"),
        }),
        ("Americas", new[]
        {
            ("America/New_York",    "🇺🇸 New York (ET)"),
            ("America/Chicago",     "🇺🇸 Chicago (CT)"),
            ("America/Denver",      "🇺🇸 Denver (MT)"),
            ("America/Los_Angeles", "🇺🇸 Los Angeles (PT)"),
            ("America/Toronto",     "🇨🇦 Toronto (ET)"),
            ("America/Sao_Paulo",   "🇧🇷 São Paulo"),
            ("America/Buenos_Aires","🇦🇷 Buenos Aires"),
            ("America/Mexico_City", "🇲🇽 Mexico City"),
        }),
        ("Asia / Pacifico", new[]
        {
            ("Asia/Dubai",    "🇦🇪 Dubai (GST)"),
            ("Asia/Kolkata",  "🇮🇳 Mumbai/Kolkata (IST)"),
            ("Asia/Bangkok",  "🇹🇭 Bangkok (ICT)"),
            ("Asia/Shanghai", "🇨🇳 Shanghai (CST)"),
            ("Asia/Tokyo",    "🇯🇵 Tokyo (JST)"),
            ("Asia/Seoul",    "🇰🇷 Seoul (KST)"),
            ("Australia/Sydney","🇦🇺 Sydney (AEDT)"),
            ("Pacific/Auckland","🇳🇿 Auckland (NZDT)"),
        }),
        ("Africa", new[]
        {
            ("Africa/Cairo",  "🇪🇬 Cairo (EET)"),
            ("Africa/Lagos",  "🇳🇬 Lagos (WAT)"),
            ("Africa/Nairobi","🇰🇪 Nairobi (EAT)"),
        }),
        ("UTC", new[]
        {
            ("UTC", "🌐 UTC"),
        }),
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-bocconi mb-0">
        <i class="bi bi-sliders me-2"></i>@T["admin.platform_settings","Platform Settings"]
    </h2>
    <a asp-controller="Home" asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>@T["common.back_to_panel","Back to panel"]
    </a>
</div>

@* ── Active Languages ──────────────────────────────────────────────── *@
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold">
        <i class="bi bi-globe me-2 text-bocconi"></i>@T["admin.lang.settings","Active Languages"]
    </div>
    <div class="card-body">
        <form asp-action="SaveLanguageSettings" method="post" class="d-flex align-items-center gap-4 flex-wrap">
            @Html.AntiForgeryToken()
            <div class="d-flex align-items-center gap-1">
                <input class="form-check-input" type="checkbox" checked disabled />
                <label class="form-check-label ms-1">🇬🇧 English (EN)</label>
                <input type="hidden" name="enabledLanguages" value="en" />
                <span class="badge bg-secondary ms-1">@T["admin.lang.required","required"]</span>
            </div>
            @foreach (var lang in allOtherLangs)
            {
                var isEnabled = enabledLangs.Contains(lang.Code);
                var mis = missing.GetValueOrDefault(lang.Code, 0);
                <div class="d-flex align-items-center gap-1">
                    <input class="form-check-input" type="checkbox"
                           name="enabledLanguages" value="@lang.Code"
                           id="lang_@lang.Code" @(isEnabled ? "checked" : "") />
                    <label class="form-check-label ms-1" for="lang_@lang.Code">
                        @lang.Flag @lang.Name (@lang.Code.ToUpper())
                    </label>
                    @if (isEnabled && mis > 0)
                    {
                        <span class="badge bg-warning text-dark ms-1" title="Missing translations">@mis @T["admin.translations.missing","Missing"]</span>
                    }
                </div>
            }
            <button type="submit" class="btn btn-bocconi btn-sm ms-auto">
                <i class="bi bi-save me-1"></i>@T["admin.lang.save","Save language settings"]
            </button>
        </form>
    </div>
</div>

@* ── Timezone ──────────────────────────────────────────────────────── *@
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold">
        <i class="bi bi-clock-history me-2 text-bocconi"></i>@T["admin.timezone.title","Fuso orario piattaforma"]
    </div>
    <div class="card-body">
        <p class="text-muted small mb-3">@T["admin.timezone.desc","Il fuso orario usato per l'orologio nella dashboard di tutti gli utenti. Se il browser dell'utente è in un fuso diverso, viene mostrata anche l'ora locale."]</p>
        <form asp-action="SaveTimezone" asp-route-area="" method="post" class="d-flex align-items-center gap-3 flex-wrap">
            @Html.AntiForgeryToken()
            <select name="timezone" class="form-select" style="max-width:320px;">
                @foreach (var group in timezones)
                {
                    <optgroup label="@group.Group">
                        @foreach (var tz in group.Zones)
                        {
                            if (currentTz == tz.Id)
                            {
                                <option value="@tz.Id" selected>@tz.Label</option>
                            }
                            else
                            {
                                <option value="@tz.Id">@tz.Label</option>
                            }
                        }
                    </optgroup>
                }
            </select>
            <button type="submit" class="btn btn-bocconi btn-sm">
                <i class="bi bi-save me-1"></i>@T["admin.timezone.save","Salva fuso orario"]
            </button>
            <span class="text-muted small">
                <i class="bi bi-info-circle me-1"></i>@T["admin.timezone.current","Attuale:"] <strong>@currentTz</strong>
            </span>
        </form>
    </div>
</div>

<div class="row g-4 mb-4">
    @* ─── Colonna moduli ─────────────────────────────────────────────── *@
    <div class="col-md-8">

        @* Modulo Materiali *@
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-bocconi-light fw-semibold">
                <i class="bi bi-collection me-2"></i>@T["admin.materials_module","Materials Module"]
            </div>
            <div class="card-body">
                <p class="mb-1">
                    @T["admin.materials_module_on_prefix","When the materials module is"]
                    <strong>@T["admin.module_active","active"]</strong>:
                </p>
                <ul class="mb-3 small">
                    <li>@T["admin.materials_feature_nav","The Materials link appears in the navigation bar"]</li>
                    <li>@T["admin.materials_feature_library","Users can browse, search and download materials"]</li>
                    <li>@T["admin.materials_feature_teacher","Teachers and admins can upload and manage materials"]</li>
                </ul>
                <div class="alert alert-info small py-2 mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    @T["admin.materials_module_info","Changes take effect immediately. Existing material data is not deleted."]
                </div>

                <form id="materialsToggleForm" method="post" asp-action="ToggleMaterials">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="materialsEnabledInput" name="materialsEnabled" value="@(materialsEnabled ? "true" : "false")" />
                </form>
            </div>
        </div>

        @* Modulo Corsi *@
        <div class="card shadow-sm">
            <div class="card-header bg-bocconi-light fw-semibold">
                <i class="bi bi-book me-2"></i>@T["admin.courses_module","Courses & Enrolments Module"]
            </div>
            <div class="card-body">
                <p class="mb-1">
                    @T["admin.courses_module_on_prefix","When the courses module is"]
                    <strong>@T["admin.module_active","active"]</strong>:
                </p>
                <ul class="mb-3 small">
                    <li>@T["admin.courses_feature_nav","The Courses link appears in the navigation bar for everyone"]</li>
                    <li>@T["admin.courses_feature_catalog","Students and teachers see the course catalogue, enrolments and course dashboard"]</li>
                    <li>@T["admin.courses_feature_teacher","Teachers can manage lessons and students per course"]</li>
                </ul>
                <div class="alert alert-info small py-2 mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    @T["admin.courses_module_info","Changes take effect immediately. Existing course data is not deleted."]
                </div>

                <form id="coursesToggleForm" method="post" asp-action="PlatformFeatures">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="coursesEnabledInput" name="coursesEnabled" value="@(coursesEnabled ? "true" : "false")" />
                </form>
            </div>
        </div>
    </div>

    @* ─── Riepilogo moduli ───────────────────────────────────────────── *@
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-light">
            <div class="card-body">
                <h6 class="fw-bold mb-3">
                    <i class="bi bi-grid-3x3-gap me-2 text-bocconi"></i>@T["admin.modules_summary","Module summary"]
                </h6>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span><i class="bi bi-collection me-2 text-bocconi"></i>@T["nav.materials","Materials"]</span>
                        <div class="form-check form-switch mb-0 d-flex align-items-center gap-2">
                            <input class="form-check-input mt-0" type="checkbox" role="switch"
                                   id="materialsToggle" style="width:2.5em;height:1.3em;cursor:pointer;"
                                   @(materialsEnabled ? "checked" : "") />
                            <span class="small fw-semibold @(materialsEnabled ? "text-success" : "text-secondary")">
                                @(materialsEnabled ? T["admin.module_active","Active"] : T["admin.module_disabled","Disabled"])
                            </span>
                        </div>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span><i class="bi bi-book me-2 text-bocconi"></i>@T["admin.courses_label","Courses"]</span>
                        <div class="form-check form-switch mb-0 d-flex align-items-center gap-2">
                            <input class="form-check-input mt-0" type="checkbox" role="switch"
                                   id="coursesToggle" style="width:2.5em;height:1.3em;cursor:pointer;"
                                   @(coursesEnabled ? "checked" : "") />
                            <span class="small fw-semibold @(coursesEnabled ? "text-success" : "text-secondary")">
                                @(coursesEnabled ? T["admin.module_active","Active"] : T["admin.module_disabled","Disabled"])
                            </span>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('materialsToggle').addEventListener('change', function () {
            document.getElementById('materialsEnabledInput').value = this.checked ? 'true' : 'false';
            document.getElementById('materialsToggleForm').submit();
        });
        document.getElementById('coursesToggle').addEventListener('change', function () {
            document.getElementById('coursesEnabledInput').value = this.checked ? 'true' : 'false';
            document.getElementById('coursesToggleForm').submit();
        });
    </script>
}

