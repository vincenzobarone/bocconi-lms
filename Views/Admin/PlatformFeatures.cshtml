@{
    ViewData["Title"] = T["admin.platform_settings","Platform Settings"];
    bool coursesEnabled = ViewBag.CoursesEnabled == true;
}

<div class="mb-4">
    <h2 class="fw-bold text-bocconi mb-0">
        <i class="bi bi-sliders me-2"></i>@T["admin.platform_settings","Platform Settings"]
    </h2>
</div>



@* ─── Modulo Corsi ──────────────────────────────────────────────── *@
<div class="row g-4 mb-4">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-bocconi-light fw-semibold">
                <i class="bi bi-book me-2"></i>@T["admin.courses_module","Courses & Enrolments Module"]
            </div>
            <div class="card-body">
                <p class="mb-1">
                    @T["admin.courses_module_on_prefix","When the courses module is"]
                    <strong>@T["admin.module_active","active"]</strong>:
                </p>
                <ul class="mb-3 small">
                    <li>@T["admin.courses_feature_nav","The Courses link appears in the navigation bar for everyone"]</li>
                    <li>@T["admin.courses_feature_catalog","Students and teachers see the course catalogue, enrolments and course dashboard"]</li>
                    <li>@T["admin.courses_feature_teacher","Teachers can manage lessons and students per course"]</li>
                </ul>
                <div class="alert alert-info small py-2 mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    @T["admin.courses_module_info","Changes take effect immediately. Existing course data is not deleted."]
                </div>

                <form id="coursesToggleForm" method="post" asp-action="PlatformFeatures">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="coursesEnabledInput" name="coursesEnabled" value="@(coursesEnabled ? "true" : "false")" />
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-light">
            <div class="card-body">
                <h6 class="fw-bold mb-3">
                    <i class="bi bi-grid-3x3-gap me-2 text-bocconi"></i>@T["admin.modules_summary","Module summary"]
                </h6>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span><i class="bi bi-collection me-2 text-bocconi"></i>@T["nav.materials","Materials"]</span>
                        <span class="badge bg-success">@T["admin.always_active","Always active"]</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span><i class="bi bi-book me-2 text-bocconi"></i>@T["admin.courses_label","Courses"]</span>
                        <div class="form-check form-switch mb-0 d-flex align-items-center gap-2">
                            <input class="form-check-input mt-0" type="checkbox" role="switch"
                                   id="coursesToggle" style="width:2.5em;height:1.3em;cursor:pointer;"
                                   @(coursesEnabled ? "checked" : "") />
                            <span class="small fw-semibold @(coursesEnabled ? "text-success" : "text-secondary")">
                                @if (coursesEnabled)
                                {
                                    @T["admin.module_active","Active"]
                                }
                                else
                                {
                                    @T["admin.module_disabled","Disabled"]
                                }
                            </span>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('coursesToggle').addEventListener('change', function () {
            document.getElementById('coursesEnabledInput').value = this.checked ? 'true' : 'false';
            document.getElementById('coursesToggleForm').submit();
        });
    </script>
}

@* ─── Email ──────────────────────────────────────────────────────── *@
<div class="row g-4">
    <div class="col-md-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center p-4">
                <i class="bi bi-envelope-at display-4 text-bocconi mb-3 d-block"></i>
                <h5 class="fw-bold">@T["admin.email_settings","Email Settings"]</h5>
                <p class="text-muted">@T["admin.email_settings_desc","Configure SMTP server and send test emails"]</p>
                <a asp-action="EmailSettings" class="btn btn-bocconi">
                    @T["admin.configure_email","Configure email"]
                </a>
            </div>
        </div>
    </div>
</div>
