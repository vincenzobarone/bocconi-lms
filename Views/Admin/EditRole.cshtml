@using BocconiLMS.Data
@model RoleFormViewModel
@{
    ViewData["Title"] = T["admin.edit_role","Edit role"];
    bool coursesEnabled = ViewBag.CoursesEnabled == true;

    var coursePerms = RolePermissionRepository.AllPermissions.Where(p => p.CoursesOnly).ToList();
    var menuPerms   = RolePermissionRepository.AllPermissions.Where(p => p.MenuOnly && p.Key != "menu.materials"
                                                                                     && !p.Key.StartsWith("materials.")).ToList();
    var matOpPerms  = RolePermissionRepository.AllPermissions.Where(p => p.Key.StartsWith("materials.")).ToList();
    bool matMenuChecked = Model.Permissions.Contains("menu.materials");
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-bocconi mb-0">
                <i class="bi bi-shield-lock me-2"></i>@T["admin.edit_role","Edit role"]
            </h2>
            <a asp-action="Users" asp-route-tab="ruoli" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>@T["admin.roles_tab","Roles"]
            </a>
        </div>

        <form asp-action="EditRole" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 mb-3">
                    @Html.ValidationSummary(false, null, new { @class = "mb-0" })
                </div>
            }

            @* ── Nome ruolo ─────────────────────────────────────── *@
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <label asp-for="Name" class="form-label fw-semibold">
                        @T["common.name","Name"] <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Name" class="form-control" maxlength="50" autocomplete="off" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
            </div>

            @* ── Permessi Corsi (solo se abilitati) ─────────────── *@
            @if (coursesEnabled)
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-white fw-semibold py-3">
                        <i class="bi bi-book me-2 text-bocconi"></i>@T["admin.courses","Courses"]
                    </div>
                    <div class="card-body">
                        @foreach (var p in coursePerms)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox"
                                       name="permissions" value="@p.Key"
                                       id="perm_@p.Key.Replace('.','_')"
                                       @(Model.Permissions.Contains(p.Key) ? "checked" : "") />
                                <label class="form-check-label" for="perm_@p.Key.Replace('.','_')">
                                    @T[p.TranslationKey, p.Key]
                                </label>
                            </div>
                        }
                    </div>
                </div>
            }

            @* ── Accesso Menu ────────────────────────────────────── *@
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold py-3">
                    <i class="bi bi-layout-text-sidebar me-2 text-bocconi"></i>@T["perm.menu_access","Accesso Menu"]
                </div>
                <div class="card-body">
                    <div class="form-text mb-3">@T["perm.menu_access_hint","Consente agli utenti con questo ruolo di accedere alle seguenti sezioni del pannello."]</div>

                    @* ── Materials toggle + sub-opzioni ───────────── *@
                    <div class="form-check mb-1">
                        <input class="form-check-input" type="checkbox"
                               name="permissions" value="menu.materials"
                               id="perm_menu_materials"
                               @(matMenuChecked ? "checked" : "")
                               onchange="toggleMatOps(this.checked)" />
                        <label class="form-check-label fw-semibold" for="perm_menu_materials">
                            <i class="bi bi-collection me-1 text-bocconi"></i>@T["perm.menu_materials","Materiali — accesso sezione"]
                        </label>
                    </div>

                    @* Sub-opzioni operazioni Materials *@
                    <div id="matOpsGroup"
                         class="ps-4 border-start border-2 border-bocconi ms-2 mb-3 @(matMenuChecked ? "" : "d-none")">
                        <div class="form-text mb-2">@T["perm.mat_ops_hint","Operazioni consentite sui materiali:"]</div>
                        @foreach (var p in matOpPerms)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input mat-op-check" type="checkbox"
                                       name="permissions" value="@p.Key"
                                       id="perm_@p.Key.Replace('.','_')"
                                       @(Model.Permissions.Contains(p.Key) ? "checked" : "")
                                       @(matMenuChecked ? "" : "disabled") />
                                <label class="form-check-label" for="perm_@p.Key.Replace('.','_')">
                                    @T[p.TranslationKey, p.Key]
                                </label>
                            </div>
                        }
                    </div>

                    @* Altri permessi menu (Utenti, Dictionary…) *@
                    @foreach (var p in menuPerms)
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox"
                                   name="permissions" value="@p.Key"
                                   id="perm_@p.Key.Replace('.','_')"
                                   @(Model.Permissions.Contains(p.Key) ? "checked" : "") />
                            <label class="form-check-label" for="perm_@p.Key.Replace('.','_')">
                                @T[p.TranslationKey, p.Key]
                            </label>
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-bocconi px-4">
                    <i class="bi bi-check2 me-1"></i>@T["common.save","Save"]
                </button>
                <a asp-action="Users" asp-route-tab="ruoli" class="btn btn-outline-secondary">
                    @T["common.cancel","Cancel"]
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function toggleMatOps(enabled) {
            var group = document.getElementById('matOpsGroup');
            var checks = group.querySelectorAll('.mat-op-check');
            if (enabled) {
                group.classList.remove('d-none');
                checks.forEach(function(c) { c.disabled = false; });
            } else {
                group.classList.add('d-none');
                checks.forEach(function(c) { c.disabled = true; c.checked = false; });
            }
        }
    </script>
}
