@using BocconiLMS.Data
@using BocconiLMS.Services
@model List<TranslationRow>
@{
    ViewData["Title"] = T["nav.dictionary"];
    var enabledLangs    = ViewBag.EnabledLanguages as List<string> ?? new List<string> { "en", "it", "es", "de" };
    var missing         = ViewBag.MissingCounts as Dictionary<string, int> ?? new();
    var allOtherLangs   = TranslationService.AllLanguages.Where(l => l.Code != "en").ToList();
    int totalMissing    = missing.Where(kv => enabledLangs.Contains(kv.Key)).Sum(kv => kv.Value);
    var docTypes        = ViewBag.DocTypes as List<BocconiLMS.Models.DocumentType> ?? new();
    var areas           = ViewBag.Areas as List<BocconiLMS.Models.Area> ?? new();
    var platforms       = ViewBag.Platforms as List<BocconiLMS.Models.Platform> ?? new();
    var activeTab       = ViewBag.ActiveTab as string ?? "translations";
}

<div class="mb-4">
    <h2 class="fw-bold text-bocconi mb-0">
        <i class="bi bi-journal-bookmark me-2"></i>@T["nav.dictionary"]
    </h2>
</div>

@* ── TABS ──────────────────────────────────────────────────── *@
<ul class="nav nav-tabs mb-4" id="dictTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "translations" ? "active" : "")"
                id="tab-translations" data-bs-toggle="tab"
                data-bs-target="#panel-translations" type="button" role="tab">
            <i class="bi bi-translate me-1"></i>@T["admin.translations.page_title"]
            @if (totalMissing > 0)
            {
                <span class="badge bg-warning text-dark ms-1">@totalMissing</span>
            }
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "doctypes" ? "active" : "")"
                id="tab-doctypes" data-bs-toggle="tab"
                data-bs-target="#panel-doctypes" type="button" role="tab">
            <i class="bi bi-tags me-1"></i>@T["admin.doc_types"]
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "aree" ? "active" : "")"
                id="tab-aree" data-bs-toggle="tab"
                data-bs-target="#panel-aree" type="button" role="tab">
            <i class="bi bi-diagram-3 me-1"></i>@T["admin.areas_tab"]
            <span class="badge bg-secondary ms-1">@areas.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "piattaforme" ? "active" : "")"
                id="tab-piattaforme" data-bs-toggle="tab"
                data-bs-target="#panel-piattaforme" type="button" role="tab">
            <i class="bi bi-send me-1"></i>@T["admin.platforms_tab"]
            <span class="badge bg-secondary ms-1">@platforms.Count</span>
        </button>
    </li>
</ul>

<div class="tab-content" id="dictTabContent">

    @* ── TAB 1: TRANSLATIONS ──────────────────────────────────────────── *@
    <div class="tab-pane fade @(activeTab == "translations" ? "show active" : "")"
         id="panel-translations" role="tabpanel">

        @* Info bar *@
        <div class="card mb-3 border-0 bg-light">
            <div class="card-body py-2">
                <div class="d-flex align-items-center gap-3 flex-wrap justify-content-between">
                    <div class="d-flex gap-3 flex-wrap text-muted small">
                        <span><i class="bi bi-info-circle me-1"></i>@T["admin.translations.base_lang"]: <strong>🇬🇧 English</strong></span>
                        <span>|</span>
                        <span>@T["admin.translations.total_keys"]: <strong>@Model.Count</strong></span>
                        @if (totalMissing > 0)
                        {
                            <span>|</span>
                            <span class="text-warning fw-semibold">
                                <i class="bi bi-exclamation-triangle me-1"></i>@totalMissing @T["admin.translations.missing_total"]
                            </span>
                        }
                    </div>
                    @if (totalMissing > 0)
                    {
                        <button id="btnFilterMissing" class="btn btn-sm btn-outline-warning">
                            <i class="bi bi-funnel me-1"></i>@T["admin.translations.filter_missing"]
                        </button>
                    }
                </div>
            </div>
        </div>

        @* Translation table *@
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0" id="translationsTable">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" style="width:20%">@T["admin.translations.col_key"]</th>
                                <th scope="col" style="width:20%">🇬🇧 English</th>
                                @if (enabledLangs.Contains("it")) { <th scope="col">🇮🇹 Italiano</th> }
                                @if (enabledLangs.Contains("es")) { <th scope="col">🇪🇸 Español</th> }
                                @if (enabledLangs.Contains("de")) { <th scope="col">🇩🇪 Deutsch</th> }
                                <th scope="col" style="width:9%">@T["admin.translations.col_created"]</th>
                                <th scope="col" style="width:5%"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model)
                            {
                                bool hasMissing = (enabledLangs.Contains("it") && string.IsNullOrEmpty(row.It))
                                               || (enabledLangs.Contains("es") && string.IsNullOrEmpty(row.Es))
                                               || (enabledLangs.Contains("de") && string.IsNullOrEmpty(row.De));
                                <tr data-missing="@(hasMissing ? "true" : "false")">
                                    <td class="font-monospace small text-muted align-middle">@row.Key</td>
                                    <td class="align-middle">@row.En</td>
                                    @if (enabledLangs.Contains("it"))
                                    {
                                        <td class="align-middle">
                                            @if (string.IsNullOrEmpty(row.It))
                                            { <span class="text-warning small"><i class="bi bi-exclamation-triangle me-1"></i>@T["admin.translations.missing"]</span> }
                                            else { @row.It }
                                        </td>
                                    }
                                    @if (enabledLangs.Contains("es"))
                                    {
                                        <td class="align-middle">
                                            @if (string.IsNullOrEmpty(row.Es))
                                            { <span class="text-warning small"><i class="bi bi-exclamation-triangle me-1"></i>@T["admin.translations.missing"]</span> }
                                            else { @row.Es }
                                        </td>
                                    }
                                    @if (enabledLangs.Contains("de"))
                                    {
                                        <td class="align-middle">
                                            @if (string.IsNullOrEmpty(row.De))
                                            { <span class="text-warning small"><i class="bi bi-exclamation-triangle me-1"></i>@T["admin.translations.missing"]</span> }
                                            else { @row.De }
                                        </td>
                                    }
                                    <td class="align-middle text-muted small text-nowrap">
                                        @row.CreatedAt.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="align-middle text-end">
                                        <div class="d-flex gap-1 justify-content-end">
                                            <a asp-action="EditTranslation" asp-route-key="@row.Key"
                                               class="btn btn-sm btn-outline-secondary" title="@T["common.edit"]">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="DeleteTranslationKey" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="key" value="@row.Key" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        title="@T["common.delete"]"
                                                        data-confirm="@T["admin.translations.confirm_delete"]">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @* ── TAB 2: DOCUMENT TYPES ───────────────────────────────────────────── *@
    <div class="tab-pane fade @(activeTab == "doctypes" ? "show active" : "")"
         id="panel-doctypes" role="tabpanel">

        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <span class="fw-semibold"><i class="bi bi-tags me-2 text-bocconi"></i>@T["admin.doc_types"]</span>
                <button type="button" class="btn btn-sm btn-bocconi"
                        data-bs-toggle="modal" data-bs-target="#createDocTypeModal">
                    <i class="bi bi-plus me-1"></i>@T["doctype.create"]
                </button>
            </div>
            <div class="card-body p-0">
                @if (!docTypes.Any())
                {
                    <p class="text-muted p-4">@T["doctype.none"]</p>
                }
                else
                {
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">@T["common.name"]</th>
                                <th scope="col" class="text-center">@T["mat.page_title"]</th>
                                <th scope="col" class="text-end">@T["common.actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dt in docTypes)
                            {
                                <tr>
                                    <td class="text-muted small">@dt.SortOrder</td>
                                    <td class="fw-semibold">@dt.Name</td>
                                    <td class="text-center">
                                        <span class="badge @(dt.MaterialCount > 0 ? "bg-primary" : "bg-light text-dark border")">
                                            @dt.MaterialCount
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex gap-1 justify-content-end">
                                            <a asp-action="EditDocumentType" asp-route-id="@dt.Id"
                                               class="btn btn-sm btn-outline-secondary"
                                               title="@T["common.edit"]">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="DeleteDocumentType" asp-route-id="@dt.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        data-confirm="@T["doctype.delete_confirm"] «@dt.Name»?"
                                                        title="@T["common.delete"]"
                                                        @(dt.MaterialCount > 0 ? "disabled" : "")>
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    @* ── TAB 3: AREE ──────────────────────────────────────────────────── *@
    <div class="tab-pane fade @(activeTab == "aree" ? "show active" : "")"
         id="panel-aree" role="tabpanel">

        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <span class="fw-semibold"><i class="bi bi-diagram-3 me-2 text-bocconi"></i>@T["admin.areas_tab"]</span>
                <button type="button" class="btn btn-sm btn-bocconi"
                        data-bs-toggle="modal" data-bs-target="#createAreaModal">
                    <i class="bi bi-plus me-1"></i>@T["admin.create_area"]
                </button>
            </div>
            <div class="card-body p-0">
                @if (!areas.Any())
                {
                    <p class="text-muted p-4">@T["admin.no_areas"]</p>
                }
                else
                {
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="ps-3">@T["common.name"]</th>
                                <th scope="col" class="text-center" style="width:130px">@T["admin.users_tab"]</th>
                                <th scope="col" style="width:110px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in areas)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">@a.Name</td>
                                    <td class="text-center">
                                        @if (a.UserCount > 0)
                                        {
                                            <span class="badge bg-bocconi">@a.UserCount</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">0</span>
                                        }
                                    </td>
                                    <td class="pe-3 text-end">
                                        <div class="d-flex gap-1 justify-content-end">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary btn-edit-area"
                                                    data-area-id="@a.Id"
                                                    data-area-name="@a.Name"
                                                    title="@T["common.edit"]">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <form asp-action="DeleteArea" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@a.Id" />
                                                <button type="submit"
                                                        class="btn btn-sm @(a.UserCount > 0 ? "btn-outline-secondary" : "btn-outline-danger")"
                                                        title="@T["admin.delete_area"]"
                                                        @(a.UserCount > 0 ? "disabled" : "")
                                                        @(a.UserCount == 0 ? $"data-confirm=\"{T["admin.delete_area_confirm"]} '{a.Name}'?\"" : "")>
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    @* ── TAB 4: PIATTAFORME ─────────────────────────────────────────── *@
    <div class="tab-pane fade @(activeTab == "piattaforme" ? "show active" : "")"
         id="panel-piattaforme" role="tabpanel">

        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <span class="fw-semibold"><i class="bi bi-send me-2 text-bocconi"></i>@T["admin.platforms_tab"]</span>
                <button type="button" class="btn btn-sm btn-bocconi"
                        data-bs-toggle="modal" data-bs-target="#createPlatformModal">
                    <i class="bi bi-plus me-1"></i>@T["admin.create_platform"]
                </button>
            </div>
            <div class="card-body p-0">
                @if (!platforms.Any())
                {
                    <p class="text-muted p-4">@T["admin.no_platforms"]</p>
                }
                else
                {
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="ps-3">@T["common.name"]</th>
                                <th scope="col" style="width:110px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pl in platforms)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">@pl.Name</td>
                                    <td class="pe-3 text-end">
                                        <div class="d-flex gap-1 justify-content-end">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary btn-edit-platform"
                                                    data-platform-id="@pl.Id"
                                                    data-platform-name="@pl.Name"
                                                    title="@T["common.edit"]">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <form asp-action="DeletePlatform" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@pl.Id" />
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="@T["admin.delete_platform"]"
                                                        data-confirm="@T["admin.delete_platform_confirm"] '@pl.Name'?">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@* ── Modale Crea Tipo Documento ───────────────────────────────────── *@
<div class="modal fade" id="createDocTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-tags me-2"></i>@T["doctype.create"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateDocumentType" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <label class="form-label fw-semibold">@T["common.name"] <span class="text-danger">*</span></label>
                    <input type="text" name="Name" id="createDocTypeName" class="form-control"
                           placeholder="@T["doctype.name_placeholder"]"
                           maxlength="255" autocomplete="off" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T["common.cancel"]</button>
                    <button type="submit" class="btn btn-bocconi">
                        <i class="bi bi-plus me-1"></i>@T["doctype.create"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Modali Aree ──────────────────────────────────────────────────── *@
<div class="modal fade" id="createAreaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-diagram-3 me-2"></i>@T["admin.create_area"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateArea" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <label class="form-label fw-semibold">@T["common.name"] <span class="text-danger">*</span></label>
                    <input type="text" name="name" id="createAreaName" class="form-control"
                           placeholder="@T["admin.area_name_placeholder"]"
                           maxlength="255" autocomplete="off" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T["common.cancel"]</button>
                    <button type="submit" class="btn btn-bocconi">
                        <i class="bi bi-plus me-1"></i>@T["admin.create_area"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editAreaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil me-2"></i>@T["admin.edit_area"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="EditArea" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editAreaId" value="" />
                <div class="modal-body">
                    <label class="form-label fw-semibold">@T["common.name"] <span class="text-danger">*</span></label>
                    <input type="text" name="name" id="editAreaName" class="form-control"
                           placeholder="@T["admin.area_name_placeholder"]"
                           maxlength="255" autocomplete="off" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T["common.cancel"]</button>
                    <button type="submit" class="btn btn-bocconi">
                        <i class="bi bi-check-lg me-1"></i>@T["common.save"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Modali Piattaforme ────────────────────────────────────────────── *@
<div class="modal fade" id="createPlatformModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-send me-2"></i>@T["admin.create_platform"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreatePlatform" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <label class="form-label fw-semibold">@T["common.name"] <span class="text-danger">*</span></label>
                    <input type="text" name="name" id="createPlatformName" class="form-control"
                           placeholder="@T["admin.platform_name_placeholder"]"
                           maxlength="255" autocomplete="off" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T["common.cancel"]</button>
                    <button type="submit" class="btn btn-bocconi">
                        <i class="bi bi-plus me-1"></i>@T["admin.create_platform"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editPlatformModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil me-2"></i>@T["admin.edit_platform"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="EditPlatform" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editPlatformId" value="" />
                <div class="modal-body">
                    <label class="form-label fw-semibold">@T["common.name"] <span class="text-danger">*</span></label>
                    <input type="text" name="name" id="editPlatformName" class="form-control"
                           placeholder="@T["admin.platform_name_placeholder"]"
                           maxlength="255" autocomplete="off" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T["common.cancel"]</button>
                    <button type="submit" class="btn btn-bocconi">
                        <i class="bi bi-check-lg me-1"></i>@T["common.save"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // ── Modale Crea Tipo Documento ────────────────────────
            var createDocTypeModal = document.getElementById('createDocTypeModal');
            if (createDocTypeModal) {
                createDocTypeModal.addEventListener('shown.bs.modal', function () {
                    document.getElementById('createDocTypeName').focus();
                });
                createDocTypeModal.addEventListener('hidden.bs.modal', function () {
                    document.getElementById('createDocTypeName').value = '';
                });
            }

            // ── Modali Aree ───────────────────────────────────────
            var createAreaModal = document.getElementById('createAreaModal');
            if (createAreaModal) {
                createAreaModal.addEventListener('shown.bs.modal', function () {
                    document.getElementById('createAreaName').focus();
                });
                createAreaModal.addEventListener('hidden.bs.modal', function () {
                    document.getElementById('createAreaName').value = '';
                });
            }
            document.addEventListener('click', function (e) {
                var btn = e.target.closest('.btn-edit-area');
                if (!btn) return;
                document.getElementById('editAreaId').value   = btn.dataset.areaId;
                document.getElementById('editAreaName').value = btn.dataset.areaName;
                bootstrap.Modal.getOrCreateInstance(document.getElementById('editAreaModal')).show();
            });
            var editAreaModal = document.getElementById('editAreaModal');
            if (editAreaModal) {
                editAreaModal.addEventListener('shown.bs.modal', function () {
                    document.getElementById('editAreaName').focus();
                    document.getElementById('editAreaName').select();
                });
            }

            // ── Modali Piattaforme ────────────────────────────────
            var createPlatformModal = document.getElementById('createPlatformModal');
            if (createPlatformModal) {
                createPlatformModal.addEventListener('shown.bs.modal', function () {
                    document.getElementById('createPlatformName').focus();
                });
                createPlatformModal.addEventListener('hidden.bs.modal', function () {
                    document.getElementById('createPlatformName').value = '';
                });
            }
            document.addEventListener('click', function (e) {
                var btn = e.target.closest('.btn-edit-platform');
                if (!btn) return;
                document.getElementById('editPlatformId').value   = btn.dataset.platformId;
                document.getElementById('editPlatformName').value = btn.dataset.platformName;
                bootstrap.Modal.getOrCreateInstance(document.getElementById('editPlatformModal')).show();
            });
            var editPlatformModal = document.getElementById('editPlatformModal');
            if (editPlatformModal) {
                editPlatformModal.addEventListener('shown.bs.modal', function () {
                    document.getElementById('editPlatformName').focus();
                    document.getElementById('editPlatformName').select();
                });
            }

            var filterMissingOnly = false;

            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                if (!filterMissingOnly) return true;
                var row = settings.aoData[dataIndex].nTr;
                return $(row).data('missing') === 'true' || $(row).attr('data-missing') === 'true';
            });

            var dt = $('#translationsTable').DataTable({
                language: window.dtLang(),
                pageLength: 25,
                columnDefs: [{ orderable: false, targets: -1 }],
                order: [[0, 'asc']]
            });

            $('#btnFilterMissing').on('click', function () {
                filterMissingOnly = !filterMissingOnly;
                if (filterMissingOnly) {
                    $(this).removeClass('btn-outline-warning').addClass('btn-warning');
                } else {
                    $(this).removeClass('btn-warning').addClass('btn-outline-warning');
                }
                dt.draw();
            });
        });
    </script>
}
