@model MigrationStatus
@{
    ViewData["Title"] = T["admin.migrations_page_title", "Database Migrations"];
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="fw-bold text-bocconi mb-0">
        <i class="bi bi-database-gear me-2"></i>@T["admin.migrations_page_title", "Database Migrations"]
    </h2>
    <a asp-controller="Home" asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>@T["common.back_dashboard", "Dashboard"]
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["TmpAdminPassword"] is string tmpPwd && !string.IsNullOrEmpty(tmpPwd))
{
    <div class="alert alert-warning border border-warning shadow-sm" role="alert">
        <div class="d-flex align-items-start gap-2">
            <i class="bi bi-key-fill fs-4 mt-1 text-warning"></i>
            <div>
                <strong>@T["admin.prod_script_ready", "Script generato — password temporanea admin"]</strong>
                <p class="mb-1 small text-muted">
                    @T["admin.prod_script_pwd_hint", "Questa password verrà mostrata una sola volta. Annotarla prima di scaricare lo script."]
                </p>
                <div class="d-flex align-items-center gap-2 mt-2">
                    <code class="fs-5 bg-light px-3 py-1 rounded border" id="tmpPwdCode">@tmpPwd</code>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            onclick="navigator.clipboard.writeText('@tmpPwd').then(()=>this.textContent='Copiata ✓')">
                        @T["common.copy", "Copia"]
                    </button>
                </div>
                <p class="mb-0 mt-2 small">
                    <strong>Email:</strong> <code>@TempData["TmpAdminEmail"]</code>
                </p>
            </div>
        </div>
        @if ((bool)(ViewData["HasPendingScript"] ?? false))
        {
            <hr class="my-2" />
            <a asp-action="DownloadProductionScript" class="btn btn-warning">
                <i class="bi bi-download me-1"></i>@T["admin.prod_script_download", "Scarica script SQL"]
            </a>
        }
    </div>
}

@* ── Status summary cards ─────────────────────────────────────────────── *@
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body py-4">
                <div class="display-5 fw-bold text-bocconi">@Model.TotalCount</div>
                <div class="text-muted small mt-1">@T["admin.migrations_total", "Total"]</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body py-4">
                <div class="display-5 fw-bold text-success">@Model.AppliedCount</div>
                <div class="text-muted small mt-1">@T["admin.migrations_applied", "Applied"]</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body py-4">
                <div class="display-5 fw-bold @(Model.PendingCount > 0 ? "text-warning" : "text-secondary")">
                    @Model.PendingCount
                </div>
                <div class="text-muted small mt-1">@T["admin.migrations_pending", "Pending"]</div>
            </div>
        </div>
    </div>
</div>

@* ── Run pending button ────────────────────────────────────────────────── *@
<div class="mb-4">
    @if (Model.PendingCount > 0)
    {
        <form method="post" asp-action="RunPendingMigrations">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-bocconi">
                <i class="bi bi-play-circle me-1"></i>@T["admin.migrations_run_btn", "Apply pending migrations"]
                <span class="badge bg-warning text-dark ms-1">@Model.PendingCount</span>
            </button>
        </form>
    }
    else
    {
        <div class="alert alert-success d-inline-flex align-items-center gap-2 mb-0">
            <i class="bi bi-check-circle-fill"></i>
            @T["admin.migrations_no_pending", "All migrations are up to date."]
        </div>
    }
</div>

@* ── Migration list ───────────────────────────────────────────────────── *@
<div class="card shadow-sm">
    <div class="card-header fw-semibold bg-light">
        <i class="bi bi-list-check me-1"></i>@T["admin.migrations_list", "Migration files"]
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:50px">#</th>
                    <th>@T["admin.migrations_list", "Migration"]</th>
                    <th style="width:120px" class="text-center">@T["admin.migrations_applied", "Applied"]</th>
                    <th style="width:200px">@T["admin.migrations_applied_at", "Applied at"]</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Rows.Count; i++)
                {
                    var row = Model.Rows[i];
                    <tr class="@(row.IsApplied ? "" : "table-warning")">
                        <td class="text-muted">@(i + 1)</td>
                        <td>
                            <code class="small">@row.Name</code>
                        </td>
                        <td class="text-center">
                            @if (row.IsApplied)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-lg"></i></span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark"><i class="bi bi-clock"></i></span>
                            }
                        </td>
                        <td class="text-muted small">
                            @(row.AppliedAt.HasValue ? row.AppliedAt.Value.ToString("dd/MM/yyyy HH:mm") : "—")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ── Script per produzione ─────────────────────────────────────────────── *@
<div class="card shadow-sm mt-4">
    <div class="card-header fw-semibold bg-light d-flex align-items-center gap-2">
        <i class="bi bi-file-earmark-code"></i>
        @T["admin.prod_script_title", "Script per produzione"]
    </div>
    <div class="card-body">
        <p class="text-muted small mb-3">
            @T["admin.prod_script_desc",
               "Genera un file SQL completo per installare Didasco su un database di produzione vuoto. " +
               "Lo script include: drift detection, CREATE TABLE per tutte le tabelle dell'applicazione, " +
               "seed del ruolo Admin e di un utente amministratore con password temporanea. " +
               "Le tabelle 'documents' e 'document_versions' (eliminate dalla migrazione 008) sono escluse."]
        </p>

        <form method="post" asp-action="GenerateProductionScript" id="frmProdScript">
            @Html.AntiForgeryToken()
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="includeTranslations"
                       value="true" id="chkTranslations" />
                <label class="form-check-label" for="chkTranslations">
                    @T["admin.prod_script_include_translations", "Includi chiavi di traduzione nello script"]
                </label>
                <div class="form-text">
                    @T["admin.prod_script_translations_hint",
                       "Se selezionato, inserisce tutte le traduzioni presenti nel DB (INSERT … ON DUPLICATE KEY UPDATE)."]
                </div>
            </div>

            <div class="d-flex align-items-center gap-3 flex-wrap">
                <button type="submit" class="btn btn-bocconi" id="btnGenerate"
                        onclick="this.disabled=true; this.innerHTML='<span class=\'spinner-border spinner-border-sm me-1\'></span>Generazione…'; this.form.submit();">
                    <i class="bi bi-gear me-1"></i>@T["admin.prod_script_generate_btn", "Genera script"]
                </button>

                @if ((bool)(ViewData["HasPendingScript"] ?? false) && TempData["TmpAdminPassword"] == null)
                {
                    <a asp-action="DownloadProductionScript" class="btn btn-outline-bocconi">
                        <i class="bi bi-download me-1"></i>@T["admin.prod_script_download", "Scarica script SQL"]
                    </a>
                    <span class="text-muted small">
                        <i class="bi bi-info-circle me-1"></i>
                        @T["admin.prod_script_already_ready", "Script già pronto dal precedente caricamento della pagina."]
                    </span>
                }
            </div>
        </form>

        <div class="mt-3 p-3 bg-light rounded border small text-muted">
            <strong><i class="bi bi-shield-exclamation me-1 text-danger"></i>@T["admin.prod_script_warning_title", "Avvertenze"]</strong>
            <ul class="mb-0 mt-1 ps-3">
                <li>@T["admin.prod_script_w1", "La password temporanea viene mostrata una sola volta al momento del download. Annotarla prima di chiudere la pagina."]</li>
                <li>@T["admin.prod_script_w2", "Lo script NON cancella dati esistenti: usa CREATE TABLE IF NOT EXISTS e INSERT IGNORE."]</li>
                <li>@T["admin.prod_script_w3", "Il blocco di drift detection interrompe lo script se trova tabelle con struttura diversa da quella attesa."]</li>
                <li>@T["admin.prod_script_w4", "Eseguire con: mysql -u&lt;user&gt; -p &lt;database&gt; &lt; didasco_production_YYYYMMDD.sql"]</li>
            </ul>
        </div>
    </div>
</div>
