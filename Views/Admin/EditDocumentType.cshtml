@model BocconiLMS.Models.DocumentTypeFormViewModel
@{
    ViewData["Title"] = "Modifica Tipo Documento";
}


<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold bg-bocconi text-white">
                <i class="bi bi-pencil me-2"></i>Modifica tipo documento
            </div>
            <div class="card-body">
                <form asp-action="EditDocumentType" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-semibold">Nome <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" maxlength="255" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Dictionary" asp-route-tab="doctypes" class="btn btn-outline-secondary">@T["common.cancel"]</a>
                        <button type="submit" class="btn btn-bocconi">Salva</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
