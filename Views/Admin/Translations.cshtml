@using BocconiLMS.Data
@model List<TranslationRow>
@{
    ViewData["Title"] = T["admin.translations.page_title", "Translation Management"];
}

<div class="mb-4">
    <h2 class="fw-bold text-bocconi mb-0">
        <i class="bi bi-translate me-2"></i>@T["admin.translations.page_title", "Translation Management"]
    </h2>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <div class="d-flex align-items-center gap-3 flex-wrap text-muted small">
            <span><i class="bi bi-info-circle me-1"></i>@T["admin.translations.base_lang", "Base"]: <strong>@T["lang.english", "English"]</strong> (EN)</span>
            <span>|</span>
            <span>@T["admin.translations.total_keys", "Total keys"]: <strong>@Model.Count</strong></span>
            <span>|</span>
            <span>@T["admin.translations.available", "Translations"]: IT · ES · DE</span>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0" id="translationsTable">
                <thead class="table-light">
                    <tr>
                        <th style="width:22%">@T["admin.translations.col_key", "Key"]</th>
                        <th style="width:24%">🇬🇧 English</th>
                        <th style="width:18%">🇮🇹 Italiano</th>
                        <th style="width:18%">🇪🇸 Español</th>
                        <th style="width:14%">🇩🇪 Deutsch</th>
                        <th style="width:4%"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        <tr>
                            <td class="font-monospace small text-muted align-middle">@row.Key</td>
                            <td class="align-middle">@row.En</td>
                            <td class="align-middle">
                                @if (string.IsNullOrEmpty(row.It))
                                {
                                    <span class="text-warning small"><i class="bi bi-exclamation-triangle me-1"></i>@T["admin.translations.missing", "Missing"]</span>
                                }
                                else { @row.It }
                            </td>
                            <td class="align-middle">
                                @if (string.IsNullOrEmpty(row.Es))
                                {
                                    <span class="text-warning small"><i class="bi bi-exclamation-triangle me-1"></i>@T["admin.translations.missing", "Missing"]</span>
                                }
                                else { @row.Es }
                            </td>
                            <td class="align-middle">
                                @if (string.IsNullOrEmpty(row.De))
                                {
                                    <span class="text-warning small"><i class="bi bi-exclamation-triangle me-1"></i>@T["admin.translations.missing", "Missing"]</span>
                                }
                                else { @row.De }
                            </td>
                            <td class="align-middle text-end">
                                <div class="d-flex gap-1 justify-content-end">
                                    <a asp-action="EditTranslation" asp-route-key="@row.Key"
                                       class="btn btn-sm btn-outline-secondary" title="@T["common.edit", "Edit"]">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="DeleteTranslationKey" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="key" value="@row.Key" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                title="@T["common.delete", "Delete"]"
                                                onclick="return confirm('@T["admin.translations.confirm_delete", "Delete this key and all its translations?"]')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function () {
            $('#translationsTable').DataTable({
                language: window.dtLang(),
                pageLength: 25,
                columnDefs: [{ orderable: false, targets: 5 }],
                order: [[0, 'asc']]
            });
        });
    </script>
}
