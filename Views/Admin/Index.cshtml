@model DashboardStats
@{
    ViewData["Title"] = "Dashboard Amministratore";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-bocconi mb-0"><i class="bi bi-gear-fill me-2"></i>Dashboard Amministratore</h2>
    <a asp-action="CreateUser" class="btn btn-bocconi">
        <i class="bi bi-person-plus me-1"></i>Nuovo utente
    </a>
</div>

<div class="row g-3 mb-5">
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card text-center p-3">
            <div class="display-5 fw-bold text-bocconi">@Model.TotalCourses</div>
            <div class="text-muted small"><i class="bi bi-book me-1"></i>Corsi totali</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card text-center p-3">
            <div class="display-5 fw-bold text-bocconi">@Model.TotalUsers</div>
            <div class="text-muted small"><i class="bi bi-people me-1"></i>Utenti totali</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card gold text-center p-3">
            <div class="display-5 fw-bold" style="color:#c8a96e;">@Model.ActiveStudents</div>
            <div class="text-muted small"><i class="bi bi-person-check me-1"></i>Studenti attivi</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card text-center p-3">
            <div class="display-5 fw-bold text-bocconi">@Model.TotalEnrollments</div>
            <div class="text-muted small"><i class="bi bi-journal-check me-1"></i>Iscrizioni</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body text-center p-4">
                <i class="bi bi-people-fill display-4 text-bocconi mb-3 d-block"></i>
                <h5 class="fw-bold">Gestione Utenti</h5>
                <p class="text-muted">Crea, modifica e gestisci gli account degli utenti</p>
                <a asp-action="Users" class="btn btn-bocconi">Gestisci utenti</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-body text-center p-4">
                <i class="bi bi-book-fill display-4 text-bocconi mb-3 d-block"></i>
                <h5 class="fw-bold">Tutti i Corsi</h5>
                <p class="text-muted">Visualizza e gestisci tutti i corsi della piattaforma</p>
                <a asp-controller="Course" asp-action="Index" class="btn btn-bocconi">Vedi corsi</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body text-center p-4">
                <i class="bi bi-envelope-gear display-4 text-bocconi mb-3 d-block"></i>
                <h5 class="fw-bold">Impostazioni Email</h5>
                <p class="text-muted">Configura il server SMTP e invia email di test</p>
                <a asp-action="EmailSettings" class="btn btn-bocconi">Configura email</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-md-4">
        <div class="card p-3">
            <div class="text-muted small mb-1">Docenti attivi</div>
            <div class="fw-bold fs-4">@Model.ActiveTeachers</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3">
            <div class="text-muted small mb-1">Tentativi quiz totali</div>
            <div class="fw-bold fs-4">@Model.TotalQuizAttempts</div>
        </div>
    </div>
</div>
