@model DashboardStats
@{
    ViewData["Title"] = T["admin.dashboard"];
}

<div class="mb-4">
    <h2 class="fw-bold text-bocconi mb-0"><i class="bi bi-gear-fill me-2"></i>@T["admin.dashboard"]</h2>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <i class="bi bi-sliders display-4 text-bocconi mb-3 d-block"></i>
                <h5 class="fw-bold">@T["admin.platform_settings","Platform Settings"]</h5>
                <p class="text-muted">@T["admin.platform_settings_desc","Platform configuration settings"]</p>
                <a asp-action="PlatformFeatures" class="btn btn-bocconi">@T["admin.configure","Configure"]</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <i class="bi bi-envelope-at display-4 text-bocconi mb-3 d-block"></i>
                <h5 class="fw-bold">@T["admin.email_settings","Email Settings"]</h5>
                <p class="text-muted">@T["admin.email_settings_desc","Configure SMTP server and send test emails"]</p>
                <a asp-action="EmailSettings" class="btn btn-bocconi">@T["admin.configure_email","Configure email"]</a>
            </div>
        </div>
    </div>
</div>
