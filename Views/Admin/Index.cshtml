@model DashboardStats
@inject BocconiLMS.Services.FeatureFlagService _adminFeat
@{
    ViewData["Title"] = T["admin.dashboard"];
    var coursesEnabled = await _adminFeat.IsCoursesEnabledAsync();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-bocconi mb-0"><i class="bi bi-gear-fill me-2"></i>@T["admin.dashboard"]</h2>
    <a asp-action="CreateUser" class="btn btn-bocconi">
        <i class="bi bi-person-plus me-1"></i>@T["admin.new_user"]
    </a>
</div>

<div class="row g-3 mb-5">
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card text-center p-3">
            <div class="display-5 fw-bold text-bocconi">@Model.TotalCourses</div>
            <div class="text-muted small"><i class="bi bi-book me-1"></i>@T["admin.total_courses"]</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card text-center p-3">
            <div class="display-5 fw-bold text-bocconi">@Model.TotalUsers</div>
            <div class="text-muted small"><i class="bi bi-people me-1"></i>@T["admin.total_users"]</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card gold text-center p-3">
            <div class="display-5 fw-bold" style="color:#c8a96e;">@Model.ActiveStudents</div>
            <div class="text-muted small"><i class="bi bi-person-check me-1"></i>@T["admin.active_students"]</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card text-center p-3">
            <div class="display-5 fw-bold text-bocconi">@Model.TotalEnrollments</div>
            <div class="text-muted small"><i class="bi bi-journal-check me-1"></i>@T["admin.enrollments"]</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <i class="bi bi-people-fill display-4 text-bocconi mb-3 d-block"></i>
                <h5 class="fw-bold">@T["admin.users_roles","Users & Roles"]</h5>
                <p class="text-muted">@T["admin.users_roles_desc","Manage user accounts, permissions and roles."]</p>
                <div class="d-flex gap-2 justify-content-center">
                    <a asp-action="Users" class="btn btn-bocconi">@T["admin.manage_users","Manage users"]</a>
                    <a asp-action="Users" asp-route-tab="ruoli" class="btn btn-outline-secondary">@T["admin.manage_roles","Manage roles"]</a>
                </div>
            </div>
        </div>
    </div>
    @if (coursesEnabled)
    {
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body text-center p-4">
                    <i class="bi bi-book-fill display-4 text-bocconi mb-3 d-block"></i>
                    <h5 class="fw-bold">@T["admin.courses"]</h5>
                    <p class="text-muted">@T["admin.courses_desc"]</p>
                    <a asp-controller="Course" asp-action="Index" class="btn btn-bocconi">@T["admin.view_courses"]</a>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-3 mt-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <i class="bi bi-tags display-4 text-bocconi mb-3 d-block"></i>
                <h5 class="fw-bold">@T["admin.doc_types","Document Types"]</h5>
                <p class="text-muted">@T["admin.doc_types_desc","Manage document types available in the Materials library."]</p>
                <a asp-action="DocumentTypes" class="btn btn-bocconi">@T["admin.manage_types","Manage types"]</a>
            </div>
        </div>
    </div>
</div>

<hr class="my-4" />
<h5 class="fw-semibold text-bocconi mb-3">
    <i class="bi bi-sliders me-2"></i>@T["admin.platform_settings","Platform Settings"]
</h5>
<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <i class="bi bi-toggles display-4 text-bocconi mb-3 d-block"></i>
                <h5 class="fw-bold">@T["admin.platform_settings","Platform Settings"]</h5>
                <p class="text-muted">@T["admin.platform_settings_desc","Platform configuration settings"]</p>
                <a asp-action="PlatformFeatures" class="btn btn-bocconi">@T["admin.configure","Configure"]</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <i class="bi bi-envelope-gear display-4 text-bocconi mb-3 d-block"></i>
                <h5 class="fw-bold">@T["admin.email_settings","Email Settings"]</h5>
                <p class="text-muted">@T["admin.email_settings_desc","Configure SMTP server and send test emails"]</p>
                <a asp-action="EmailSettings" class="btn btn-bocconi">@T["admin.configure_email","Configure email"]</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <i class="bi bi-translate display-4 text-bocconi mb-3 d-block"></i>
                <h5 class="fw-bold">@T["admin.translations","Translations"]</h5>
                <p class="text-muted">@T["admin.translations_desc","Manage interface translations for all languages"]</p>
                <a asp-action="Translations" class="btn btn-bocconi">@T["admin.manage_translations","Manage translations"]</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-md-4">
        <div class="card p-3">
            <div class="text-muted small mb-1">@T["admin.active_teachers"]</div>
            <div class="fw-bold fs-4">@Model.ActiveTeachers</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3">
            <div class="text-muted small mb-1">@T["admin.total_attempts"]</div>
            <div class="fw-bold fs-4">@Model.TotalQuizAttempts</div>
        </div>
    </div>
</div>
