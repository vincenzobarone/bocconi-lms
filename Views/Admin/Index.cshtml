@model DashboardStats
@inject BocconiLMS.Services.FeatureFlagService _adminFeat
@{
    ViewData["Title"] = T["admin.dashboard"];
    var coursesEnabled = await _adminFeat.IsCoursesEnabledAsync();
}

<div class="mb-4">
    <h2 class="fw-bold text-bocconi mb-0"><i class="bi bi-gear-fill me-2"></i>@T["admin.dashboard"]</h2>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <i class="bi bi-people-fill display-4 text-bocconi mb-3 d-block"></i>
                <h5 class="fw-bold">@T["admin.users_roles","Users & Roles"]</h5>
                <p class="text-muted">@T["admin.users_roles_desc","Manage user accounts, permissions and roles."]</p>
                <a asp-action="Users" class="btn btn-bocconi">@T["common.manage","Manage"]</a>
            </div>
        </div>
    </div>
    @if (coursesEnabled)
    {
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body text-center p-4">
                    <i class="bi bi-book-fill display-4 text-bocconi mb-3 d-block"></i>
                    <h5 class="fw-bold">@T["admin.courses"]</h5>
                    <p class="text-muted">@T["admin.courses_desc"]</p>
                    <a asp-controller="Course" asp-action="Index" class="btn btn-bocconi">@T["admin.view_courses"]</a>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-3 mt-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body text-center p-4">
                <i class="bi bi-sliders display-4 text-bocconi mb-3 d-block"></i>
                <h5 class="fw-bold">@T["admin.platform_settings","Platform Settings"]</h5>
                <p class="text-muted">@T["admin.platform_settings_desc","Platform configuration settings"]</p>
                <a asp-action="PlatformFeatures" class="btn btn-bocconi">@T["admin.configure","Configure"]</a>
            </div>
        </div>
    </div>
</div>
