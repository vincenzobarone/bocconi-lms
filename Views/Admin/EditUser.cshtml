@model User
@{
    ViewData["Title"] = T["admin.users.edit_title"] + " - " + Model.FullName;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <h2 class="fw-bold text-bocconi mb-4"><i class="bi bi-pencil me-2"></i>@T["admin.users.edit_title"]</h2>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="EditUser" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FirstName" class="form-label fw-semibold">@T["common.first_name"]</label>
                            <input asp-for="FirstName" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label fw-semibold">@T["common.last_name"]</label>
                            <input asp-for="LastName" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input value="@Model.Email" class="form-control" disabled />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Role" class="form-label fw-semibold">@T["common.role"]</label>
                        @if (Model.Role == "Admin")
                        {
                            <input type="hidden" asp-for="Role" />
                            <input class="form-control" value="@T["role.admin"]" disabled />
                            <div class="form-text text-muted">@T["admin.users.role_locked"]</div>
                        }
                        else
                        {
                            @if (string.IsNullOrEmpty(Model.Role))
                            {
                                <div class="alert alert-warning py-2 px-3 mb-2 small">
                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                    @T["admin.no_role_warning"]
                                </div>
                            }
                            <select asp-for="Role" class="form-select @(string.IsNullOrEmpty(Model.Role) ? "border-warning" : "")">
                                @if (string.IsNullOrEmpty(Model.Role))
                                {
                                    <option value="" selected>— @T["admin.select_role"] —</option>
                                }
                                @foreach (var r in (ViewBag.AvailableRoles as List<string> ?? new List<string>()))
                                {
                                    <option value="@r" selected="@(Model.Role == r ? "selected" : null)">@r</option>
                                }
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        }
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label">@T["admin.users.active_account"]</label>
                    </div>

                    @{
                        var allAreas   = ViewBag.AllAreas   as List<BocconiLMS.Models.Area> ?? new();
                        var userAreaIds = ViewBag.UserAreaIds as List<int> ?? new();
                    }
                    @if (allAreas.Any())
                    {
                        <div class="mb-4">
                            <label class="form-label fw-semibold">@T["admin.areas_tab"]</label>
                            <div class="border rounded p-3" style="max-height:220px;overflow-y:auto;">
                                @foreach (var area in allAreas)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               name="areaIds" value="@area.Id"
                                               id="area_@area.Id"
                                               @(userAreaIds.Contains(area.Id) ? "checked" : "") />
                                        <label class="form-check-label" for="area_@area.Id">@area.Name</label>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-bocconi px-4">@T["common.save"]</button>
                        <a asp-action="Users" class="btn btn-outline-secondary">@T["common.cancel"]</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
