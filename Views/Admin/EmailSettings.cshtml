@model EmailSettingsViewModel
@{
    ViewData["Title"] = T["admin.email.page_title"];
    var smtpConfigured = !string.IsNullOrWhiteSpace(Model.Host);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-bocconi mb-0"><i class="bi bi-envelope-gear me-2"></i>@T["admin.email.page_title"] (SMTP)</h2>
    <a asp-controller="Home" asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>@T["common.back_to_panel"]
    </a>
</div>

<div class="row g-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">
                <i class="bi bi-server me-2 text-bocconi"></i>@T["admin.email.smtp_config"]
            </div>
            <div class="card-body">

                @* ── Form SMTP: solo campi server, porta, credenziali ── *@
                <form id="smtpMainForm" asp-action="EmailSettings" method="post">
                    @Html.AntiForgeryToken()

                    @* Campi nascosti per le impostazioni notifica (le include nel submit bulk) *@
                    <input type="hidden" name="Enabled" value="@Model.Enabled.ToString().ToLower()" id="hiddenEnabled" />
                    <input type="hidden" name="NotifyMaterialCreated" value="@Model.NotifyMaterialCreated.ToString().ToLower()" id="hiddenNotifyCreated" />
                    <input type="hidden" name="NotifyMaterialUpdated" value="@Model.NotifyMaterialUpdated.ToString().ToLower()" id="hiddenNotifyUpdated" />
                    <input type="hidden" name="NotifyMaterialDeleted" value="@Model.NotifyMaterialDeleted.ToString().ToLower()" id="hiddenNotifyDeleted" />
                    <input type="hidden" name="CoursesNotificationsEnabled" value="@Model.CoursesNotificationsEnabled.ToString().ToLower()" id="hiddenCoursesNotify" />
                    <input type="hidden" name="NotifyStudentOnEnroll" value="@Model.NotifyStudentOnEnroll.ToString().ToLower()" id="hiddenStudentEnroll" />
                    <input type="hidden" name="NotifyStudentOnQuizCompleted" value="@Model.NotifyStudentOnQuizCompleted.ToString().ToLower()" id="hiddenStudentQuiz" />
                    <input type="hidden" name="NotifyTeacherOnQuizCompleted" value="@Model.NotifyTeacherOnQuizCompleted.ToString().ToLower()" id="hiddenTeacherQuiz" />
                    <input type="hidden" name="NotifyTeacherOnStudentEnrolled" value="@Model.NotifyTeacherOnStudentEnrolled.ToString().ToLower()" id="hiddenTeacherEnroll" />
                    @foreach (var r in Model.MaterialCreatedRoles)
                    {
                        <input type="hidden" name="MaterialCreatedRoles" value="@r" />
                    }
                    @foreach (var r in Model.MaterialUpdatedRoles)
                    {
                        <input type="hidden" name="MaterialUpdatedRoles" value="@r" />
                    }
                    @foreach (var r in Model.MaterialDeletedRoles)
                    {
                        <input type="hidden" name="MaterialDeletedRoles" value="@r" />
                    }

                    <div class="row g-3">
                        <div class="col-sm-8">
                            <label asp-for="Host" class="form-label fw-semibold">@T["admin.email.host"]</label>
                            <input asp-for="Host" class="form-control" placeholder="smtp.example.com" />
                            <span asp-validation-for="Host" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="Port" class="form-label fw-semibold">@T["admin.email.port"]</label>
                            <input asp-for="Port" class="form-control" type="number" min="1" max="65535" />
                            <span asp-validation-for="Port" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-sm-6">
                            <label asp-for="Username" class="form-label fw-semibold">@T["admin.email.username"]</label>
                            <input asp-for="Username" class="form-control" placeholder="user@example.com" autocomplete="username" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Password" class="form-label fw-semibold">@T["admin.email.password"]</label>
                            <div class="input-group">
                                <input id="smtpPassword" name="Password" class="form-control" type="password"
                                       value="@Model.Password" autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary" id="toggleSmtpPassword" tabindex="-1">
                                    <i class="bi bi-eye" id="toggleSmtpPasswordIcon"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-sm-6">
                            <label asp-for="FromEmail" class="form-label fw-semibold">@T["admin.email.from_email"]</label>
                            <input asp-for="FromEmail" class="form-control" placeholder="noreply@bocconilms.it" />
                            <span asp-validation-for="FromEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="FromName" class="form-label fw-semibold">@T["admin.email.from_name"]</label>
                            <input asp-for="FromName" class="form-control" placeholder="Bocconi LMS" />
                            <span asp-validation-for="FromName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-3 form-check form-switch">
                        <input asp-for="UseSsl" class="form-check-input" type="checkbox" role="switch" id="useSsl" />
                        <label class="form-check-label fw-semibold" for="useSsl">@T["admin.email.use_ssl"]</label>
                        <div class="form-text">@T["admin.email.use_ssl_desc"]</div>
                    </div>
                </form>

                @* ── Riga azioni: Save + Test Email (dopo i campi SMTP) ── *@
                <div class="d-flex gap-3 align-items-center mt-4 pt-3 border-top flex-wrap">
                    <button type="submit" form="smtpMainForm" class="btn btn-bocconi">
                        <i class="bi bi-save me-1"></i>@T["admin.email.save_btn"]
                    </button>

                    @if (smtpConfigured)
                    {
                        <div class="vr d-none d-sm-block"></div>
                        <form asp-action="SendTestEmail" method="post" class="d-flex gap-2 align-items-center flex-wrap">
                            @Html.AntiForgeryToken()
                            <input asp-for="TestEmailRecipient" class="form-control form-control-sm"
                                   placeholder="admin@example.com" type="email" style="min-width:220px;" />
                            <button type="submit" class="btn btn-sm btn-outline-bocconi text-nowrap">
                                <i class="bi bi-envelope-arrow-up me-1"></i>@T["admin.email.test_btn"]
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted small">
                            <i class="bi bi-info-circle me-1"></i>@T["admin.email.test_not_configured"]
                        </span>
                    }
                </div>

                @* ── Enable + Notifiche (auto-save AJAX, fuori dal form SMTP) ── *@
                <hr class="mt-4 mb-3" />
                <div class="form-check form-switch">
                    <input type="checkbox" class="form-check-input" role="switch" id="smtpEnabled"
                           @(Model.Enabled ? "checked" : "") />
                    <label class="form-check-label fw-semibold" for="smtpEnabled">@T["admin.email.enable"]</label>
                    <div class="form-text">@T["admin.email.enable_desc"]</div>
                </div>

                @if (smtpConfigured)
                {
                    <div id="notifySection" class="@(Model.Enabled ? "" : "d-none")">
                        <hr class="my-3" />
                        <p class="fw-semibold text-bocconi mb-3">
                            <i class="bi bi-file-earmark-text me-1"></i>@T["admin.email.notify_materials_header"]
                        </p>

                        @* ── Notifica Creazione ── *@
                        <div class="mb-2 form-check form-switch">
                            <input type="checkbox" class="form-check-input" role="switch" id="notifyMatCreated"
                                   @(Model.NotifyMaterialCreated ? "checked" : "") />
                            <label class="form-check-label fw-semibold" for="notifyMatCreated">
                                <i class="bi bi-bell me-1 text-success"></i>@T["admin.email.notify_mat_created"]
                            </label>
                            <div class="form-text">@T["admin.email.notify_mat_created_desc"]</div>
                        </div>
                        <div id="notifyCreatedRoles" class="@(Model.NotifyMaterialCreated ? "" : "d-none") ps-3 mb-3">
                            <div class="border rounded p-3 bg-light">
                                @if (!Model.AvailableRoles.Any())
                                {
                                    <span class="text-muted small">@T["admin.no_roles"]</span>
                                }
                                else
                                {
                                    <div class="row g-2">
                                        @foreach (var role in Model.AvailableRoles)
                                        {
                                            <div class="col-6 col-md-3">
                                                <div class="form-check">
                                                    <input class="form-check-input mat-created-role-check"
                                                           type="checkbox" value="@role" id="cr_@role"
                                                           @(Model.MaterialCreatedRoles.Contains(role) ? "checked" : "") />
                                                    <label class="form-check-label" for="cr_@role">@role</label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        @* ── Notifica Modifica ── *@
                        <div class="mb-2 form-check form-switch">
                            <input type="checkbox" class="form-check-input" role="switch" id="notifyMatUpdated"
                                   @(Model.NotifyMaterialUpdated ? "checked" : "") />
                            <label class="form-check-label fw-semibold" for="notifyMatUpdated">
                                <i class="bi bi-bell me-1 text-warning"></i>@T["admin.email.notify_mat_updated"]
                            </label>
                            <div class="form-text">@T["admin.email.notify_mat_updated_desc"]</div>
                        </div>
                        <div id="notifyUpdatedRoles" class="@(Model.NotifyMaterialUpdated ? "" : "d-none") ps-3 mb-3">
                            <div class="border rounded p-3 bg-light">
                                @if (!Model.AvailableRoles.Any())
                                {
                                    <span class="text-muted small">@T["admin.no_roles"]</span>
                                }
                                else
                                {
                                    <div class="row g-2">
                                        @foreach (var role in Model.AvailableRoles)
                                        {
                                            <div class="col-6 col-md-3">
                                                <div class="form-check">
                                                    <input class="form-check-input mat-updated-role-check"
                                                           type="checkbox" value="@role" id="up_@role"
                                                           @(Model.MaterialUpdatedRoles.Contains(role) ? "checked" : "") />
                                                    <label class="form-check-label" for="up_@role">@role</label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        @* ── Notifica Eliminazione ── *@
                        <div class="mb-2 form-check form-switch">
                            <input type="checkbox" class="form-check-input" role="switch" id="notifyMatDeleted"
                                   @(Model.NotifyMaterialDeleted ? "checked" : "") />
                            <label class="form-check-label fw-semibold" for="notifyMatDeleted">
                                <i class="bi bi-bell me-1 text-danger"></i>@T["admin.email.notify_mat_deleted"]
                            </label>
                            <div class="form-text">@T["admin.email.notify_mat_deleted_desc"]</div>
                        </div>
                        <div id="notifyDeletedRoles" class="@(Model.NotifyMaterialDeleted ? "" : "d-none") ps-3 mb-3">
                            <div class="border rounded p-3 bg-light">
                                @if (!Model.AvailableRoles.Any())
                                {
                                    <span class="text-muted small">@T["admin.no_roles"]</span>
                                }
                                else
                                {
                                    <div class="row g-2">
                                        @foreach (var role in Model.AvailableRoles)
                                        {
                                            <div class="col-6 col-md-3">
                                                <div class="form-check">
                                                    <input class="form-check-input mat-deleted-role-check"
                                                           type="checkbox" value="@role" id="del_@role"
                                                           @(Model.MaterialDeletedRoles.Contains(role) ? "checked" : "") />
                                                    <label class="form-check-label" for="del_@role">@role</label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        @* ── Notifiche corsi ── *@
                        @if (Model.CourseModuleEnabled)
                        {
                            <hr class="my-3" />
                            <div class="mb-2 form-check form-switch">
                                <input type="checkbox" class="form-check-input" role="switch" id="notifyCourses"
                                       @(Model.CoursesNotificationsEnabled ? "checked" : "") />
                                <label class="form-check-label fw-semibold" for="notifyCourses">
                                    <i class="bi bi-bell me-1 text-bocconi"></i>@T["admin.email.notify_courses"]
                                </label>
                                <div class="form-text">@T["admin.email.notify_courses_desc"]</div>
                            </div>
                            <div id="courseNotifyItems" class="@(Model.CoursesNotificationsEnabled ? "" : "d-none") ps-3 border-start border-2 ms-1">
                                <div class="form-check mt-2">
                                    <input type="checkbox" class="form-check-input course-notify-check" id="notifyStudentEnroll"
                                           data-item="StudentOnEnroll" @(Model.NotifyStudentOnEnroll ? "checked" : "") />
                                    <label class="form-check-label" for="notifyStudentEnroll">
                                        @T["admin.email.notify_student_enroll"]
                                    </label>
                                </div>
                                <div class="form-check mt-2">
                                    <input type="checkbox" class="form-check-input course-notify-check" id="notifyStudentQuiz"
                                           data-item="StudentOnQuizCompleted" @(Model.NotifyStudentOnQuizCompleted ? "checked" : "") />
                                    <label class="form-check-label" for="notifyStudentQuiz">
                                        @T["admin.email.notify_student_quiz"]
                                    </label>
                                </div>
                                <div class="form-check mt-2">
                                    <input type="checkbox" class="form-check-input course-notify-check" id="notifyTeacherQuiz"
                                           data-item="TeacherOnQuizCompleted" @(Model.NotifyTeacherOnQuizCompleted ? "checked" : "") />
                                    <label class="form-check-label" for="notifyTeacherQuiz">
                                        @T["admin.email.notify_teacher_quiz"]
                                    </label>
                                </div>
                                <div class="form-check mt-2">
                                    <input type="checkbox" class="form-check-input course-notify-check" id="notifyTeacherEnroll"
                                           data-item="TeacherOnStudentEnrolled" @(Model.NotifyTeacherOnStudentEnrolled ? "checked" : "") />
                                    <label class="form-check-label" for="notifyTeacherEnroll">
                                        @T["admin.email.notify_teacher_enroll"]
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ── Toggle visibilità password ─────────────────────────────────────
        document.getElementById('toggleSmtpPassword').addEventListener('click', function () {
            var input = document.getElementById('smtpPassword');
            var icon  = document.getElementById('toggleSmtpPasswordIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        });

        // ── Helper AJAX ────────────────────────────────────────────────────
        var aftToken = document.querySelector('input[name="__RequestVerificationToken"]');
        function getAft() { return aftToken ? aftToken.value : ''; }

        function showSaved(near) {
            var el = document.createElement('span');
            el.className = 'text-success small ms-2 auto-saved-hint';
            el.innerHTML = '<i class="bi bi-check2"></i> @T["admin.email.saved"]';
            near.parentElement.appendChild(el);
            setTimeout(function () { el.remove(); }, 2000);
        }

        function ajaxPost(url, body, onOk) {
            fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAft()
                },
                body: JSON.stringify(body)
            })
            .then(function(r) { return r.json(); })
            .then(function(d) { if (d.ok && onOk) onOk(); })
            .catch(function() {});
        }

        // ── Toggle "Enable email sending" ─────────────────────────────────
        var smtpEnabledCheck = document.getElementById('smtpEnabled');
        var notifySection    = document.getElementById('notifySection');
        if (smtpEnabledCheck) {
            smtpEnabledCheck.addEventListener('change', function () {
                var enabled = this.checked;
                document.getElementById('hiddenEnabled').value = enabled;
                if (notifySection) notifySection.classList.toggle('d-none', !enabled);
                var lbl = this;
                ajaxPost('/Admin/ToggleEmailSendingAjax', { value: enabled },
                    function () { showSaved(lbl); });
            });
        }

        // ── Helper: toggle notifica materiale ─────────────────────────────
        function bindMatToggle(checkId, sectionId, hiddenId, ajaxUrl, roleClass) {
            var chk = document.getElementById(checkId);
            if (!chk) return;
            chk.addEventListener('change', function () {
                var enabled = this.checked;
                document.getElementById(hiddenId).value = enabled;
                var section = document.getElementById(sectionId);
                section.classList.toggle('d-none', !enabled);
                if (!enabled) {
                    section.querySelectorAll('.' + roleClass).forEach(function (cb) { cb.checked = false; });
                }
                var lbl = this;
                ajaxPost(ajaxUrl, { value: enabled }, function () { showSaved(lbl); });
            });
        }

        // ── Helper: save ruoli materiale ──────────────────────────────────
        function bindMatRoles(roleClass, ajaxUrl) {
            document.querySelectorAll('.' + roleClass).forEach(function (cb) {
                cb.addEventListener('change', function () {
                    var roles = Array.from(document.querySelectorAll('.' + roleClass + ':checked'))
                                     .map(function (c) { return c.value; });
                    ajaxPost(ajaxUrl, { roles: roles });
                });
            });
        }

        bindMatToggle('notifyMatCreated', 'notifyCreatedRoles', 'hiddenNotifyCreated', '/Admin/ToggleNotifyMatCreatedAjax', 'mat-created-role-check');
        bindMatToggle('notifyMatUpdated', 'notifyUpdatedRoles', 'hiddenNotifyUpdated', '/Admin/ToggleNotifyMatUpdatedAjax', 'mat-updated-role-check');
        bindMatToggle('notifyMatDeleted', 'notifyDeletedRoles', 'hiddenNotifyDeleted', '/Admin/ToggleNotifyMatDeletedAjax', 'mat-deleted-role-check');
        bindMatRoles('mat-created-role-check', '/Admin/SaveMatCreatedRolesAjax');
        bindMatRoles('mat-updated-role-check', '/Admin/SaveMatUpdatedRolesAjax');
        bindMatRoles('mat-deleted-role-check', '/Admin/SaveMatDeletedRolesAjax');

        // ── Notifiche corsi ───────────────────────────────────────────────
        var notifyCoursesChk = document.getElementById('notifyCourses');
        var courseItems      = document.getElementById('courseNotifyItems');
        if (notifyCoursesChk && courseItems) {
            notifyCoursesChk.addEventListener('change', function () {
                courseItems.classList.toggle('d-none', !this.checked);
                document.getElementById('hiddenCoursesNotify').value = this.checked;
                var lbl = this;
                ajaxPost('/Admin/ToggleCourseNotificationsAjax', { value: this.checked },
                    function () { showSaved(lbl); });
            });
        }

        document.querySelectorAll('.course-notify-check').forEach(function (cb) {
            cb.addEventListener('change', function () {
                var item = this.dataset.item;
                var val  = this.checked;
                var lbl  = this;
                var hiddenMap = {
                    'StudentOnEnroll':       'hiddenStudentEnroll',
                    'StudentOnQuizCompleted':'hiddenStudentQuiz',
                    'TeacherOnQuizCompleted':'hiddenTeacherQuiz',
                    'TeacherOnStudentEnrolled':'hiddenTeacherEnroll'
                };
                if (hiddenMap[item]) document.getElementById(hiddenMap[item]).value = val;
                ajaxPost('/Admin/ToggleCourseNotifyItemAjax', { item: item, value: val },
                    function () { showSaved(lbl); });
            });
        });
    </script>
}
