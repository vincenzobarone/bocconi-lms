@model EmailSettingsViewModel
@{
    ViewData["Title"] = T["admin.email.page_title", "Email Settings"];
    var smtpConfigured = !string.IsNullOrWhiteSpace(Model.Host);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-bocconi mb-0"><i class="bi bi-envelope-gear me-2"></i>@T["admin.email.page_title", "Email Settings"] (SMTP)</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>@T["common.back_to_panel","Back to panel"]
    </a>
</div>

<div class="row g-4">
    @* ── Colonna sinistra: config SMTP ── *@
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">
                <i class="bi bi-server me-2 text-bocconi"></i>@T["admin.email.smtp_config", "SMTP Configuration"]
            </div>
            <div class="card-body">
                <form asp-action="EmailSettings" method="post">
                    @Html.AntiForgeryToken()

                    @* Campi SMTP *@
                    <div class="row g-3">
                        <div class="col-8">
                            <label asp-for="Host" class="form-label fw-semibold">@T["admin.email.host", "SMTP Host"]</label>
                            <input asp-for="Host" class="form-control" placeholder="smtp.example.com" />
                            <span asp-validation-for="Host" class="text-danger small"></span>
                        </div>
                        <div class="col-4">
                            <label asp-for="Port" class="form-label fw-semibold">@T["admin.email.port", "Port"]</label>
                            <input asp-for="Port" class="form-control" type="number" min="1" max="65535" />
                            <span asp-validation-for="Port" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-6">
                            <label asp-for="Username" class="form-label fw-semibold">@T["admin.email.username", "Username"]</label>
                            <input asp-for="Username" class="form-control" placeholder="user@example.com" autocomplete="username" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Password" class="form-label fw-semibold">@T["admin.email.password", "Password"]</label>
                            <div class="input-group">
                                <input id="smtpPassword" name="Password" class="form-control" type="password"
                                       value="@Model.Password"
                                       autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary" id="toggleSmtpPassword" tabindex="-1" title="Mostra/nascondi password">
                                    <i class="bi bi-eye" id="toggleSmtpPasswordIcon"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-6">
                            <label asp-for="FromEmail" class="form-label fw-semibold">@T["admin.email.from_email", "Sender Email"]</label>
                            <input asp-for="FromEmail" class="form-control" placeholder="noreply@bocconilms.it" />
                            <span asp-validation-for="FromEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="FromName" class="form-label fw-semibold">@T["admin.email.from_name", "Sender Name"]</label>
                            <input asp-for="FromName" class="form-control" placeholder="Bocconi LMS" />
                            <span asp-validation-for="FromName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-3 form-check form-switch">
                        <input asp-for="UseSsl" class="form-check-input" type="checkbox" role="switch" id="useSsl" />
                        <label class="form-check-label fw-semibold" for="useSsl">@T["admin.email.use_ssl", "Use SSL (port 465)"]</label>
                        <div class="form-text">@T["admin.email.use_ssl_desc", "Disable to use STARTTLS (port 587)."]</div>
                    </div>

                    @* Pulsante salva *@
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-bocconi">
                            <i class="bi bi-save me-1"></i>@T["admin.email.save_btn", "Save Settings"]
                        </button>
                    </div>

                    @* Toggle abilitazione *@
                    <hr class="mt-4 mb-3" />
                    <div class="form-check form-switch">
                        <input asp-for="Enabled" class="form-check-input" type="checkbox" role="switch" id="smtpEnabled" />
                        <label class="form-check-label fw-semibold" for="smtpEnabled">@T["admin.email.enable", "Enable email sending"]</label>
                        <div class="form-text">@T["admin.email.enable_desc", "If disabled, emails are logged but not sent."]</div>
                    </div>

                    @* Notifiche materiali — visibile solo se invio email attivo *@
                    @if (smtpConfigured)
                    {
                        <div id="notifySection" class="@(Model.Enabled ? "" : "d-none")">
                            <hr class="my-3" />
                            <div class="mb-2 form-check form-switch">
                                <input asp-for="NotifyMaterialChanged" class="form-check-input" type="checkbox"
                                       role="switch" id="notifyMaterial" />
                                <label class="form-check-label fw-semibold" for="notifyMaterial">
                                    <i class="bi bi-bell me-1 text-bocconi"></i>@T["admin.email.notify_material","Notifica creazione/modifica materiali"]
                                </label>
                                <div class="form-text">@T["admin.email.notify_material_desc","Invia un'email ai ruoli selezionati quando un materiale viene creato o modificato."]</div>
                            </div>

                            <div id="notifyRolesSection" class="@(Model.NotifyMaterialChanged ? "" : "d-none")">
                                <label class="form-label fw-semibold mt-2">
                                    @T["admin.email.notify_roles","Ruoli da notificare"]
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="border rounded p-3 bg-light">
                                    @if (Model.AvailableRoles.Count == 0)
                                    {
                                        <span class="text-muted small">@T["admin.no_roles","Nessun ruolo disponibile."]</span>
                                    }
                                    else
                                    {
                                        <div class="row g-2">
                                            @foreach (var role in Model.AvailableRoles)
                                            {
                                                var isChecked = Model.MaterialChangedRoles.Contains(role);
                                                <div class="col-6 col-md-4">
                                                    <div class="form-check">
                                                        <input class="form-check-input notify-role-check"
                                                               type="checkbox"
                                                               name="MaterialChangedRoles"
                                                               value="@role"
                                                               id="role_@role"
                                                               @(isChecked ? "checked" : "") />
                                                        <label class="form-check-label" for="role_@role">@role</label>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>

    @* ── Colonna destra: test email + note ── *@
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">
                <i class="bi bi-send-check me-2 text-bocconi"></i>@T["admin.email.test_title", "Send Test Email"]
            </div>
            <div class="card-body">
                @if (smtpConfigured)
                {
                    <p class="text-muted small mb-3">
                        @T["admin.email.test_desc", "Verify that the SMTP configuration works by sending a test email."]
                        @T["admin.email.test_desc2", "The currently saved settings are used."]
                    </p>
                    <div class="alert alert-light border small mb-3 py-2">
                        <i class="bi bi-server me-1 text-bocconi"></i>
                        <strong>@Model.Host</strong> : @Model.Port &mdash; @Model.FromEmail
                    </div>
                    <form asp-action="SendTestEmail" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label asp-for="TestEmailRecipient" class="form-label fw-semibold">@T["admin.email.test_recipient", "Test Recipient Email"]</label>
                            <input asp-for="TestEmailRecipient" class="form-control" placeholder="admin@example.com" type="email" />
                            <span asp-validation-for="TestEmailRecipient" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-outline-bocconi w-100">
                            <i class="bi bi-envelope-arrow-up me-1"></i>@T["admin.email.test_btn", "Send Test Email"]
                        </button>
                    </form>
                }
                else
                {
                    <div class="text-center py-3 text-muted">
                        <i class="bi bi-envelope-x display-6 d-block mb-2 opacity-50"></i>
                        <p class="small mb-0">@T["admin.email.test_not_configured", "Save the SMTP configuration first to enable the test."]</p>
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm mt-3">
            <div class="card-header bg-white fw-semibold">
                <i class="bi bi-info-circle me-2 text-bocconi"></i>@T["admin.email.notes_title", "Configuration Notes"]
            </div>
            <div class="card-body small text-muted">
                <ul class="mb-0 ps-3">
                    <li class="mb-1"><strong>Gmail:</strong> host <code>smtp.gmail.com</code>, port <code>587</code>, STARTTLS</li>
                    <li class="mb-1"><strong>Outlook:</strong> host <code>smtp.office365.com</code>, port <code>587</code>, STARTTLS</li>
                    <li class="mb-1"><strong>SendGrid:</strong> host <code>smtp.sendgrid.net</code>, port <code>587</code></li>
                    <li>@T["admin.email.notes_override", "Settings saved in the database override those in appsettings.json."]</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ── Toggle visibilità password ─────────────────────────────────────
        document.getElementById('toggleSmtpPassword').addEventListener('click', function () {
            var input = document.getElementById('smtpPassword');
            var icon  = document.getElementById('toggleSmtpPasswordIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        });

        // ── Helper AJAX auto-save ─────────────────────────────────────────
        var aftToken = document.querySelector('input[name="__RequestVerificationToken"]');
        function getAft() { return aftToken ? aftToken.value : ''; }

        function showSaved(near) {
            var el = document.createElement('span');
            el.className = 'text-success small ms-2 auto-saved-hint';
            el.innerHTML = '<i class="bi bi-check2"></i> Salvato';
            near.parentElement.appendChild(el);
            setTimeout(function () { el.remove(); }, 2000);
        }

        function ajaxPost(url, body, onOk) {
            fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAft()
                },
                body: JSON.stringify(body)
            })
            .then(function(r) { return r.json(); })
            .then(function(d) { if (d.ok && onOk) onOk(); })
            .catch(function() {});
        }

        // ── Toggle "Enable email sending" — auto-save + show/hide notifiche ─
        var smtpEnabledCheck = document.getElementById('smtpEnabled');
        var notifySection    = document.getElementById('notifySection');
        if (smtpEnabledCheck && notifySection) {
            smtpEnabledCheck.addEventListener('change', function () {
                var enabled = this.checked;
                if (enabled) {
                    notifySection.classList.remove('d-none');
                } else {
                    notifySection.classList.add('d-none');
                }
                var lbl = this;
                ajaxPost('/Admin/ToggleEmailSendingAjax', { value: enabled },
                    function () { showSaved(lbl); });
            });
        }

        // ── Toggle "Notifica materiali" — auto-save + show/hide ruoli ────────
        var notifyCheck = document.getElementById('notifyMaterial');
        if (notifyCheck) {
            notifyCheck.addEventListener('change', function () {
                var enabled = this.checked;
                var section = document.getElementById('notifyRolesSection');
                if (enabled) {
                    section.classList.remove('d-none');
                } else {
                    section.classList.add('d-none');
                    section.querySelectorAll('.notify-role-check').forEach(function (cb) {
                        cb.checked = false;
                    });
                }
                var lbl = this;
                ajaxPost('/Admin/ToggleNotifyMaterialAjax', { value: enabled },
                    function () { showSaved(lbl); });
            });
        }

        // ── Checkbox ruoli — auto-save al click ───────────────────────────
        document.querySelectorAll('.notify-role-check').forEach(function (cb) {
            cb.addEventListener('change', function () {
                var checked = [];
                document.querySelectorAll('.notify-role-check:checked').forEach(function (c) {
                    checked.push(c.value);
                });
                var lbl = this;
                ajaxPost('/Admin/SetNotifyRolesAjax', { roles: checked },
                    function () { showSaved(lbl); });
            });
        });
    </script>
}
