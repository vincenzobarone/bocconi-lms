@model EmailSettingsViewModel
@{
    ViewData["Title"] = "Impostazioni Email";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-bocconi mb-0"><i class="bi bi-envelope-gear me-2"></i>Impostazioni Email (SMTP)</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Dashboard
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">
                <i class="bi bi-server me-2 text-bocconi"></i>Configurazione SMTP
            </div>
            <div class="card-body">
                <form asp-action="EmailSettings" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3 form-check form-switch">
                        <input asp-for="Enabled" class="form-check-input" type="checkbox" role="switch" id="smtpEnabled" />
                        <label class="form-check-label fw-semibold" for="smtpEnabled">Abilita invio email</label>
                        <div class="form-text">Se disabilitato, le email vengono registrate nel log ma non inviate.</div>
                    </div>

                    <div class="row g-3">
                        <div class="col-8">
                            <label asp-for="Host" class="form-label fw-semibold"></label>
                            <input asp-for="Host" class="form-control" placeholder="smtp.example.com" />
                            <span asp-validation-for="Host" class="text-danger small"></span>
                        </div>
                        <div class="col-4">
                            <label asp-for="Port" class="form-label fw-semibold"></label>
                            <input asp-for="Port" class="form-control" type="number" min="1" max="65535" />
                            <span asp-validation-for="Port" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-6">
                            <label asp-for="Username" class="form-label fw-semibold"></label>
                            <input asp-for="Username" class="form-control" placeholder="user@example.com" autocomplete="username" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" autocomplete="new-password" />
                            <div class="form-text"><i class="bi bi-lock me-1"></i>Lascia vuoto per mantenere la password esistente.</div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-6">
                            <label asp-for="FromEmail" class="form-label fw-semibold"></label>
                            <input asp-for="FromEmail" class="form-control" placeholder="noreply@bocconilms.it" />
                            <span asp-validation-for="FromEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="FromName" class="form-label fw-semibold"></label>
                            <input asp-for="FromName" class="form-control" placeholder="Bocconi LMS" />
                            <span asp-validation-for="FromName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-3 form-check form-switch">
                        <input asp-for="UseSsl" class="form-check-input" type="checkbox" role="switch" id="useSsl" />
                        <label class="form-check-label fw-semibold" for="useSsl">Usa SSL (porta 465)</label>
                        <div class="form-text">Disabilita per usare STARTTLS (porta 587).</div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-bocconi">
                            <i class="bi bi-save me-1"></i>Salva impostazioni
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">
                <i class="bi bi-send-check me-2 text-bocconi"></i>Invia email di test
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Verifica che la configurazione SMTP funzioni inviando un'email di prova. Vengono usate le impostazioni <strong>attualmente salvate</strong>.
                </p>
                <form asp-action="SendTestEmail" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="TestEmailRecipient" class="form-label fw-semibold"></label>
                        <input asp-for="TestEmailRecipient" class="form-control" placeholder="admin@example.com" type="email" />
                        <span asp-validation-for="TestEmailRecipient" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-outline-bocconi w-100">
                        <i class="bi bi-envelope-arrow-up me-1"></i>Invia email di test
                    </button>
                </form>
            </div>
        </div>

        <div class="card shadow-sm mt-3">
            <div class="card-header bg-white fw-semibold">
                <i class="bi bi-info-circle me-2 text-bocconi"></i>Note di configurazione
            </div>
            <div class="card-body small text-muted">
                <ul class="mb-0 ps-3">
                    <li class="mb-1"><strong>Gmail:</strong> host <code>smtp.gmail.com</code>, porta <code>587</code>, STARTTLS</li>
                    <li class="mb-1"><strong>Outlook:</strong> host <code>smtp.office365.com</code>, porta <code>587</code>, STARTTLS</li>
                    <li class="mb-1"><strong>SendGrid:</strong> host <code>smtp.sendgrid.net</code>, porta <code>587</code></li>
                    <li>Le impostazioni vengono salvate nel database e sovrascrivono quelle dell'<code>appsettings.json</code>.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
