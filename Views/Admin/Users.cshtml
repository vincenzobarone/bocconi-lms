@model List<User>
@{
    ViewData["Title"] = "Gestione Utenti";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-bocconi mb-0"><i class="bi bi-people me-2"></i>Gestione Utenti</h2>
    <a asp-action="CreateUser" class="btn btn-bocconi">
        <i class="bi bi-person-plus me-1"></i>Nuovo utente
    </a>
</div>

<div class="card">
    <div class="card-body">
        <table id="usersTable" class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Nome</th>
                    <th>Email</th>
                    <th>Ruolo</th>
                    <th>Stato</th>
                    <th>Registrato</th>
                    <th>Azioni</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td><strong>@u.FullName</strong></td>
                        <td>@u.Email</td>
                        <td>
                            @{
                                var roleClass = u.Role switch {
                                    "Admin" => "bg-danger",
                                    "Teacher" => "bg-primary",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @roleClass">@u.Role</span>
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success">Attivo</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Disattivato</span>
                            }
                        </td>
                        <td class="text-muted small">@u.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="EditUser" asp-route-id="@u.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button"
                                        class="btn btn-sm @(u.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                        data-bs-toggle="modal" data-bs-target="#toggleModal"
                                        data-user-id="@u.Id"
                                        data-user-name="@u.FullName"
                                        data-action="@(u.IsActive ? "Disattivare" : "Attivare")">
                                    <i class="bi @(u.IsActive ? "bi-person-dash" : "bi-person-check")"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="toggleModal" tabindex="-1" aria-labelledby="toggleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="toggleModalLabel">Conferma operazione</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="toggleModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annulla</button>
                <form id="toggleForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-bocconi">Conferma</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#usersTable').DataTable({ language: window.dtIT });

            $('#toggleModal').on('show.bs.modal', function (e) {
                var btn = $(e.relatedTarget);
                var userId = btn.data('user-id');
                var userName = btn.data('user-name');
                var action = btn.data('action');
                $('#toggleModalBody').text(action + ' l\'utente "' + userName + '"?');
                $('#toggleForm').attr('action', '/Admin/ToggleUser/' + userId);
            });
        });
    </script>
}
