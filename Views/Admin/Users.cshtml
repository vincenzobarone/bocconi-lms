@model List<User>
@{
    ViewData["Title"] = T["admin.users.page_title", "User Management"];
    var currentUserId = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-bocconi mb-0"><i class="bi bi-people me-2"></i>@T["admin.users.page_title", "User Management"]</h2>
    <a asp-action="CreateUser" class="btn btn-bocconi">
        <i class="bi bi-person-plus me-1"></i>@T["admin.users.new_btn", "New User"]
    </a>
</div>

<div class="card">
    <div class="card-body">
        <table id="usersTable" class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>@T["common.name", "Name"]</th>
                    <th>Email</th>
                    <th>@T["common.role", "Role"]</th>
                    <th>@T["common.status", "Status"]</th>
                    <th>@T["common.registered", "Registered"]</th>
                    <th>@T["common.actions", "Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td><strong>@u.FullName</strong></td>
                        <td>@u.Email</td>
                        <td>
                            @{
                                var roleClass = u.Role switch {
                                    "Admin" => "bg-danger",
                                    "Teacher" => "bg-primary",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @roleClass">@u.Role</span>
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success">@T["common.active", "Active"]</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@T["common.inactive", "Inactive"]</span>
                            }
                        </td>
                        <td class="text-muted small">@u.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="EditUser" asp-route-id="@u.Id"
                                   class="btn btn-sm btn-outline-secondary" title="@T["common.edit","Edit"]">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                @if (u.Role != "Admin")
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-info btn-view-courses"
                                            data-user-id="@u.Id"
                                            data-user-name="@u.FullName"
                                            data-user-role="@u.Role"
                                            title="@T["users.view_courses","View courses"]">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                }

                                @if (u.Id != currentUserId)
                                {
                                    <button type="button"
                                            class="btn btn-sm @(u.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                            data-bs-toggle="modal" data-bs-target="#toggleModal"
                                            data-user-id="@u.Id"
                                            data-user-name="@u.FullName"
                                            data-confirm-msg="@(u.IsActive ? T["users.confirm_deactivate", "Deactivate"] : T["users.confirm_activate", "Activate"]) &quot;@u.FullName&quot;?"
                                            title="@(u.IsActive ? T["users.confirm_deactivate","Deactivate"] : T["users.confirm_activate","Activate"])">
                                        <i class="bi @(u.IsActive ? "bi-person-dash" : "bi-person-check")"></i>
                                    </button>

                                    @if (u.Role != "Admin")
                                    {
                                        @if (u.Role == "Teacher" && u.CourseCount > 0)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    data-bs-toggle="modal" data-bs-target="#deleteBlockedModal"
                                                    data-user-name="@u.FullName"
                                                    data-course-count="@u.CourseCount"
                                                    title="@T["users.delete","Delete"]">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                    data-user-id="@u.Id"
                                                    data-user-name="@u.FullName"
                                                    data-user-role="@u.Role"
                                                    title="@T["users.delete","Delete"]">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ── View Courses Modal ──────────────────────────────────── *@
<div class="modal fade" id="coursesModal" tabindex="-1" aria-labelledby="coursesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="coursesModalLabel">
                    <i class="bi bi-mortarboard me-2"></i><span id="coursesModalUserName"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="coursesModalBody">
                <div class="text-center py-3">
                    <div class="spinner-border text-bocconi" role="status"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T["common.close","Close"]</button>
            </div>
        </div>
    </div>
</div>

@* ── Toggle Modal ────────────────────────────────────────── *@
<div class="modal fade" id="toggleModal" tabindex="-1" aria-labelledby="toggleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="toggleModalLabel">@T["common.confirm_action", "Confirm Action"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="toggleModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T["common.cancel", "Cancel"]</button>
                <form id="toggleForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-bocconi">@T["common.confirm", "Confirm"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

@* ── Delete Modal ────────────────────────────────────────── *@
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel"><i class="bi bi-exclamation-triangle me-2"></i>@T["users.delete_title","Delete user"]</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="deleteModalBody"></p>
                <div id="deleteStudentWarning" class="alert alert-warning small d-none">
                    <i class="bi bi-exclamation-triangle me-1"></i>@T["users.delete_student_warning","All quiz attempts, lesson progress and enrollment records will also be permanently deleted."]
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T["common.cancel","Cancel"]</button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">@T["users.delete_confirm","Yes, delete"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

@* ── Delete Blocked Modal ────────────────────────────────── *@
<div class="modal fade" id="deleteBlockedModal" tabindex="-1" aria-labelledby="deleteBlockedLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteBlockedLabel"><i class="bi bi-lock me-2"></i>@T["users.delete_blocked_title","Cannot delete teacher"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="deleteBlockedBody"></p>
                <p class="text-muted small">@T["users.delete_blocked_hint","Reassign or delete all courses for this teacher before deleting their account."]</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-bocconi" data-bs-dismiss="modal">@T["common.ok","OK"]</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var _lbl = {
            noCourseTaught:    @Json.Serialize(T["users.no_courses_taught","This teacher has no courses."]),
            noCourseEnrolled:  @Json.Serialize(T["users.no_courses_enrolled","This student is not enrolled in any course."]),
            coursesTaught:     @Json.Serialize(T["users.courses_taught","Courses taught"]),
            coursesEnrolled:   @Json.Serialize(T["users.courses_enrolled","Enrolled courses"]),
            published:         @Json.Serialize(T["common.published","Published"]),
            draft:             @Json.Serialize(T["common.draft","Draft"]),
            error:             @Json.Serialize(T["common.error","An error occurred."]),
            deleteConfirmMsg:  @Json.Serialize(T["users.delete_confirm_msg","Are you sure you want to delete"]),
            deleteBlockedMsg:  @Json.Serialize(T["users.delete_blocked_msg","has"]),
            deleteBlockedCourses: @Json.Serialize(T["users.delete_blocked_courses","active course(s) and cannot be deleted."])
        };

        $(document).ready(function () {
            $('#usersTable').DataTable({ language: window.dtLang() });

            // ── View courses (eye button) ──────────────────────────
            $(document).on('click', '.btn-view-courses', function () {
                var userId   = $(this).data('user-id');
                var userName = $(this).data('user-name');
                var userRole = $(this).data('user-role');

                $('#coursesModalUserName').text(userName);
                $('#coursesModalBody').html('<div class="text-center py-3"><div class="spinner-border text-bocconi" role="status"></div></div>');
                var modal = new bootstrap.Modal(document.getElementById('coursesModal'));
                modal.show();

                $.getJSON('/Admin/UserCourses/' + userId, function (data) {
                    var html = '';
                    var courses = data.courses;

                    if (!courses || courses.length === 0) {
                        var emptyMsg = userRole === 'Teacher' ? _lbl.noCourseTaught : _lbl.noCourseEnrolled;
                        html = '<p class="text-muted text-center py-3"><i class="bi bi-inbox me-2"></i>' + emptyMsg + '</p>';
                    } else {
                        var heading = userRole === 'Teacher' ? _lbl.coursesTaught : _lbl.coursesEnrolled;
                        html += '<p class="text-muted small mb-3"><i class="bi bi-info-circle me-1"></i>' + heading + '</p>';
                        html += '<div class="list-group">';
                        courses.forEach(function (c) {
                            var statusBadge = c.isPublished
                                ? '<span class="badge bg-success ms-2">' + _lbl.published + '</span>'
                                : '<span class="badge bg-secondary ms-2">' + _lbl.draft + '</span>';

                            var progressHtml = '';
                            if (userRole === 'Student' && c.totalLessons > 0) {
                                var pct = Math.round(c.completedLessons / c.totalLessons * 100);
                                progressHtml = '<div class="mt-1"><div class="progress" style="height:5px;">' +
                                    '<div class="progress-bar bg-bocconi" style="width:' + pct + '%"></div>' +
                                    '</div><div class="text-muted" style="font-size:.75rem;">' + c.completedLessons + '/' + c.totalLessons + ' lessons &mdash; ' + pct + '%</div></div>';
                            }

                            html += '<a href="/Course/Details/' + c.id + '" class="list-group-item list-group-item-action" target="_blank">' +
                                '<div class="d-flex justify-content-between align-items-center">' +
                                '<span><i class="bi bi-book me-2 text-bocconi"></i><strong>' + c.title + '</strong>' + statusBadge + '</span>' +
                                '<i class="bi bi-box-arrow-up-right text-muted small"></i>' +
                                '</div>' + progressHtml + '</a>';
                        });
                        html += '</div>';
                    }
                    $('#coursesModalBody').html(html);
                }).fail(function () {
                    $('#coursesModalBody').html('<div class="alert alert-danger">' + _lbl.error + '</div>');
                });
            });

            // ── Toggle modal ───────────────────────────────────────
            $('#toggleModal').on('show.bs.modal', function (e) {
                var btn = $(e.relatedTarget);
                $('#toggleModalBody').text(btn.data('confirm-msg'));
                $('#toggleForm').attr('action', '/Admin/ToggleUser/' + btn.data('user-id'));
            });

            // ── Delete modal ───────────────────────────────────────
            $('#deleteModal').on('show.bs.modal', function (e) {
                var btn = $(e.relatedTarget);
                var name = btn.data('user-name');
                var role = btn.data('user-role');
                $('#deleteModalBody').text(_lbl.deleteConfirmMsg + ' "' + name + '"?');
                if (role === 'Student') {
                    $('#deleteStudentWarning').removeClass('d-none');
                } else {
                    $('#deleteStudentWarning').addClass('d-none');
                }
                $('#deleteForm').attr('action', '/Admin/DeleteUser/' + btn.data('user-id'));
            });

            // ── Delete blocked modal ───────────────────────────────
            $('#deleteBlockedModal').on('show.bs.modal', function (e) {
                var btn = $(e.relatedTarget);
                var name = btn.data('user-name');
                var count = btn.data('course-count');
                $('#deleteBlockedBody').text('"' + name + '" ' + _lbl.deleteBlockedMsg + ' ' + count + ' ' + _lbl.deleteBlockedCourses);
            });
        });
    </script>
}
