@model UsersAndRolesViewModel
@{
    ViewData["Title"] = T["admin.users_roles","Users & Roles"];
    var currentUserId = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);
    var activeTab = Model.ActiveTab;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-bocconi mb-0"><i class="bi bi-people me-2"></i>@T["admin.users_roles","Users & Roles"]</h2>
    @if (activeTab == "utenti")
    {
        <a asp-action="CreateUser" class="btn btn-bocconi">
            <i class="bi bi-person-plus me-1"></i>@T["admin.users.new_btn", "New User"]
        </a>
    }
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
        <i class="bi bi-check-circle me-2"></i>@ok
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@err
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<ul class="nav nav-tabs mb-4" id="usersRolesTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "utenti" ? "active" : "")"
                id="tab-utenti" data-bs-toggle="tab" data-bs-target="#pane-utenti"
                type="button" role="tab">
            <i class="bi bi-people me-1"></i>@T["admin.users_tab","Users"]
            <span class="badge bg-secondary ms-1">@Model.Users.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "ruoli" ? "active" : "")"
                id="tab-ruoli" data-bs-toggle="tab" data-bs-target="#pane-ruoli"
                type="button" role="tab">
            <i class="bi bi-shield-lock me-1"></i>@T["admin.roles_tab","Roles"]
            <span class="badge bg-secondary ms-1">@Model.Roles.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "aree" ? "active" : "")"
                id="tab-aree" data-bs-toggle="tab" data-bs-target="#pane-aree"
                type="button" role="tab">
            <i class="bi bi-diagram-3 me-1"></i>@T["admin.areas_tab","Areas"]
            <span class="badge bg-secondary ms-1">@Model.Areas.Count</span>
        </button>
    </li>
</ul>

<div class="tab-content" id="usersRolesTabContent">

    @* ─── TAB UTENTI ─────────────────────────────────────────────────── *@
    <div class="tab-pane fade @(activeTab == "utenti" ? "show active" : "")"
         id="pane-utenti" role="tabpanel">
        <div class="card">
            <div class="card-body">
                <table id="usersTable" class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>@T["common.name", "Name"]</th>
                            <th>Email</th>
                            <th>@T["common.role", "Role"]</th>
                            <th>@T["common.status", "Status"]</th>
                            <th>@T["common.registered", "Registered"]</th>
                            <th>@T["common.actions", "Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Users)
                        {
                            <tr>
                                <td><strong>@u.FullName</strong></td>
                                <td>@u.Email</td>
                                <td>
                                    @{
                                        var roleClass = u.Role switch {
                                            "Admin"   => "bg-danger",
                                            "Teacher" => "bg-primary",
                                            _         => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @roleClass">@u.Role</span>
                                </td>
                                <td>
                                    @if (u.IsActive)
                                    {
                                        <span class="badge bg-success">@T["common.active", "Active"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@T["common.inactive", "Inactive"]</span>
                                    }
                                </td>
                                <td class="text-muted small">@u.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="EditUser" asp-route-id="@u.Id"
                                           class="btn btn-sm btn-outline-secondary" title="@T["common.edit","Edit"]">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        @if (u.Role != "Admin")
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-info btn-view-courses"
                                                    data-user-id="@u.Id"
                                                    data-user-name="@u.FullName"
                                                    data-user-role="@u.Role"
                                                    title="@T["users.view_courses","View courses"]">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        }

                                        <button type="button"
                                                class="btn btn-sm @(u.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                data-bs-toggle="modal" data-bs-target="#toggleModal"
                                                data-user-id="@u.Id"
                                                data-user-name="@u.FullName"
                                                data-confirm-msg="@(u.IsActive ? T["users.confirm_deactivate","Deactivate"] : T["users.confirm_activate","Activate"]) &quot;@u.FullName&quot;?"
                                                title="@(u.IsActive ? T["users.confirm_deactivate","Deactivate"] : T["users.confirm_activate","Activate"])">
                                            <i class="bi @(u.IsActive ? "bi-person-dash" : "bi-person-check")"></i>
                                        </button>

                                        @if (u.Id != currentUserId && u.Role != "Admin")
                                        {
                                            @if (u.Role == "Teacher" && u.CourseCount > 0)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger"
                                                        data-bs-toggle="modal" data-bs-target="#deleteBlockedModal"
                                                        data-user-name="@u.FullName"
                                                        data-course-count="@u.CourseCount"
                                                        title="@T["users.delete","Delete"]">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger"
                                                        data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                        data-user-id="@u.Id"
                                                        data-user-name="@u.FullName"
                                                        data-user-role="@u.Role"
                                                        title="@T["users.delete","Delete"]">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ─── TAB RUOLI ──────────────────────────────────────────────────── *@
    <div class="tab-pane fade @(activeTab == "ruoli" ? "show active" : "")"
         id="pane-ruoli" role="tabpanel">

        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <span class="fw-semibold"><i class="bi bi-shield-lock me-2 text-bocconi"></i>@T["admin.roles_tab","Roles"]</span>
                <button type="button" class="btn btn-sm btn-bocconi"
                        data-bs-toggle="modal" data-bs-target="#createRoleModal">
                    <i class="bi bi-plus me-1"></i>@T["admin.create_role","Create role"]
                </button>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">@T["common.name","Name"]</th>
                            <th class="text-center" style="width:130px">@T["admin.users_tab","Users"]</th>
                            <th style="width:110px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Roles)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold">
                                    @r.Name
                                    @if (r.IsAdmin)
                                    {
                                        <span class="badge bg-secondary ms-2 fw-normal">@T["admin.role_protected","protected"]</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (r.UserCount > 0)
                                    {
                                        <a asp-action="Users" class="badge bg-bocconi text-decoration-none">@r.UserCount</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">0</span>
                                    }
                                </td>
                                <td class="pe-3">
                                    @if (!r.IsAdmin)
                                    {
                                        <div class="d-flex gap-1 justify-content-end">
                                            <a asp-action="EditRole" asp-route-id="@r.Id"
                                               class="btn btn-sm btn-outline-secondary"
                                               title="@T["admin.edit_role","Edit role name"]">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            @if (r.UserCount > 0)
                                            {
                                                <button type="button" disabled
                                                        class="btn btn-sm btn-outline-secondary"
                                                        title="@T["admin.delete_role_blocked","Cannot delete: users have this role"]">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <form asp-action="DeleteRole" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@r.Id" />
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="@T["admin.delete_role","Delete role"]"
                                                            data-confirm="@T["admin.delete_role_confirm","Delete role"] '@r.Name'?">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ─── TAB AREE ───────────────────────────────────────────────────── *@
    <div class="tab-pane fade @(activeTab == "aree" ? "show active" : "")"
         id="pane-aree" role="tabpanel">

        <div class="card mb-4 border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold py-3">
                <i class="bi bi-plus-circle me-2 text-bocconi"></i>@T["admin.add_area","Add new area"]
            </div>
            <div class="card-body">
                <form asp-action="CreateArea" method="post" class="d-flex gap-2 align-items-start">
                    @Html.AntiForgeryToken()
                    <div class="flex-grow-1">
                        <input type="text" name="name" class="form-control"
                               placeholder="@T["admin.area_name_placeholder","Area name…"]"
                               maxlength="255" autocomplete="off" />
                    </div>
                    <button type="submit" class="btn btn-bocconi">
                        <i class="bi bi-plus me-1"></i>@T["admin.create_area","Create area"]
                    </button>
                </form>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-0">
                @if (!Model.Areas.Any())
                {
                    <p class="text-muted p-4">@T["admin.no_areas","No areas defined yet."]</p>
                }
                else
                {
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">@T["common.name","Name"]</th>
                                <th class="text-center" style="width:130px">@T["admin.users_tab","Users"]</th>
                                <th style="width:80px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Areas)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">@a.Name</td>
                                    <td class="text-center">
                                        @if (a.UserCount > 0)
                                        {
                                            <span class="badge bg-bocconi">@a.UserCount</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">0</span>
                                        }
                                    </td>
                                    <td class="pe-3 text-end">
                                        <form asp-action="DeleteArea" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@a.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm @(a.UserCount > 0 ? "btn-outline-secondary" : "btn-outline-danger")"
                                                    title="@T["admin.delete_area","Delete area"]"
                                                    @(a.UserCount > 0 ? "disabled" : "")
                                                    @(a.UserCount == 0 ? $"data-confirm=\"{T["admin.delete_area_confirm","Delete area"]} '{a.Name}'?\"" : "")>
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

</div>

@* ── Modali ──────────────────────────────────────────────────────── *@

@* Modale: Crea nuovo ruolo *@
<div class="modal fade" id="createRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-shield-plus me-2"></i>@T["admin.create_role","Create role"]
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateRole" method="post" id="createRoleForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <label class="form-label fw-semibold">
                        @T["common.name","Name"] <span class="text-danger">*</span>
                    </label>
                    <input type="text" name="name" id="createRoleName" class="form-control"
                           placeholder="@T["admin.role_name_placeholder","Role name (e.g. Tutor, Supervisor…)"]"
                           maxlength="50" autocomplete="off" required />
                    <div class="form-text mt-1">@T["admin.role_hint_simple","The Admin role is reserved."]</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T["common.cancel","Cancel"]</button>
                    <button type="submit" class="btn btn-bocconi">
                        <i class="bi bi-plus me-1"></i>@T["admin.create_role","Create role"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="coursesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-mortarboard me-2"></i><span id="coursesModalUserName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="coursesModalBody">
                <div class="text-center py-3"><div class="spinner-border text-bocconi" role="status"></div></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T["common.close","Close"]</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="toggleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@T["common.confirm_action", "Confirm Action"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="toggleModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T["common.cancel", "Cancel"]</button>
                <form id="toggleForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-bocconi">@T["common.confirm", "Confirm"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>@T["users.delete_title","Delete user"]</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="deleteModalBody"></p>
                <div id="deleteStudentWarning" class="alert alert-warning small d-none">
                    <i class="bi bi-exclamation-triangle me-1"></i>@T["users.delete_student_warning","All quiz attempts, lesson progress and enrollment records will also be permanently deleted."]
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T["common.cancel","Cancel"]</button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">@T["users.delete_confirm","Yes, delete"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteBlockedModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-lock me-2"></i>@T["users.delete_blocked_title","Cannot delete teacher"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="deleteBlockedBody"></p>
                <p class="text-muted small">@T["users.delete_blocked_hint","Reassign or delete all courses for this teacher before deleting their account."]</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-bocconi" data-bs-dismiss="modal">@T["common.ok","OK"]</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var _lbl = {
            noCourseTaught:       @Json.Serialize(T["users.no_courses_taught","This teacher has no courses."]),
            noCourseEnrolled:     @Json.Serialize(T["users.no_courses_enrolled","This student is not enrolled in any course."]),
            coursesTaught:        @Json.Serialize(T["users.courses_taught","Courses taught"]),
            coursesEnrolled:      @Json.Serialize(T["users.courses_enrolled","Enrolled courses"]),
            published:            @Json.Serialize(T["common.published","Published"]),
            draft:                @Json.Serialize(T["common.draft","Draft"]),
            error:                @Json.Serialize(T["common.error","An error occurred."]),
            deleteConfirmMsg:     @Json.Serialize(T["users.delete_confirm_msg","Are you sure you want to delete"]),
            deleteBlockedMsg:     @Json.Serialize(T["users.delete_blocked_msg","has"]),
            deleteBlockedCourses: @Json.Serialize(T["users.delete_blocked_courses","active course(s) and cannot be deleted."])
        };

        $(document).ready(function () {
            $('#usersTable').DataTable({ language: window.dtLang() });

            // ── Focus campo nome al'apertura modale crea ruolo ────────
            document.getElementById('createRoleModal').addEventListener('shown.bs.modal', function () {
                document.getElementById('createRoleName').focus();
            });
            document.getElementById('createRoleModal').addEventListener('hidden.bs.modal', function () {
                document.getElementById('createRoleName').value = '';
            });

            // ── View courses ──────────────────────────────────────
            $(document).on('click', '.btn-view-courses', function () {
                var userId   = $(this).data('user-id');
                var userName = $(this).data('user-name');
                var userRole = $(this).data('user-role');
                $('#coursesModalUserName').text(userName);
                $('#coursesModalBody').html('<div class="text-center py-3"><div class="spinner-border text-bocconi" role="status"></div></div>');
                new bootstrap.Modal(document.getElementById('coursesModal')).show();
                $.getJSON('/Admin/UserCourses/' + userId, function (data) {
                    var html = '';
                    var courses = data.courses;
                    if (!courses || courses.length === 0) {
                        var emptyMsg = userRole === 'Teacher' ? _lbl.noCourseTaught : _lbl.noCourseEnrolled;
                        html = '<p class="text-muted text-center py-3"><i class="bi bi-inbox me-2"></i>' + emptyMsg + '</p>';
                    } else {
                        var heading = userRole === 'Teacher' ? _lbl.coursesTaught : _lbl.coursesEnrolled;
                        html += '<p class="text-muted small mb-3"><i class="bi bi-info-circle me-1"></i>' + heading + '</p><div class="list-group">';
                        courses.forEach(function (c) {
                            var statusBadge = c.isPublished
                                ? '<span class="badge bg-success ms-2">' + _lbl.published + '</span>'
                                : '<span class="badge bg-secondary ms-2">' + _lbl.draft + '</span>';
                            var progressHtml = '';
                            if (userRole === 'Student' && c.totalLessons > 0) {
                                var pct = Math.round(c.completedLessons / c.totalLessons * 100);
                                progressHtml = '<div class="mt-1"><div class="progress" style="height:5px;"><div class="progress-bar bg-bocconi" style="width:' + pct + '%"></div></div><div class="text-muted" style="font-size:.75rem;">' + c.completedLessons + '/' + c.totalLessons + ' &mdash; ' + pct + '%</div></div>';
                            }
                            html += '<a href="/Course/Details/' + c.id + '" class="list-group-item list-group-item-action" target="_blank"><div class="d-flex justify-content-between align-items-center"><span><i class="bi bi-book me-2 text-bocconi"></i><strong>' + c.title + '</strong>' + statusBadge + '</span><i class="bi bi-box-arrow-up-right text-muted small"></i></div>' + progressHtml + '</a>';
                        });
                        html += '</div>';
                    }
                    $('#coursesModalBody').html(html);
                }).fail(function () {
                    $('#coursesModalBody').html('<div class="alert alert-danger">' + _lbl.error + '</div>');
                });
            });

            // ── Toggle modal ──────────────────────────────────────
            $('#toggleModal').on('show.bs.modal', function (e) {
                var btn = $(e.relatedTarget);
                $('#toggleModalBody').text(btn.data('confirm-msg'));
                $('#toggleForm').attr('action', '/Admin/ToggleUser/' + btn.data('user-id'));
            });

            // ── Delete modal ──────────────────────────────────────
            $('#deleteModal').on('show.bs.modal', function (e) {
                var btn = $(e.relatedTarget);
                var name = btn.data('user-name');
                var role = btn.data('user-role');
                $('#deleteModalBody').text(_lbl.deleteConfirmMsg + ' "' + name + '"?');
                if (role === 'Student') {
                    $('#deleteStudentWarning').removeClass('d-none');
                } else {
                    $('#deleteStudentWarning').addClass('d-none');
                }
                $('#deleteForm').attr('action', '/Admin/DeleteUser/' + btn.data('user-id'));
            });

            // ── Delete blocked ────────────────────────────────────
            $('#deleteBlockedModal').on('show.bs.modal', function (e) {
                var btn = $(e.relatedTarget);
                $('#deleteBlockedBody').text('"' + btn.data('user-name') + '" ' + _lbl.deleteBlockedMsg + ' ' + btn.data('course-count') + ' ' + _lbl.deleteBlockedCourses);
            });
        });
    </script>
}
