@{
    ViewData["Title"] = T["admin.database_page_title"];
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="fw-bold text-bocconi mb-0">
        <i class="bi bi-database-gear me-2"></i>@T["admin.database_page_title"]
    </h2>
    <a asp-controller="Home" asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>@T["common.back_dashboard"]
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@{
    var hasPendingScript = (bool)(ViewData["HasPendingScript"] ?? false);
    var tmpPwd = TempData["TmpAdminPassword"] as string ?? "";
    var tmpEmail = TempData["TmpAdminEmail"] as string ?? "admin@bocconi.it";
}
@if (!string.IsNullOrEmpty(tmpPwd))
{
    <div class="alert alert-warning border border-warning shadow-sm" role="alert">
        <div class="d-flex align-items-start gap-2">
            <i class="bi bi-key-fill fs-4 mt-1 text-warning"></i>
            <div class="flex-fill">
                <strong>@T["admin.prod_script_ready"]</strong>
                <p class="mb-1 small text-muted">
                    @T["admin.prod_script_pwd_hint"]
                </p>
                <div class="d-flex align-items-center gap-2 mt-2">
                    <code class="fs-5 bg-white px-3 py-1 rounded border" id="tmpPwdCode">@tmpPwd</code>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            onclick="navigator.clipboard.writeText(document.getElementById('tmpPwdCode').textContent.trim()).then(()=>{this.textContent='Copied ✓';this.disabled=true;})">
                        @T["common.copy"]
                    </button>
                </div>
                <p class="mb-0 mt-2 small">
                    <strong>Email admin:</strong> <code>@tmpEmail</code>
                </p>
            </div>
        </div>
        @if (hasPendingScript)
        {
            <hr class="my-2" />
            <a asp-action="DownloadProductionScript" id="autoDownloadLink" class="btn btn-warning">
                <i class="bi bi-download me-1"></i>@T["admin.prod_script_download"]
            </a>
            <span class="text-muted small ms-2">
                @T["admin.prod_script_auto_download"]
            </span>
        }
    </div>
}
@if (hasPendingScript && string.IsNullOrEmpty(tmpPwd))
{
    <div class="alert alert-info d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-info-circle"></i>
        @T["admin.prod_script_already_ready"]
        <a asp-action="DownloadProductionScript" class="btn btn-sm btn-info ms-2">
            <i class="bi bi-download me-1"></i>@T["admin.prod_script_download"]
        </a>
    </div>
}

@* ── Importa dati da SQL Server ────────────────────────────────────────── *@
<div class="card shadow-sm mb-4 border-primary">
    <div class="card-header fw-semibold bg-primary bg-opacity-10 d-flex align-items-center gap-2">
        <i class="bi bi-cloud-arrow-down text-primary"></i>
        @T["dataimport.card_title"]
    </div>
    <div class="card-body">
        <p class="text-muted small mb-3">
            @T["dataimport.card_desc"]
        </p>
        <a asp-controller="DataImport" asp-action="Connect" class="btn btn-primary">
            <i class="bi bi-play-circle me-1"></i>@T["dataimport.card_btn"]
        </a>
    </div>
</div>

@* ── Script per produzione ─────────────────────────────────────────────── *@
<div class="card shadow-sm">
    <div class="card-header fw-semibold bg-light d-flex align-items-center gap-2">
        <i class="bi bi-file-earmark-code"></i>
        @T["admin.prod_script_title"]
    </div>
    <div class="card-body">
        <p class="text-muted small mb-3">
            @T["admin.prod_script_desc"]
        </p>

        <form method="post" asp-action="GenerateProductionScript" id="frmProdScript">
            @Html.AntiForgeryToken()
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="includeDataDictionary"
                       value="true" id="chkDataDictionary" />
                <label class="form-check-label" for="chkDataDictionary">
                    @T["admin.prod_script_include_data_dictionary"]
                </label>
                <div class="form-text">
                    @T["admin.prod_script_data_dictionary_hint"]
                </div>
            </div>

            <div class="d-flex align-items-center gap-3 flex-wrap">
                <button type="submit" class="btn btn-bocconi" id="btnGenerate"
                        onclick="this.disabled=true; this.innerHTML='<span class=\'spinner-border spinner-border-sm me-1\'></span>Generating…'; this.form.submit();">
                    <i class="bi bi-gear me-1"></i>@T["admin.prod_script_generate_btn"]
                </button>
            </div>
        </form>

        <div class="mt-3 p-3 bg-light rounded border small text-muted">
            <strong><i class="bi bi-shield-exclamation me-1 text-danger"></i>@T["admin.prod_script_warning_title"]</strong>
            <ul class="mb-0 mt-1 ps-3">
                <li>@T["admin.prod_script_w1"]</li>
                <li>@T["admin.prod_script_w2"]</li>
                <li>@T["admin.prod_script_w3"]</li>
                <li>@T["admin.prod_script_w4"]</li>
            </ul>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(tmpPwd) && hasPendingScript)
{
    <script>
        window.addEventListener('DOMContentLoaded', function () {
            var link = document.getElementById('autoDownloadLink');
            if (link) { setTimeout(function () { link.click(); }, 600); }
        });
    </script>
}
