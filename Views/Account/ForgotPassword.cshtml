@model BocconiLMS.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Password dimenticata";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header bg-bocconi text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-envelope-at me-2"></i>Password dimenticata</h5>
            </div>
            <div class="card-body p-4">
                <p class="text-muted mb-4">
                    Inserisci il tuo indirizzo email istituzionale. Se è presente nel sistema riceverai un link per reimpostare la password.
                </p>
                <form asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="alert alert-danger small">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    }
                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-semibold">Email istituzionale</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="nome.cognome@studbocconi.it" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-bocconi fw-semibold">
                            <i class="bi bi-send me-1"></i>Invia link di reset
                        </button>
                        <a asp-action="Login" class="btn btn-outline-secondary">Annulla</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
