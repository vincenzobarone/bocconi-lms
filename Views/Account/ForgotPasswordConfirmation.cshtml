@{
    ViewData["Title"] = "Email inviata";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header bg-bocconi text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-check-circle me-2"></i>Email inviata</h5>
            </div>
            <div class="card-body p-4 text-center">
                <div class="mb-3" style="font-size:3rem;color:#003366;">
                    <i class="bi bi-envelope-check"></i>
                </div>
                <p class="mb-3">
                    Se l'indirizzo email inserito è associato a un account attivo, riceverai a breve un'email con le istruzioni per reimpostare la password.
                </p>
                <p class="text-muted small mb-4">
                    Il link sarà valido per 1 ora. Controlla anche la cartella spam se non vedi l'email.
                </p>
                <a asp-action="Login" class="btn btn-bocconi fw-semibold">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Torna al login
                </a>
            </div>
        </div>
    </div>
</div>
