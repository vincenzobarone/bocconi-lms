@{
    ViewData["Title"] = T["auth.email_sent_title"];
    Layout = "_Layout";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header bg-bocconi text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-check-circle me-2"></i>@T["auth.email_sent_title"]</h5>
            </div>
            <div class="card-body p-4 text-center">
                <div class="mb-3" style="font-size:3rem;color:#003366;">
                    <i class="bi bi-envelope-check"></i>
                </div>
                <p class="mb-3">
                    @T["auth.email_sent_msg"]
                </p>
                <p class="text-muted small mb-4">
                    @T["auth.email_sent_hint"]
                </p>
                <a asp-action="Login" class="btn btn-bocconi fw-semibold">
                    <i class="bi bi-box-arrow-in-right me-1"></i>@T["auth.back_to_login"]
                </a>
            </div>
        </div>
    </div>
</div>
