@model BocconiLMS.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = T["auth.reset_password_title"];
    Layout = "_Layout";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header bg-bocconi text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-key me-2"></i>@T["auth.reset_password_title"]</h5>
            </div>
            <div class="card-body p-4">
                @if (ViewBag.InvalidToken == true)
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        @T["auth.invalid_token"]
                        <a asp-action="ForgotPassword" class="alert-link">@T["auth.request_new_link"]</a>.
                    </div>
                }
                else
                {
                    <form asp-action="ResetPassword" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Token" />

                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                        {
                            <div class="alert alert-danger small">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <div>@error.ErrorMessage</div>
                                }
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-semibold">@T["auth.new_password"]</label>
                            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            <div class="form-text">@T["auth.min_8_chars"]</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">@T["auth.confirm_new_password"]</label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-bocconi fw-semibold">
                                <i class="bi bi-check-lg me-1"></i>@T["auth.save_password"]
                            </button>
                            <a asp-action="Login" class="btn btn-outline-secondary">@T["common.cancel"]</a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
