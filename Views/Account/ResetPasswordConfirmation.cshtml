@{
    ViewData["Title"] = "Password reimpostata";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header bg-bocconi text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-check-circle me-2"></i>Password reimpostata</h5>
            </div>
            <div class="card-body p-4 text-center">
                <div class="mb-3" style="font-size:3rem;color:#28a745;">
                    <i class="bi bi-shield-check"></i>
                </div>
                <p class="mb-4">
                    La tua password è stata reimpostata con successo. Puoi ora accedere con le nuove credenziali.
                </p>
                <a asp-action="Login" class="btn btn-bocconi fw-semibold">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Accedi
                </a>
            </div>
        </div>
    </div>
</div>
