@{
    ViewData["Title"] = T["auth.password_reset_title","Password reset"];
    Layout = "_Layout";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header bg-bocconi text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-check-circle me-2"></i>@T["auth.password_reset_title","Password reset"]</h5>
            </div>
            <div class="card-body p-4 text-center">
                <div class="mb-3" style="font-size:3rem;color:#28a745;">
                    <i class="bi bi-shield-check"></i>
                </div>
                <p class="mb-4">
                    @T["auth.password_reset_msg","Your password has been reset successfully. You can now log in with your new credentials."]
                </p>
                <a asp-action="Login" class="btn btn-bocconi fw-semibold">
                    <i class="bi bi-box-arrow-in-right me-1"></i>@T["nav.login","Log in"]
                </a>
            </div>
        </div>
    </div>
</div>
