@model LoginViewModel
@{
    ViewData["Title"] = "Accedi";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header bg-bocconi text-white text-center py-4">
                <i class="bi bi-mortarboard-fill display-5 d-block mb-2" style="color:#c8a96e;"></i>
                <h4 class="mb-0 fw-bold">Accesso alla Piattaforma</h4>
                <small>Università Bocconi — LMS</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small" style="display:none" id="valSummary"></div>
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="alert alert-danger small">
                            <asp-validation-summary model-only="true"></asp-validation-summary>
                        </div>
                    }
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Email istituzionale</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="nome.cognome@studbocconi.it" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-semibold">Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-bocconi w-100 py-2 fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Accedi
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
