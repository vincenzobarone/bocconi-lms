@{
    ViewData["Title"] = T["auth.reset_landing_title","Reset password"];
    Layout = "_Layout";
    bool invalid = ViewBag.InvalidToken == true;
    string token  = ViewBag.Token ?? "";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header bg-bocconi text-white py-3">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-key me-2"></i>@T["auth.reset_landing_title","Reset password"]
                </h5>
            </div>
            <div class="card-body p-4 text-center">
                @if (invalid)
                {
                    <i class="bi bi-exclamation-circle display-4 text-danger mb-3 d-block"></i>
                    <p class="mb-3">@T["auth.invalid_token","The reset link is invalid or has expired."]</p>
                    <a asp-action="ForgotPassword" class="btn btn-bocconi">
                        @T["auth.request_new_link","Request a new one"]
                    </a>
                }
                else
                {
                    <i class="bi bi-shield-lock display-4 text-bocconi mb-3 d-block"></i>
                    <p class="mb-1 fw-semibold">@T["auth.reset_landing_heading","Link di reset confermato"]</p>
                    <p class="text-muted small mb-4">@T["auth.reset_landing_desc","Clicca il pulsante per scegliere una nuova password. Il link è valido per 1 ora."]</p>

                    <form asp-action="ResetLanding" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="token" value="@token" />
                        <button type="submit" class="btn btn-bocconi px-4 fw-semibold">
                            <i class="bi bi-arrow-right-circle me-2"></i>@T["auth.reset_landing_btn","Procedi al reset"]
                        </button>
                    </form>

                    <div class="mt-3">
                        <a asp-action="Login" class="text-muted small">@T["auth.cancel_go_login","Annulla e torna al login"]</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
