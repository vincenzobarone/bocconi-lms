@model List<BocconiLMS.Models.SourceTableInfo>
@{
    ViewData["Title"] = T["dataimport.page_title"];
    var masked = ViewBag.Masked as string ?? "";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h2 class="fw-bold text-bocconi mb-0">
        <i class="bi bi-cloud-arrow-down me-2"></i>@T["dataimport.page_title"]
    </h2>
    <a asp-controller="DataImport" asp-action="Cancel" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-x-circle me-1"></i>@T["dataimport.cancel"]
    </a>
</div>

@await Html.PartialAsync("_DataImportStepper", 1)

<div class="card shadow-sm">
    <div class="card-header fw-semibold bg-light d-flex align-items-center gap-2">
        <i class="bi bi-table text-bocconi"></i>@T["dataimport.tables_title"]
        <span class="badge bg-secondary ms-auto">@Model.Count tabelle</span>
    </div>
    <div class="card-body">
        <div class="alert alert-secondary d-flex gap-2 py-2 mb-3">
            <i class="bi bi-database flex-shrink-0 mt-1"></i>
            <span class="small font-monospace">@masked</span>
        </div>

        @if (!Model.Any())
        {
            <p class="text-muted">Nessuna tabella trovata nel database sorgente.</p>
        }
        else
        {
            <div class="mb-3">
                <input type="text" id="tableSearch" class="form-control form-control-sm"
                       placeholder="Filtra tabelle…" />
            </div>

            <form method="post" asp-action="SelectTable" id="frmSelectTable">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-semibold">@T["dataimport.target_label"]</label>
                    <div class="d-flex gap-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="target"
                                   value="Materials" id="tgtMat" checked />
                            <label class="form-check-label" for="tgtMat">
                                <i class="bi bi-file-earmark-text me-1"></i>@T["dataimport.target_materials"]
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="target"
                                   value="MaterialFolders" id="tgtFld" />
                            <label class="form-check-label" for="tgtFld">
                                <i class="bi bi-folder me-1"></i>@T["dataimport.target_folders"]
                            </label>
                        </div>
                    </div>
                </div>

                <div class="table-responsive" style="max-height:420px;overflow-y:auto;">
                    <table class="table table-hover table-sm align-middle" id="tblTables">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th style="width:2rem;"></th>
                                <th>Schema</th>
                                <th>Tabella</th>
                                <th class="text-end">Righe (approx)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model)
                            {
                                var rowId = $"row_{t.Schema}_{t.Name}";
                                <tr class="table-row-selectable" style="cursor:pointer;"
                                    onclick="document.getElementById('@(rowId)').click()">
                                    <td>
                                        <input class="form-check-input" type="radio"
                                               name="schema" id="@rowId"
                                               value="@t.Schema"
                                               data-table="@t.Name"
                                               onclick="event.stopPropagation();
                                                        document.querySelector('[name=table]').value=this.dataset.table;" />
                                    </td>
                                    <td class="text-muted small">@t.Schema</td>
                                    <td class="fw-semibold">@t.Name</td>
                                    <td class="text-end text-muted small">@t.RowCount.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <input type="hidden" name="table" id="hidTable" value="" />

                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-bocconi" id="btnNext" disabled>
                        <i class="bi bi-arrow-right me-1"></i>Configura mapping
                    </button>
                    <a asp-action="Connect" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Indietro
                    </a>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
<script>
    // Abilita pulsante quando una riga è selezionata
    document.querySelectorAll('input[name="schema"]').forEach(r => {
        r.addEventListener('change', () => {
            document.getElementById('hidTable').value = r.dataset.table;
            document.getElementById('btnNext').disabled = false;
        });
    });

    // Filtro live tabelle
    document.getElementById('tableSearch').addEventListener('input', function () {
        var q = this.value.toLowerCase();
        document.querySelectorAll('#tblTables tbody tr').forEach(tr => {
            tr.style.display = tr.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
    });
</script>
}
