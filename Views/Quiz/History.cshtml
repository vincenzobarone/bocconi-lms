@model List<QuizAttempt>
@{
    var quiz = ViewBag.Quiz as Quiz;
    ViewData["Title"] = $"{T["quiz.history_title"]} - {quiz?.Title}";
}


<h2 class="fw-bold text-bocconi mb-4"><i class="bi bi-list-ul me-2"></i>@T["quiz.history_heading"]: @quiz?.Title</h2>

@if (Model.Any())
{
    <div class="card">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">@T["quiz.col_score"]</th>
                        <th scope="col">@T["quiz.col_correct_answers"]</th>
                        <th scope="col">@T["quiz.col_result"]</th>
                        <th scope="col">@T["quiz.col_date"]</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @{ int n = Model.Count; }
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>@(n--)</td>
                            <td><strong>@a.Score%</strong></td>
                            <td>@a.CorrectAnswers / @a.TotalQuestions</td>
                            <td>
                                @if (a.Passed)
                                {
                                    <span class="badge bg-success">@T["quiz.passed"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@T["quiz.failed"]</span>
                                }
                            </td>
                            <td class="text-muted small">@a.AttemptedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><a asp-action="Take" asp-route-id="@a.QuizId" class="btn btn-sm btn-outline-secondary">@T["quiz.retry_btn"]</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>@T["quiz.no_attempts"]</div>
}
