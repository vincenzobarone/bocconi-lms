@model List<QuizAttempt>
@{
    var quiz = ViewBag.Quiz as Quiz;
    ViewData["Title"] = $"{T["quiz.history_title","History"]} - {quiz?.Title}";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Lesson" asp-action="Details" asp-route-id="@quiz?.LessonId">@T["common.lesson","Lesson"]</a></li>
        <li class="breadcrumb-item active">@T["quiz.history_title","Quiz history"]</li>
    </ol>
</nav>

<h2 class="fw-bold text-bocconi mb-4"><i class="bi bi-list-ul me-2"></i>@T["quiz.history_heading","History"]: @quiz?.Title</h2>

@if (Model.Any())
{
    <div class="card">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">@T["quiz.col_score","Score"]</th>
                        <th scope="col">@T["quiz.col_correct_answers","Correct answers"]</th>
                        <th scope="col">@T["quiz.col_result","Result"]</th>
                        <th scope="col">@T["quiz.col_date","Date"]</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @{ int n = Model.Count; }
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>@(n--)</td>
                            <td><strong>@a.Score%</strong></td>
                            <td>@a.CorrectAnswers / @a.TotalQuestions</td>
                            <td>
                                @if (a.Passed)
                                {
                                    <span class="badge bg-success">@T["quiz.passed","Passed"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@T["quiz.failed","Failed"]</span>
                                }
                            </td>
                            <td class="text-muted small">@a.AttemptedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><a asp-action="Take" asp-route-id="@a.QuizId" class="btn btn-sm btn-outline-secondary">@T["quiz.retry_btn","Retry"]</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>@T["quiz.no_attempts","No attempts made yet."]</div>
}
