@model QuizAttempt
@{
    ViewData["Title"] = "Risultato quiz";
}

<div class="row justify-content-center">
    <div class="col-md-6 text-center">
        <div class="card shadow">
            <div class="card-body p-5">
                @if (Model.Passed)
                {
                    <i class="bi bi-trophy-fill display-1 text-warning mb-3 d-block"></i>
                    <h2 class="fw-bold text-success">Quiz superato!</h2>
                }
                else
                {
                    <i class="bi bi-x-circle-fill display-1 text-danger mb-3 d-block"></i>
                    <h2 class="fw-bold text-danger">Quiz non superato</h2>
                }

                <div class="display-4 fw-bold @(Model.Passed ? "text-success" : "text-danger") my-3">
                    @Model.Score%
                </div>

                <p class="text-muted mb-4">
                    Risposte corrette: <strong>@Model.CorrectAnswers / @Model.TotalQuestions</strong><br/>
                    Punteggio minimo: @Model.PassingScore%
                </p>

                <div class="progress mb-4" style="height:16px;">
                    <div class="progress-bar @(Model.Passed ? "bg-success" : "bg-danger")"
                         style="width:@Model.Score%;"></div>
                </div>

                <div class="d-flex gap-3 justify-content-center">
                    <a asp-action="Take" asp-route-id="@Model.QuizId" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-repeat me-1"></i>Ritenta
                    </a>
                    <a asp-action="History" asp-route-quizId="@Model.QuizId" class="btn btn-bocconi">
                        <i class="bi bi-list-ul me-1"></i>Storico tentativi
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
