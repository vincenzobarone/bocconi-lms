@model QuizFormViewModel
@{
    ViewData["Title"] = "Crea quiz";
}

<div class="row">
    <div class="col-lg-10 mx-auto">
        <h2 class="fw-bold text-bocconi mb-1"><i class="bi bi-clipboard2-plus me-2"></i>Crea quiz</h2>
        <p class="text-muted mb-4"><i class="bi bi-book me-1"></i>@ViewBag.LessonTitle</p>

        <form asp-action="Create" method="post" id="quizForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="LessonId" />

            <div class="card mb-4">
                <div class="card-header fw-semibold">Impostazioni quiz</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Titolo *</label>
                        <input asp-for="Title" class="form-control" placeholder="Es: Verifica lezione 1" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Descrizione</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="TimeLimitMinutes" class="form-label fw-semibold">Tempo limite (minuti)</label>
                            <input asp-for="TimeLimitMinutes" type="number" class="form-control" min="5" max="180" />
                            <span asp-validation-for="TimeLimitMinutes" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PassingScore" class="form-label fw-semibold">Punteggio sufficienza (%)</label>
                            <input asp-for="PassingScore" type="number" class="form-control" min="1" max="100" />
                            <span asp-validation-for="PassingScore" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div id="questionsContainer"></div>

            <button type="button" class="btn btn-outline-secondary mb-4" onclick="addQuestion()">
                <i class="bi bi-plus-circle me-1"></i>Aggiungi domanda
            </button>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-bocconi px-4">
                    <i class="bi bi-check-lg me-2"></i>Salva quiz
                </button>
                <a asp-controller="Lesson" asp-action="Details" asp-route-id="@Model.LessonId"
                   class="btn btn-outline-secondary">Annulla</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
var qCount = 0;

function addQuestion() {
    var idx = qCount;
    qCount++;
    // Each question gets its own radio group name: correctOpt with index in form array
    // correctOpt[idx] = 1..4 (which option is correct for this question)
    var groupName = 'correctOpt';
    var html = '<div class="card mb-3" id="qcard-' + idx + '" data-qidx="' + idx + '">' +
        '<div class="card-header d-flex justify-content-between align-items-center">' +
        '<span class="fw-semibold">Domanda ' + (idx + 1) + '</span>' +
        '<button type="button" class="btn btn-sm btn-outline-danger" onclick="removeQuestion(' + idx + ')"><i class="bi bi-trash"></i></button>' +
        '</div><div class="card-body">' +
        '<div class="mb-3"><label class="form-label fw-semibold">Testo domanda *</label>' +
        '<input type="text" name="questionTexts" class="form-control" placeholder="Inserisci la domanda..." required /></div>' +
        '<div class="mb-2 fw-semibold small text-muted">Opzioni <span class="text-danger">(seleziona il cerchio della risposta corretta)</span></div>' +
        [1,2,3,4].map(function(i) {
            return '<div class="input-group mb-2">' +
                '<div class="input-group-text">' +
                '<input type="radio" class="qradio" data-qidx="' + idx + '" value="' + i + '"' +
                (i === 1 ? ' checked' : '') + ' />' +
                '</div>' +
                '<input type="text" name="opt' + i + '" class="form-control" placeholder="Opzione ' + i + '" required />' +
                '</div>';
        }).join('') +
        '</div></div>';
    document.getElementById('questionsContainer').insertAdjacentHTML('beforeend', html);
    reindexAll();
}

function removeQuestion(idx) {
    var card = document.getElementById('qcard-' + idx);
    if (card) card.remove();
    reindexAll();
}

function reindexAll() {
    // Assign unique name per question position so only one radio per question can be selected
    var cards = document.querySelectorAll('#questionsContainer .card[data-qidx]');
    cards.forEach(function(card, pos) {
        var radios = card.querySelectorAll('.qradio');
        radios.forEach(function(r) {
            r.name = 'correctOpt_q' + pos;
        });
        // Hidden field to carry the selected value as correctOpt for the server
        var hidden = card.querySelector('.correctOpt-hidden');
        if (!hidden) {
            hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = 'correctOpt';
            hidden.className = 'correctOpt-hidden';
            card.querySelector('.card-body').appendChild(hidden);
        }
        // Set current value from checked radio
        var checked = card.querySelector('.qradio:checked');
        hidden.value = checked ? checked.value : '1';
        // Update hidden on radio change
        radios.forEach(function(r) {
            r.onchange = function() {
                hidden.value = r.value;
            };
        });
    });
}

document.getElementById('quizForm').addEventListener('submit', function(e) {
    var cards = document.querySelectorAll('#questionsContainer .card[data-qidx]');
    if (cards.length === 0) {
        e.preventDefault();
        alert('Aggiungi almeno una domanda al quiz.');
        return;
    }
    reindexAll();
});

addQuestion();
</script>
}
