@model QuizFormViewModel
@{
    ViewData["Title"] = T["quiz.create_title","Create quiz"];
}

<div class="row">
    <div class="col-lg-10 mx-auto">
        <h2 class="fw-bold text-bocconi mb-1"><i class="bi bi-clipboard2-plus me-2"></i>@T["quiz.create_title","Create quiz"]</h2>
        <p class="text-muted mb-4"><i class="bi bi-book me-1"></i>@ViewBag.LessonTitle</p>

        <form asp-action="Create" method="post" id="quizForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="LessonId" />

            <div class="card mb-4">
                <div class="card-header fw-semibold">@T["quiz.form.settings","Quiz settings"]</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">@T["quiz.form.title","Title"] *</label>
                        <input asp-for="Title" class="form-control" placeholder="@T["quiz.form.title_placeholder","e.g. Lesson 1 test"]" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">@T["quiz.form.description","Description"]</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="TimeLimitMinutes" class="form-label fw-semibold">@T["quiz.form.time_limit","Time limit (minutes)"]</label>
                            <input asp-for="TimeLimitMinutes" type="number" class="form-control" min="5" max="180" />
                            <span asp-validation-for="TimeLimitMinutes" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PassingScore" class="form-label fw-semibold">@T["quiz.form.passing_score","Passing score (%)"]</label>
                            <input asp-for="PassingScore" type="number" class="form-control" min="1" max="100" />
                            <span asp-validation-for="PassingScore" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div id="questionsContainer"></div>

            <button type="button" class="btn btn-outline-secondary mb-4" onclick="addQuestion()">
                <i class="bi bi-plus-circle me-1"></i>@T["quiz.add_question_btn","Add question"]
            </button>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-bocconi px-4">
                    <i class="bi bi-check-lg me-2"></i>@T["quiz.save_btn","Save quiz"]
                </button>
                <a asp-controller="Lesson" asp-action="Details" asp-route-id="@Model.LessonId"
                   class="btn btn-outline-secondary">@T["common.cancel","Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
var qCount = 0;
var lblQuestion = @Json.Serialize(T["quiz.js.question","Question"]);
var lblQuestionText = @Json.Serialize(T["quiz.js.question_text","Question text"] + " *");
var lblQuestionPlaceholder = @Json.Serialize(T["quiz.js.question_placeholder","Enter the question..."]);
var lblOptions = @Json.Serialize(T["quiz.js.options","Options"]);
var lblOptionsHint = @Json.Serialize(T["quiz.js.options_hint","(select the circle of the correct answer)"]);
var lblOptionPlaceholder = @Json.Serialize(T["quiz.js.option_placeholder","Option"]);
var lblAtLeastOne = @Json.Serialize(T["quiz.js.at_least_one","Please add at least one question to the quiz."]);
var lblRemoveQuestion = @Json.Serialize(T["quiz.js.remove_question","Rimuovi domanda"]);

function addQuestion() {
    var idx = qCount;
    qCount++;
    var html = '<div class="card mb-3" id="qcard-' + idx + '" data-qidx="' + idx + '">' +
        '<div class="card-header d-flex justify-content-between align-items-center">' +
        '<span class="fw-semibold">' + lblQuestion + ' ' + (idx + 1) + '</span>' +
        '<button type="button" class="btn btn-sm btn-outline-danger" onclick="removeQuestion(' + idx + ')" aria-label="' + lblRemoveQuestion + '"><i class="bi bi-trash"></i></button>' +
        '</div><div class="card-body">' +
        '<div class="mb-3"><label class="form-label fw-semibold">' + lblQuestionText + '</label>' +
        '<input type="text" name="questionTexts" class="form-control" placeholder="' + lblQuestionPlaceholder + '" required /></div>' +
        '<div class="mb-2 fw-semibold small text-muted">' + lblOptions + ' <span class="text-danger">(' + lblOptionsHint + ')</span></div>' +
        [1,2,3,4].map(function(i) {
            return '<div class="input-group mb-2">' +
                '<div class="input-group-text">' +
                '<input type="radio" class="qradio" data-qidx="' + idx + '" value="' + i + '"' +
                (i === 1 ? ' checked' : '') + ' />' +
                '</div>' +
                '<input type="text" name="opt' + i + '" class="form-control" placeholder="' + lblOptionPlaceholder + ' ' + i + '" required />' +
                '</div>';
        }).join('') +
        '</div></div>';
    document.getElementById('questionsContainer').insertAdjacentHTML('beforeend', html);
    reindexAll();
}

function removeQuestion(idx) {
    var card = document.getElementById('qcard-' + idx);
    if (card) card.remove();
    reindexAll();
}

function reindexAll() {
    var cards = document.querySelectorAll('#questionsContainer .card[data-qidx]');
    cards.forEach(function(card, pos) {
        var radios = card.querySelectorAll('.qradio');
        radios.forEach(function(r) {
            r.name = 'correctOpt_q' + pos;
        });
        var hidden = card.querySelector('.correctOpt-hidden');
        if (!hidden) {
            hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = 'correctOpt';
            hidden.className = 'correctOpt-hidden';
            card.querySelector('.card-body').appendChild(hidden);
        }
        var checked = card.querySelector('.qradio:checked');
        hidden.value = checked ? checked.value : '1';
        radios.forEach(function(r) {
            r.onchange = function() { hidden.value = r.value; };
        });
    });
}

document.getElementById('quizForm').addEventListener('submit', function(e) {
    var cards = document.querySelectorAll('#questionsContainer .card[data-qidx]');
    if (cards.length === 0) {
        e.preventDefault();
        alert(lblAtLeastOne);
        return;
    }
    reindexAll();
});

addQuestion();
</script>
}
