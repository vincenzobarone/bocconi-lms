@model Lesson
@{
    ViewData["Title"] = Model.Title;
    var quizzes = ViewBag.Quizzes as List<Quiz> ?? new();
    var isOwner = (bool)(ViewBag.IsOwner ?? false);
    var linkedMaterials = ViewBag.LinkedMaterials as List<BocconiLMS.Models.Material> ?? new();
    var availableMaterials = ViewBag.AvailableMaterials as List<BocconiLMS.Models.Material> ?? new();
    var missingFileIds = ViewBag.MissingFileIds as HashSet<int> ?? new HashSet<int>();
}

<div class="mb-2">
    <a asp-controller="Course" asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>@Model.CourseTitle
    </a>
</div>


<div class="row">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <h2 class="fw-bold">@Model.Title</h2>
            @if (isOwner)
            {
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-pencil me-1"></i>@T["common.edit"]
                    </a>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                data-confirm="@T["lesson.confirm_delete"]"
                                title="@T["common.delete"]">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Content))
        {
            <div class="card mb-4">
                <div class="card-body">
                    <div class="lesson-content" style="white-space: pre-wrap;">@Model.Content</div>
                </div>
            </div>
        }

        @* ── MATERIALI LIBRERIA ───────────────────────────────────── *@
        @if (linkedMaterials.Any() || isOwner)
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-semibold mb-0">
                    <i class="bi bi-collection me-2"></i>Materiali
                </h4>
                @if (isOwner)
                {
                    <button type="button" class="btn btn-sm btn-bocconi" data-bs-toggle="modal" data-bs-target="#addMaterialModal">
                        <i class="bi bi-link-45deg me-1"></i>Aggiungi dalla libreria
                    </button>
                }
            </div>

            @if (linkedMaterials.Any())
            {
                <div class="list-group mb-4">
                    @foreach (var m in linkedMaterials)
                    {
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    @if (m.ActiveVersion?.IsVideo == true)
                                    {
                                        <i class="bi bi-play-circle-fill text-bocconi fs-5"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-file-earmark-text text-bocconi fs-5"></i>
                                    }
                                    <div>
                                        <strong>@m.Title</strong>
                                        @if (m.CurrentVersion > 0)
                                        {
                                            <span class="version-badge ms-2">v@(m.CurrentVersion)</span>
                                        }
                                        @if (m.ActiveVersion != null)
                                        {
                                            <span class="badge bg-secondary ms-1" style="font-size:.7rem;">@m.ActiveVersion.FileType.ToUpper()</span>
                                        }
                                        <div class="text-muted" style="font-size:.75rem;">
                                            @m.Language
                                            @if (!string.IsNullOrEmpty(m.DocumentTypeName))
                                            {
                                                <span class="ms-2">· @m.DocumentTypeName</span>
                                            }
                                            @if (!string.IsNullOrEmpty(m.OwnerName))
                                            {
                                                <span class="ms-2">· @m.OwnerName</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    @if (m.ActiveVersion != null && !m.ActiveVersion.IsVideo)
                                    {
                                        @if (missingFileIds.Contains(m.Id))
                                        {
                                            <span class="btn btn-sm btn-secondary disabled"
                                                  title="File non disponibile sul server — ricarica il documento dalla libreria materiali"
                                                  aria-disabled="true">
                                                <i class="bi bi-download"></i>
                                            </span>
                                        }
                                        else
                                        {
                                            <a asp-controller="Materials" asp-action="Download"
                                               asp-route-versionId="@m.ActiveVersion.Id"
                                               class="btn btn-sm btn-bocconi"
                                               aria-label="@T["mat.download_aria"]"><i class="bi bi-download"></i></a>
                                        }
                                    }
                                    @if (isOwner)
                                    {
                                        <form asp-controller="Materials" asp-action="UnlinkFromLesson" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="lessonId" value="@Model.Id" />
                                            <input type="hidden" name="materialId" value="@m.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning"
                                                    data-confirm="Rimuovere «@m.Title» da questa lezione?"
                                                    title="@T["mat.unlink_aria"]"
                                                    aria-label="@T["mat.unlink_aria"]">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (isOwner)
            {
                <p class="text-muted small mb-4">Nessun materiale collegato a questa lezione. Usa il pulsante per aggiungere dalla libreria.</p>
            }
        }

        @* ── QUIZ ─────────────────────────────────────────────────── *@
        @if (quizzes.Any() || isOwner)
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-semibold mb-0">
                    <i class="bi bi-clipboard2-check me-2"></i>Quiz
                </h4>
                @if (isOwner)
                {
                    <a asp-controller="Quiz" asp-action="Create" asp-route-lessonId="@Model.Id"
                       class="btn btn-sm btn-bocconi">
                        <i class="bi bi-plus-lg me-1"></i>@T["quiz.create"]
                    </a>
                }
            </div>
            @foreach (var q in quizzes)
            {
                <div class="card mb-2">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@q.Title</strong>
                            <div class="text-muted small">
                                <i class="bi bi-clock me-1"></i>@q.TimeLimitMinutes @T["quiz.minutes"]
                                <span class="ms-3"><i class="bi bi-award me-1"></i>@T["quiz.passing_score"]: @q.PassingScore%</span>
                                @if (!string.IsNullOrEmpty(q.CreatedByName))
                                {
                                    <span class="ms-3"><i class="bi bi-person-plus me-1"></i>@T["quiz.created_by"] @q.CreatedByName</span>
                                }
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-controller="Quiz" asp-action="Take" asp-route-id="@q.Id"
                               class="btn btn-sm btn-bocconi">
                                <i class="bi bi-play-circle me-1"></i>@T["quiz.take"]
                            </a>
                            <a asp-controller="Quiz" asp-action="History" asp-route-quizId="@q.Id"
                               class="btn btn-sm btn-outline-secondary">@T["quiz.history"]</a>
                            @if (isOwner)
                            {
                                <form asp-controller="Quiz" asp-action="Delete" asp-route-id="@q.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            data-confirm="@T["quiz.confirm_delete"]"
                                            title="@T["common.delete"]">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                @if (Model.IsCompleted)
                {
                    <div class="text-center text-success mb-3">
                        <i class="bi bi-check-circle-fill display-5"></i>
                        <p class="fw-semibold mt-2">@T["lesson.completed"]</p>
                    </div>
                }
                <div class="text-muted small">
                    <div class="mb-2"><i class="bi bi-book me-2"></i>@Model.CourseTitle</div>
                    <div class="mb-2"><i class="bi bi-sort-numeric-up me-2"></i>@T["lesson.sort_order"]: @Model.SortOrder</div>
                    <div><i class="bi bi-calendar me-2"></i>@Model.CreatedAt.ToString("dd/MM/yyyy")</div>
                </div>
                <hr />
                <a asp-controller="Course" asp-action="Details" asp-route-id="@Model.CourseId"
                   class="btn btn-outline-secondary w-100">
                    <i class="bi bi-arrow-left me-2"></i>@T["common.back_to_course"]
                </a>
            </div>
        </div>
    </div>
</div>

@* ── Modal: aggiungi materiale dalla libreria ────────────────── *@
@if (isOwner)
{
<div class="modal fade" id="addMaterialModal" tabindex="-1" aria-labelledby="addMaterialModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addMaterialModalLabel">
                    <i class="bi bi-collection me-2"></i>Aggiungi materiale dalla libreria
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (!availableMaterials.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-collection display-4 d-block mb-3"></i>
                        <p>Tutti i materiali della libreria sono già collegati a questa lezione,<br/>oppure la libreria è vuota.</p>
                        <a asp-controller="Materials" asp-action="Create" class="btn btn-bocconi btn-sm">
                            <i class="bi bi-plus-lg me-1"></i>Crea nuovo materiale
                        </a>
                    </div>
                }
                else
                {
                    <div class="mb-2">
                        <input type="text" id="materialSearch" class="form-control form-control-sm" placeholder="Cerca per titolo…" />
                    </div>
                    <div class="list-group" id="materialList" style="max-height:380px; overflow-y:auto;">
                        @foreach (var m in availableMaterials)
                        {
                            <div class="list-group-item material-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold">@m.Title</div>
                                        <div class="text-muted" style="font-size:.75rem;">
                                            @m.Language
                                            @if (!string.IsNullOrEmpty(m.DocumentTypeName))
                                            {<span class="ms-2">· @m.DocumentTypeName</span>}
                                            @if (!string.IsNullOrEmpty(m.OwnerName))
                                            {<span class="ms-2">· @m.OwnerName</span>}
                                            @if (m.CurrentVersion > 0)
                                            {<span class="ms-2 version-badge">v@(m.CurrentVersion)</span>}
                                        </div>
                                    </div>
                                    <form asp-controller="Materials" asp-action="LinkToLesson" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="lessonId" value="@Model.Id" />
                                        <input type="hidden" name="materialId" value="@m.Id" />
                                        <button type="submit" class="btn btn-sm btn-bocconi">
                                            <i class="bi bi-link-45deg me-1"></i>Aggiungi
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <a asp-controller="Materials" asp-action="Index" class="btn btn-outline-secondary btn-sm" target="_blank">
                    <i class="bi bi-box-arrow-up-right me-1"></i>Vai alla libreria
                </a>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Chiudi</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function() {
    var input = document.getElementById('materialSearch');
    if (!input) return;
    input.addEventListener('input', function() {
        var q = this.value.toLowerCase();
        document.querySelectorAll('.material-item').forEach(function(el) {
            el.style.display = el.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
    });
})();
</script>
}
}
