@model LessonFormViewModel
<div class="mb-3">
    <label asp-for="Title" class="form-label fw-semibold">@T["lesson.form.title","Title"] *</label>
    <input asp-for="Title" class="form-control" placeholder="@T["lesson.form.title_placeholder","e.g. Introduction to Economics"]" />
    <span asp-validation-for="Title" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="Content" class="form-label fw-semibold">@T["lesson.form.content","Content"]</label>
    <textarea asp-for="Content" class="form-control" rows="8" placeholder="@T["lesson.form.content_placeholder","Description, notes, lesson text..."]"></textarea>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="SortOrder" class="form-label fw-semibold">@T["lesson.form.sort_order","Order"]</label>
        <input asp-for="SortOrder" type="number" class="form-control" min="0" />
    </div>
</div>
<div class="form-check">
    <input asp-for="IsPublished" class="form-check-input" type="checkbox" />
    <label asp-for="IsPublished" class="form-check-label">@T["lesson.form.publish","Publish lesson (visible to students)"]</label>
</div>
