@model LessonFormViewModel
<div class="mb-3">
    <label asp-for="Title" class="form-label fw-semibold">Titolo *</label>
    <input asp-for="Title" class="form-control" placeholder="Es: Introduzione all'economia" />
    <span asp-validation-for="Title" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="Content" class="form-label fw-semibold">Contenuto</label>
    <textarea asp-for="Content" class="form-control" rows="8" placeholder="Descrizione, note, testo della lezione..."></textarea>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="SortOrder" class="form-label fw-semibold">Ordine</label>
        <input asp-for="SortOrder" type="number" class="form-control" min="0" />
    </div>
</div>
<div class="form-check">
    <input asp-for="IsPublished" class="form-check-input" type="checkbox" />
    <label asp-for="IsPublished" class="form-check-label">Pubblica lezione (visibile agli studenti)</label>
</div>
