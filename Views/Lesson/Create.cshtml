@model LessonFormViewModel
@{
    ViewData["Title"] = "Nuova lezione";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <h2 class="fw-bold text-bocconi mb-4"><i class="bi bi-plus-circle me-2"></i>Crea nuova lezione</h2>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <p class="text-muted small mb-3"><i class="bi bi-book me-1"></i>Corso: <strong>@ViewBag.CourseTitle</strong></p>
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CourseId" />
                    @await Html.PartialAsync("_LessonForm", Model)
                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-bocconi px-4">Crea lezione</button>
                        <a asp-controller="Course" asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary">Annulla</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
