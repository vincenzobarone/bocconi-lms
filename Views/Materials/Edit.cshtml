@model MaterialFormViewModel
@{
    ViewData["Title"] = T["mat.edit_title","Edit material"];
    var material = ViewBag.Material as BocconiLMS.Models.Material;
    var docTypes = ViewBag.DocumentTypes as List<BocconiLMS.Models.DocumentType> ?? new();
    var languages = ViewBag.Languages as string[] ?? BocconiLMS.Models.Material.Languages;
    var owners = ViewBag.AvailableOwners as List<BocconiLMS.Models.User> ?? new();
    var existingAuthors = ViewBag.ExistingAuthors as List<string> ?? new();
    var availableAreas = ViewBag.AvailableAreas as List<BocconiLMS.Models.Area> ?? new();
    var existingFolders = ViewBag.ExistingFolders as List<BocconiLMS.Models.MaterialFolder> ?? new();
    bool canSetStatus = ViewBag.CanSetStatus == true;

    bool hasProtocol = material?.ProtocolNumber != null;
    bool hasFolder   = material?.FolderId != null;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">@T["mat.nav","Materials"]</a></li>
        @if (material != null)
        {
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@material.Id">@material.Title</a></li>
        }
        <li class="breadcrumb-item active">@T["mat.edit_breadcrumb","Edit"]</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-bocconi text-white">
                <h5 class="mb-0"><i class="bi bi-pencil me-2"></i>@T["mat.edit_title","Edit material"]</h5>
            </div>
            <div class="card-body">
                <form id="matForm" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data"
                      data-has-protocol="@hasProtocol.ToString().ToLower()"
                      data-has-folder="@hasFolder.ToString().ToLower()">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OwnerId" />
                    <input type="hidden" asp-for="FolderId" id="hidFolderId" />
                    <input type="hidden" asp-for="FolderName" id="hidFolderName" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" id="valSummary"></div>

                    <div class="row mb-3 g-2 align-items-start">
                        <div class="col-md-4">
                            <label asp-for="AuthorName" class="form-label fw-semibold">
                                @T["mat.label_author","Autore"] <span class="text-danger">*</span>
                            </label>
                            <input asp-for="AuthorName" class="form-control"
                                   list="authorsList"
                                   placeholder="@T["mat.author_placeholder","Nome autore"]"
                                   autocomplete="off" />
                            <datalist id="authorsList">
                                @foreach (var a in existingAuthors)
                                {
                                    <option value="@a"></option>
                                }
                            </datalist>
                            <span asp-validation-for="AuthorName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Title" class="form-label fw-semibold">
                                @T["mat.label_title","Titolo"] <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Title" id="matTitle" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3 g-2 align-items-start">
                        <div class="col-md-8">
                            <label asp-for="DocumentTypeId" class="form-label fw-semibold">
                                @T["mat.label_doctype","Document type"] <span class="text-danger">*</span>
                            </label>
                            <select asp-for="DocumentTypeId" class="form-select">
                                <option value="">@T["mat.select_type","— Select a type —"]</option>
                                @foreach (var t in docTypes)
                                {
                                    <option value="@t.Id" selected="@(Model.DocumentTypeId == t.Id ? "selected" : null)">@t.Name</option>
                                }
                            </select>
                            <span asp-validation-for="DocumentTypeId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Language" class="form-label fw-semibold">
                                @T["mat.label_language","Language"] <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Language" id="langSelect" class="form-select">
                                @foreach (var l in languages)
                                {
                                    <option value="@l" selected="@(Model.Language == l ? "selected" : null)">@l</option>
                                }
                            </select>
                            <span asp-validation-for="Language" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-semibold">@T["mat.label_status","Status"]</label>
                        @if (canSetStatus)
                        {
                            <select asp-for="Status" id="statusSelect" class="form-select">
                                <option value="bozza"        selected="@(Model.Status=="bozza"?"selected":null)">@T["mat.status_bozza","Draft"]</option>
                                <option value="in_revisione" selected="@(Model.Status=="in_revisione"?"selected":null)">@T["mat.status_in_revisione","In review"]</option>
                                <option value="verificato"   selected="@(Model.Status=="verificato"?"selected":null)">@T["mat.status_verificato","Verified"]</option>
                            </select>
                        }
                        else
                        {
                            var statusLabel = Model.Status switch {
                                "verificato"   => T["mat.status_verificato","Verified"],
                                "in_revisione" => T["mat.status_in_revisione","In review"],
                                _              => T["mat.status_bozza","Draft"]
                            };
                            @* Mantieni lo stato corrente, non modificabile *@
                            <input type="hidden" id="statusSelect" name="Status" value="@Model.Status" />
                            <input type="text" class="form-control bg-light" readonly value="@statusLabel" />
                            <div class="form-text">
                                <i class="bi bi-lock me-1"></i>@T["mat.status_locked_edit","Lo stato non è modificabile con il tuo ruolo."]
                            </div>
                        }
                    </div>

                    @* Show current protocol/folder info if already set (read-only) *@
                    @if (hasProtocol || hasFolder)
                    {
                        <div class="card border-success mb-3">
                            <div class="card-header bg-success bg-opacity-10 text-success fw-semibold py-2">
                                <i class="bi bi-shield-check me-1"></i>@T["mat.verified_fields","Dati verifica"]
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    @if (hasProtocol)
                                    {
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">@T["mat.protocol_number","Numero di protocollo"]</label>
                                            <input type="text" class="form-control" readonly value="@material!.ProtocolNumber" />
                                        </div>
                                    }
                                    @if (hasFolder)
                                    {
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">@T["mat.label_folder","Cartella"]</label>
                                            <input type="text" class="form-control" readonly value="@material!.FolderName" />
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (availableAreas.Any())
                    {
                        <div class="row mb-3 g-2">
                            <div class="col-md-6">
                                <label asp-for="AreaId" class="form-label fw-semibold">@T["mat.label_area","Area"]</label>
                                <select asp-for="AreaId" class="form-select">
                                    <option value="">@T["mat.select_area","— Nessuna area —"]</option>
                                    @foreach (var ar in availableAreas)
                                    {
                                        <option value="@ar.Id" selected="@(Model.AreaId == ar.Id ? "selected" : null)">@ar.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CatalogationDate" class="form-label fw-semibold">@T["mat.label_cat_date","Data catalogazione"]</label>
                                <input asp-for="CatalogationDate" type="date" class="form-control"
                                       value="@(Model.CatalogationDate.HasValue ? Model.CatalogationDate.Value.ToString("yyyy-MM-dd") : "")" />
                            </div>
                        </div>
                    }

                    <hr />
                    <h6 class="text-muted mb-3">
                        <i class="bi bi-upload me-1"></i>@T["mat.upload_new_section","Upload new version file (optional)"]
                    </h6>
                    @if (material?.ActiveVersion != null)
                    {
                        <div class="alert alert-info py-2 mb-3">
                            <i class="bi bi-info-circle me-1"></i>
                            @T["mat.active_version_label","Active version:"]
                            <strong>v@(material.CurrentVersion)</strong> — @material.ActiveVersion.FileName
                            (@material.ActiveVersion.FileSizeFormatted)
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">@T["mat.new_file","New file"]</label>
                        <div class="input-group">
                            <label for="File" class="btn btn-outline-secondary mb-0">
                                <i class="bi bi-folder2-open me-1"></i>@T["mat.choose_file","Choose file"]
                            </label>
                            <span class="form-control text-muted"
                                  id="fileName_File"
                                  data-placeholder="@T["mat.no_file_chosen","No file chosen"]">@T["mat.no_file_chosen","No file chosen"]</span>
                            <input asp-for="File" type="file" class="d-none" id="File"
                                   onchange="matFileChanged(this)" />
                        </div>
                        <div class="form-text">@T["mat.file_hint","Leave empty to not update the file."]</div>
                    </div>

                    <div id="convertPdfBox" class="alert alert-warning d-none py-2 mb-3">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="ConvertToPdf" name="ConvertToPdf" value="true" />
                            <label class="form-check-label fw-semibold" for="ConvertToPdf">
                                <i class="bi bi-file-earmark-pdf me-1"></i>@T["mat.convert_to_pdf","Convert to PDF before saving"]
                            </label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label fw-semibold">@T["mat.new_version_notes","New version notes"]</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"
                                  placeholder="@T["mat.version_notes_placeholder","What changes in this version?"]"></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x me-1"></i>@T["mat.cancel","Cancel"]
                        </a>
                        <button type="button" id="submitBtn" class="btn btn-bocconi">
                            <i class="bi bi-check-lg me-1"></i>@T["mat.save_btn","Save changes"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@* ── Verified-fields modal ──────────────────────────────────────────────── *@
<div class="modal fade" id="verifiedModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success bg-opacity-10 border-success">
                <h5 class="modal-title text-success">
                    <i class="bi bi-shield-check me-2"></i>@T["mat.verified_modal_title","Verifica completata"]
                </h5>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">@T["mat.verified_modal_hint","Completa i dati di registrazione prima di salvare come Verificato."]</p>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-hash me-1"></i>@T["mat.protocol_number","Numero di protocollo"]
                    </label>
                    <input type="text" id="modalProtocol" class="form-control" readonly
                           placeholder="…" />
                    <div class="form-text">@T["mat.protocol_auto","Assegnato automaticamente — sola lettura"]</div>
                </div>

                <div class="mb-2">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-folder2 me-1"></i>@T["mat.label_folder","Cartella"] <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="modalFolderInput" list="folderDatalist"
                           class="form-control"
                           placeholder="@T["mat.folder_placeholder","Digita o seleziona una cartella…"]"
                           autocomplete="off" />
                    <datalist id="folderDatalist"></datalist>
                    <div class="form-text">@T["mat.folder_hint","Raggruppamento logico del documento. Inizia con il prefisso della lingua (es. IT, EN)."]</div>
                    <div id="folderError" class="text-danger small d-none">@T["mat.folder_required","Inserisci il nome della cartella."]</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" id="modalCancelBtn">
                    @T["common.cancel","Cancel"]
                </button>
                <button type="button" class="btn btn-success" id="modalConfirmBtn">
                    <i class="bi bi-check-lg me-1"></i>@T["mat.modal_confirm","Conferma e salva"]
                </button>
            </div>
        </div>
    </div>
</div>

<div id="folderMap" data-folders="@System.Text.Json.JsonSerializer.Serialize(existingFolders.Select(f => new { f.Id, f.Name }))"></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
    <script>
        (function () {
            var summary = document.getElementById('valSummary');
            if (summary && summary.querySelectorAll('li').length > 0)
                summary.classList.remove('d-none');
        })();

        var OFFICE_EXTS = ['doc','docx','ppt','pptx'];
        var ZIP_EXTS    = ['docx','pptx','xlsx'];

        var LANG_PREFIX = {
            'Italiano':'IT','Inglese':'EN','Francese':'FR','Tedesco':'DE',
            'Spagnolo':'ES','Russo':'RU','Cinese':'ZH','Arabo':'AR',
            'Portoghese':'PT','Altro':'XX'
        };

        // ── Verified modal logic ───────────────────────────────────────────
        var verifiedModal = new bootstrap.Modal(document.getElementById('verifiedModal'));
        var folderMap = [];
        try { folderMap = JSON.parse(document.getElementById('folderMap').dataset.folders); } catch(e){}

        var form = document.getElementById('matForm');
        var hasProtocol = form.dataset.hasProtocol === 'true';
        var hasFolder   = form.dataset.hasFolder === 'true';

        function langPrefix() {
            var lang = document.getElementById('langSelect').value;
            return LANG_PREFIX[lang] || 'XX';
        }

        function needsModal() {
            if (document.getElementById('statusSelect').value !== 'verificato') return false;
            return !hasProtocol || !hasFolder;
        }

        async function openVerifiedModal() {
            // Load next protocol
            try {
                var resp = await fetch('@Url.Action("NextProtocol","Materials")', {headers:{'X-Requested-With':'XMLHttpRequest'}});
                var data = await resp.json();
                document.getElementById('modalProtocol').value = data.protocol;
            } catch(e) { document.getElementById('modalProtocol').value = '—'; }

            // Populate datalist with existing folders
            var dl = document.getElementById('folderDatalist');
            dl.innerHTML = '';
            folderMap.forEach(function(f) {
                var opt = document.createElement('option');
                opt.value = f.Name;
                opt.dataset.id = f.Id;
                dl.appendChild(opt);
            });

            // Pre-fill folder input with language prefix if not already set
            var inp = document.getElementById('modalFolderInput');
            var prefix = langPrefix() + ' - ';
            if (!inp.value || inp.value === inp.dataset.lastPrefix) {
                inp.value = prefix;
            }
            inp.dataset.lastPrefix = prefix;

            document.getElementById('folderError').classList.add('d-none');
            verifiedModal.show();
            setTimeout(function() {
                inp.focus();
                inp.setSelectionRange(inp.value.length, inp.value.length);
            }, 300);
        }

        document.getElementById('submitBtn').addEventListener('click', async function() {
            if (!form.reportValidity || !form.reportValidity()) return;

            if (needsModal()) {
                await openVerifiedModal();
            } else {
                form.submit();
            }
        });

        document.getElementById('modalConfirmBtn').addEventListener('click', function() {
            var folderInput = document.getElementById('modalFolderInput');
            var folderValue = folderInput.value.trim();

            if (!folderValue) {
                document.getElementById('folderError').classList.remove('d-none');
                return;
            }

            var matched = folderMap.find(function(f) {
                return f.Name.toLowerCase() === folderValue.toLowerCase();
            });
            if (matched) {
                document.getElementById('hidFolderId').value = matched.Id;
                document.getElementById('hidFolderName').value = '';
            } else {
                document.getElementById('hidFolderId').value = '';
                document.getElementById('hidFolderName').value = folderValue;
            }

            verifiedModal.hide();
            form.submit();
        });

        document.getElementById('modalCancelBtn').addEventListener('click', function() {
            // Revert status to in_revisione
            document.getElementById('statusSelect').value = 'in_revisione';
            verifiedModal.hide();
        });

        // ── File input handling ───────────────────────────────────────────
        function extractOfficeAuthor(file) {
            if (typeof JSZip === 'undefined') return Promise.resolve(null);
            return JSZip.loadAsync(file).then(function (zip) {
                var entry = zip.file('docProps/core.xml');
                if (!entry) return null;
                return entry.async('string').then(function (xml) {
                    var m = xml.match(/<dc:creator[^>]*>([\s\S]*?)<\/dc:creator>/);
                    return (m && m[1].trim()) ? m[1].trim() : null;
                });
            }).catch(function () { return null; });
        }

        function matFileChanged(inp) {
            var span      = document.getElementById('fileName_File');
            var pdfBox    = document.getElementById('convertPdfBox');
            var titleInp  = document.getElementById('matTitle');
            var authorInp = document.getElementById('AuthorName');

            if (!inp.files || inp.files.length === 0) {
                if (span) span.textContent = span.dataset.placeholder || '';
                if (pdfBox) pdfBox.classList.add('d-none');
                return;
            }

            var file = inp.files[0];
            if (span) span.textContent = file.name;

            var ext       = file.name.split('.').pop().toLowerCase();
            var nameNoExt = file.name.replace(/\.[^.]+$/, '');

            if (titleInp && titleInp.value.trim() === '') {
                titleInp.value = nameNoExt;
            }

            if (OFFICE_EXTS.indexOf(ext) !== -1) {
                if (pdfBox) pdfBox.classList.remove('d-none');
            } else {
                if (pdfBox) pdfBox.classList.add('d-none');
                var cb = document.getElementById('ConvertToPdf');
                if (cb) cb.checked = false;
            }

            if (authorInp && authorInp.value.trim() === '' && ZIP_EXTS.indexOf(ext) !== -1) {
                extractOfficeAuthor(file).then(function (author) {
                    if (author && authorInp.value.trim() === '') {
                        authorInp.value = author;
                    }
                });
            }
        }
    </script>
}
