@model MaterialFormViewModel
@{
    ViewData["Title"] = T["mat.edit_title","Edit material"];
    var material = ViewBag.Material as BocconiLMS.Models.Material;
    var docTypes = ViewBag.DocumentTypes as List<BocconiLMS.Models.DocumentType> ?? new();
    var languages = ViewBag.Languages as string[] ?? BocconiLMS.Models.Material.Languages;
    var owners = ViewBag.AvailableOwners as List<BocconiLMS.Models.User> ?? new();
    var existingAuthors = ViewBag.ExistingAuthors as List<string> ?? new();
    var availableAreas = ViewBag.AvailableAreas as List<BocconiLMS.Models.Area> ?? new();
    var existingFolders = ViewBag.ExistingFolders as List<BocconiLMS.Models.MaterialFolder> ?? new();
    bool canSetStatus = ViewBag.CanSetStatus == true;

    bool hasProtocol = material?.ProtocolNumber != null;
    bool hasFolder   = material?.FolderId != null;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">@T["mat.nav","Materials"]</a></li>
        @if (material != null)
        {
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@material.Id">@material.Title</a></li>
        }
        <li class="breadcrumb-item active">@T["mat.edit_breadcrumb","Edit"]</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-bocconi text-white">
                <h5 class="mb-0"><i class="bi bi-pencil me-2"></i>@T["mat.edit_title","Edit material"]</h5>
            </div>
            <div class="card-body">
                <form id="matForm" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data"
                      data-has-protocol="@hasProtocol.ToString().ToLower()"
                      data-has-folder="@hasFolder.ToString().ToLower()">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OwnerId" />
                    <input type="hidden" asp-for="FolderId" id="hidFolderId" />
                    <input type="hidden" asp-for="FolderName" id="hidFolderName" />
                    <input type="hidden" asp-for="PageCount" id="hidPageCount" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" id="valSummary"></div>

                    <div class="row mb-3 g-2 align-items-start">
                        <div class="col-md-4">
                            <label asp-for="AuthorName" class="form-label fw-semibold">
                                @T["mat.label_author","Autore"] <span class="text-danger">*</span>
                            </label>
                            <div class="position-relative">
                                <input asp-for="AuthorName" id="authorInput" class="form-control"
                                       placeholder="@T["mat.author_placeholder","Nome autore"]"
                                       autocomplete="off" />
                                <ul id="authorDropdown"
                                    class="dropdown-menu w-100 shadow-sm py-1"
                                    style="max-height:200px;overflow-y:auto;display:none;position:absolute;z-index:1055"></ul>
                            </div>
                            <span asp-validation-for="AuthorName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Title" class="form-label fw-semibold">
                                @T["mat.label_title","Titolo"] <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Title" id="matTitle" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3 g-2 align-items-start">
                        <div class="col-md-8">
                            <label asp-for="DocumentTypeId" class="form-label fw-semibold">
                                @T["mat.label_doctype","Document type"] <span class="text-danger">*</span>
                            </label>
                            <select asp-for="DocumentTypeId" class="form-select">
                                <option value="">@T["mat.select_type","— Select a type —"]</option>
                                @foreach (var t in docTypes)
                                {
                                    <option value="@t.Id" selected="@(Model.DocumentTypeId == t.Id ? "selected" : null)">@t.Name</option>
                                }
                            </select>
                            <span asp-validation-for="DocumentTypeId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Language" class="form-label fw-semibold">
                                @T["mat.label_language","Language"] <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Language" id="langSelect" class="form-select">
                                @foreach (var l in languages)
                                {
                                    <option value="@l" selected="@(Model.Language == l ? "selected" : null)">@l</option>
                                }
                            </select>
                            <span asp-validation-for="Language" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-semibold">@T["mat.label_status","Status"]</label>
                        @if (canSetStatus)
                        {
                            <select asp-for="Status" id="statusSelect" class="form-select">
                                <option value="bozza"        selected="@(Model.Status=="bozza"?"selected":null)">@T["mat.status_bozza","Draft"]</option>
                                <option value="in_revisione" selected="@(Model.Status=="in_revisione"?"selected":null)">@T["mat.status_in_revisione","In review"]</option>
                                <option value="verificato"   selected="@(Model.Status=="verificato"?"selected":null)">@T["mat.status_verificato","Verified"]</option>
                            </select>
                        }
                        else
                        {
                            @* Utenti senza flag: preserva lo stato attuale del materiale *@
                            <input type="hidden" id="statusSelect" name="Status" value="@Model.Status" />
                            <input type="text" class="form-control bg-light" readonly
                                   value="@(Model.Status == "verificato" ? T["mat.status_verificato","Verified"] : Model.Status == "in_revisione" ? T["mat.status_in_revisione","In review"] : T["mat.status_bozza","Draft"])" />
                            <div class="form-text">
                                <i class="bi bi-lock me-1"></i>@T["mat.status_locked_edit","Lo stato non è modificabile con il tuo ruolo."]
                            </div>
                        }
                    </div>

                    @* Show current protocol/folder info if already set (read-only) *@
                    @if (hasProtocol || hasFolder)
                    {
                        <div class="card border-success mb-3">
                            <div class="card-header bg-success bg-opacity-10 text-success fw-semibold py-2">
                                <i class="bi bi-shield-check me-1"></i>@T["mat.verified_fields","Dati verifica"]
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    @if (hasProtocol)
                                    {
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">@T["mat.protocol_number","Numero di protocollo"]</label>
                                            <input type="text" class="form-control" readonly value="@material!.ProtocolNumber" />
                                        </div>
                                    }
                                    @if (hasFolder)
                                    {
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">@T["mat.label_folder","Cartella"]</label>
                                            <input type="text" class="form-control" readonly value="@material!.FolderName" />
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (availableAreas.Any())
                    {
                        <div class="row mb-3 g-2">
                            <div class="col-md-6">
                                <label asp-for="AreaId" class="form-label fw-semibold">
                                    @T["mat.label_area","Area"] <span class="text-danger">*</span>
                                </label>
                                <select asp-for="AreaId" class="form-select">
                                    <option value="">@T["mat.select_area","— Nessuna area —"]</option>
                                    @foreach (var ar in availableAreas)
                                    {
                                        <option value="@ar.Id" selected="@(Model.AreaId == ar.Id ? "selected" : null)">@ar.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="AreaId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CatalogationDate" class="form-label fw-semibold">
                                    @T["mat.label_cat_date","Data catalogazione"] <span class="text-danger">*</span>
                                </label>
                                <input asp-for="CatalogationDate" type="date" class="form-control"
                                       value="@(Model.CatalogationDate.HasValue ? Model.CatalogationDate.Value.ToString("yyyy-MM-dd") : "")" />
                                <span asp-validation-for="CatalogationDate" class="text-danger small"></span>
                            </div>
                        </div>
                    }

                    <hr />
                    <h6 class="text-muted mb-3">
                        <i class="bi bi-upload me-1"></i>@T["mat.upload_new_section","Upload new version file (optional)"]
                    </h6>
                    @if (material?.ActiveVersion != null)
                    {
                        <div class="alert alert-info py-2 mb-3">
                            <i class="bi bi-info-circle me-1"></i>
                            @T["mat.active_version_label","Active version:"]
                            <strong>v@(material.CurrentVersion)</strong> — @material.ActiveVersion.FileName
                            (@material.ActiveVersion.FileSizeFormatted)
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">@T["mat.new_file","New file"]</label>
                        <div class="input-group">
                            <label for="File" class="btn btn-outline-secondary mb-0">
                                <i class="bi bi-folder2-open me-1"></i>@T["mat.choose_file","Choose file"]
                            </label>
                            <span class="form-control text-muted"
                                  id="fileName_File"
                                  data-placeholder="@T["mat.no_file_chosen","No file chosen"]">@T["mat.no_file_chosen","No file chosen"]</span>
                            <input asp-for="File" type="file" class="d-none" id="File"
                                   onchange="matFileChanged(this)" />
                        </div>
                        <div class="form-text d-flex align-items-center gap-2">
                            @T["mat.file_hint","Leave empty to not update the file."]
                            <span id="pageCountDisplay" class="text-muted fst-italic small"></span>
                        </div>
                    </div>

                    <div id="convertPdfBox" class="alert alert-warning d-none py-2 mb-3">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="ConvertToPdf" name="ConvertToPdf" value="true" />
                            <label class="form-check-label fw-semibold" for="ConvertToPdf">
                                <i class="bi bi-file-earmark-pdf me-1"></i>@T["mat.convert_to_pdf","Convert to PDF before saving"]
                            </label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label fw-semibold">@T["mat.new_version_notes","New version notes"]</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"
                                  placeholder="@T["mat.version_notes_placeholder","What changes in this version?"]"></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x me-1"></i>@T["mat.cancel","Cancel"]
                        </a>
                        <button type="button" id="submitBtn" class="btn btn-bocconi">
                            <i class="bi bi-check-lg me-1"></i>@T["mat.save_btn","Save changes"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@* ── Verified-fields modal ──────────────────────────────────────────────── *@
<div class="modal fade" id="verifiedModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success bg-opacity-10 border-success">
                <h5 class="modal-title text-success">
                    <i class="bi bi-shield-check me-2"></i>@T["mat.verified_modal_title","Verifica completata"]
                </h5>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">@T["mat.verified_modal_hint","Completa i dati di registrazione prima di salvare come Verificato."]</p>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-hash me-1"></i>@T["mat.protocol_number","Numero di protocollo"]
                    </label>
                    <div class="d-flex align-items-center gap-2 px-3 py-2 rounded border bg-light text-muted small">
                        <i class="bi bi-magic"></i>
                        <span>@T["mat.protocol_auto","Assegnato automaticamente al salvataggio"]</span>
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-folder2 me-1"></i>@T["mat.label_folder","Cartella"] <span class="text-danger">*</span>
                    </label>
                    <div class="input-group input-group-sm mb-1">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="folderSearch" class="form-control border-start-0 ps-0"
                               placeholder="@T["mat.folder_filter","Filtra cartelle…"]"
                               autocomplete="off" />
                    </div>
                    <div id="folderList"
                         class="overflow-auto border rounded bg-white"
                         style="max-height:180px; min-height:38px"></div>
                    <div id="newFolderInputGroup" class="input-group input-group-sm mt-1 d-none">
                        <span class="input-group-text fw-bold text-secondary" id="folderPrefixBadge" style="min-width:3rem;justify-content:center">IT</span>
                        <span class="input-group-text border-start-0 px-1 text-muted">–</span>
                        <input type="text" id="newFolderInput" class="form-control"
                               placeholder="@T["mat.folder_new_placeholder","DOCUMENTI VARI"]"
                               maxlength="120" autocomplete="off" />
                    </div>
                    <div id="folderError" class="text-danger small d-none mt-1">
                        @T["mat.folder_required","Seleziona una cartella o inserisci il nome della nuova."]
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" id="modalCancelBtn">
                    @T["common.cancel","Cancel"]
                </button>
                <button type="button" class="btn btn-success" id="modalConfirmBtn">
                    <i class="bi bi-check-lg me-1"></i>@T["mat.modal_confirm","Conferma e salva"]
                </button>
            </div>
        </div>
    </div>
</div>

<div id="folderMap" data-folders="@System.Text.Json.JsonSerializer.Serialize(existingFolders.Select(f => new { f.Id, f.Name }))"></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        (function () {
            var summary = document.getElementById('valSummary');
            if (summary && summary.querySelectorAll('li').length > 0)
                summary.classList.remove('d-none');
        })();

        var OFFICE_EXTS = ['doc','docx','ppt','pptx'];
        var ZIP_EXTS    = ['docx','pptx','xlsx'];

        var LANG_PREFIX = {
            'Italiano':'IT','Inglese':'EN','Francese':'FR','Tedesco':'DE',
            'Spagnolo':'ES','Russo':'RU','Cinese':'ZH','Arabo':'AR',
            'Portoghese':'PT','Altro':'XX'
        };

        // ── Verified modal logic ───────────────────────────────────────────
        var verifiedModal = new bootstrap.Modal(document.getElementById('verifiedModal'));
        var folderMap = [];
        try { folderMap = JSON.parse(document.getElementById('folderMap').dataset.folders); } catch(e){}

        var form = document.getElementById('matForm');
        var hasProtocol = form.dataset.hasProtocol === 'true';
        var hasFolder   = form.dataset.hasFolder === 'true';

        var _selectedFolderId   = null;
        var _selectedFolderName = null;
        var _selectedIsNew      = false;
        var _tNewFolder = @Json.Serialize(T["mat.folder_new","+ Nuova cartella"]);

        function escHtml(s) {
            return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        function folderListBuild(filter) {
            var list = document.getElementById('folderList');
            list.innerHTML = '';
            var term = (filter || '').toLowerCase();
            var filtered = folderMap.filter(function(f) {
                return !term || f.Name.toLowerCase().indexOf(term) !== -1;
            });
            filtered.forEach(function(f) {
                var btn = document.createElement('button');
                btn.type = 'button';
                var active = (_selectedFolderId === f.Id && !_selectedIsNew);
                btn.className = 'list-group-item list-group-item-action py-1 px-2 small border-0' + (active ? ' active' : '');
                btn.innerHTML = '<i class="bi bi-folder me-1"></i>' + escHtml(f.Name);
                btn.addEventListener('click', function() {
                    _selectedFolderId   = f.Id;
                    _selectedFolderName = f.Name;
                    _selectedIsNew      = false;
                    document.getElementById('newFolderInputGroup').classList.add('d-none');
                    document.getElementById('newFolderInput').value = '';
                    document.getElementById('folderError').classList.add('d-none');
                    folderListBuild(document.getElementById('folderSearch').value);
                });
                list.appendChild(btn);
            });
            var newBtn = document.createElement('button');
            newBtn.type = 'button';
            newBtn.className = 'list-group-item list-group-item-action py-1 px-2 small border-0 text-primary fw-semibold' +
                               (_selectedIsNew ? ' active text-white' : '');
            newBtn.innerHTML = _tNewFolder;
            newBtn.addEventListener('click', function() {
                _selectedFolderId   = null;
                _selectedFolderName = null;
                _selectedIsNew      = true;
                document.getElementById('newFolderInputGroup').classList.remove('d-none');
                document.getElementById('newFolderInput').focus();
                document.getElementById('folderError').classList.add('d-none');
                folderListBuild(document.getElementById('folderSearch').value);
            });
            list.appendChild(newBtn);
        }

        document.getElementById('folderSearch').addEventListener('input', function() {
            folderListBuild(this.value);
        });

        function langPrefix() {
            var lang = document.getElementById('langSelect').value;
            return LANG_PREFIX[lang] || 'XX';
        }

        function needsModal() {
            if (document.getElementById('statusSelect').value !== 'verificato') return false;
            return !hasProtocol || !hasFolder;
        }

        function openVerifiedModal() {
            _selectedFolderId   = null;
            _selectedFolderName = null;
            _selectedIsNew      = false;
            document.getElementById('folderSearch').value = '';
            document.getElementById('newFolderInputGroup').classList.add('d-none');
            document.getElementById('newFolderInput').value = '';
            document.getElementById('folderError').classList.add('d-none');
            document.getElementById('folderPrefixBadge').textContent = langPrefix();
            folderListBuild('');
            verifiedModal.show();
            setTimeout(function() { document.getElementById('folderSearch').focus(); }, 300);
        }

        document.getElementById('submitBtn').addEventListener('click', function() {
            if (!form.reportValidity || !form.reportValidity()) return;

            if (needsModal()) {
                openVerifiedModal();
            } else {
                form.submit();
            }
        });

        document.getElementById('modalConfirmBtn').addEventListener('click', function() {
            var errEl = document.getElementById('folderError');
            if (_selectedFolderId && !_selectedIsNew) {
                document.getElementById('hidFolderId').value = _selectedFolderId;
                document.getElementById('hidFolderName').value = '';
            } else if (_selectedIsNew) {
                var newName = (document.getElementById('newFolderInput').value || '').trim();
                if (!newName) {
                    errEl.classList.remove('d-none');
                    document.getElementById('newFolderInput').focus();
                    return;
                }
                var prefix = langPrefix();
                document.getElementById('hidFolderId').value = '';
                document.getElementById('hidFolderName').value = prefix + ' \u2013 ' + newName;
            } else {
                errEl.classList.remove('d-none');
                return;
            }
            verifiedModal.hide();
            form.submit();
        });

        document.getElementById('modalCancelBtn').addEventListener('click', function() {
            // Revert status to in_revisione
            document.getElementById('statusSelect').value = 'in_revisione';
            verifiedModal.hide();
        });

        // ── File input handling ───────────────────────────────────────────
        function extractOfficeAuthor(file) {
            if (typeof JSZip === 'undefined') return Promise.resolve(null);
            return JSZip.loadAsync(file).then(function (zip) {
                var entry = zip.file('docProps/core.xml');
                if (!entry) return null;
                return entry.async('string').then(function (xml) {
                    var m = xml.match(/<dc:creator[^>]*>([\s\S]*?)<\/dc:creator>/);
                    return (m && m[1].trim()) ? m[1].trim() : null;
                });
            }).catch(function () { return null; });
        }

        // Configura il worker di pdf.js
        if (window.pdfjsLib) {
            window.pdfjsLib.GlobalWorkerOptions.workerSrc =
                'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
        }

        function extractPdfMetadata(file) {
            if (window.pdfjsLib) {
                return file.arrayBuffer().then(function(ab) {
                    return window.pdfjsLib.getDocument({ data: ab }).promise;
                }).then(function(pdf) {
                    var numPages = pdf.numPages;
                    return pdf.getMetadata().then(function(meta) {
                        var author = null;
                        if (meta && meta.info) {
                            author = (meta.info.Author || meta.info.author || '').trim() || null;
                        }
                        if (!author && meta && meta.metadata) {
                            try {
                                var raw = meta.metadata.getRaw ? meta.metadata.getRaw() : '';
                                var mXmp = raw.match(/<dc:creator[\s\S]{0,400}?<rdf:li[^>]*>([\s\S]*?)<\/rdf:li>/);
                                if (mXmp && mXmp[1].trim()) author = mXmp[1].trim();
                            } catch(e) {}
                        }
                        return { author: author, pageCount: numPages };
                    }).catch(function() {
                        return { author: null, pageCount: numPages };
                    });
                }).catch(function() {
                    return _extractPdfFallback(file);
                });
            }
            return _extractPdfFallback(file);
        }

        function _extractPdfFallback(file) {
            return new Promise(function(resolve) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    try {
                        var text = e.target.result;
                        var author = null;
                        var mAuth = text.match(/\/Author\s*\(([^)\\]*(?:\\.[^)\\]*)*)\)/);
                        if (mAuth && mAuth[1].trim()) author = mAuth[1].trim();
                        if (!author) {
                            var mXmp = text.match(/<dc:creator[\s\S]{0,200}?<rdf:li[^>]*>([\s\S]*?)<\/rdf:li>/);
                            if (mXmp && mXmp[1].trim()) author = mXmp[1].trim();
                        }
                        var pageCount = null;
                        var mPg = text.match(/\/Type\s*\/Pages[\s\S]{0,300}?\/Count\s+(\d+)/);
                        if (mPg) {
                            pageCount = parseInt(mPg[1]);
                        } else {
                            var all = [], re = /\/Count\s+(\d+)/g, mc;
                            while ((mc = re.exec(text)) !== null) all.push(parseInt(mc[1]));
                            if (all.length) pageCount = Math.max.apply(null, all);
                        }
                        resolve({ author: author, pageCount: pageCount });
                    } catch(err) { resolve(null); }
                };
                reader.onerror = function() { resolve(null); };
                reader.readAsText(file.slice(0, 65536), 'windows-1252');
            });
        }

        function matFileChanged(inp) {
            var span      = document.getElementById('fileName_File');
            var pdfBox    = document.getElementById('convertPdfBox');
            var titleInp  = document.getElementById('matTitle');
            var authorInp = document.getElementById('AuthorName');
            var pgHid     = document.getElementById('hidPageCount');
            var pgDisp    = document.getElementById('pageCountDisplay');

            if (!inp.files || inp.files.length === 0) {
                if (span) span.textContent = span.dataset.placeholder || '';
                if (pdfBox) pdfBox.classList.add('d-none');
                return;
            }

            var file = inp.files[0];
            if (span) span.textContent = file.name;

            var ext       = file.name.split('.').pop().toLowerCase();
            var nameNoExt = file.name.replace(/\.[^.]+$/, '');
            var _tPages   = @Json.Serialize(T["mat.pages","pagine"]);
            var _tSlides  = @Json.Serialize(T["mat.slides","diapositive"]);

            if (titleInp && titleInp.value.trim() === '') {
                titleInp.value = nameNoExt;
            }

            if (OFFICE_EXTS.indexOf(ext) !== -1) {
                if (pdfBox) pdfBox.classList.remove('d-none');
            } else {
                if (pdfBox) pdfBox.classList.add('d-none');
                var cb = document.getElementById('ConvertToPdf');
                if (cb) cb.checked = false;
            }

            // Estrai autore da metadati
            if (authorInp && authorInp.value.trim() === '') {
                if (ZIP_EXTS.indexOf(ext) !== -1) {
                    extractOfficeAuthor(file).then(function (author) {
                        if (author && authorInp.value.trim() === '')
                            authorInp.value = author;
                    });
                } else if (ext === 'pdf') {
                    extractPdfMetadata(file).then(function(meta) {
                        if (meta && meta.author && authorInp.value.trim() === '')
                            authorInp.value = meta.author;
                    });
                }
            }

            // Numero di pagine/slide
            if (ext === 'pdf') {
                extractPdfMetadata(file).then(function(meta) {
                    if (meta && meta.pageCount) {
                        if (pgDisp) pgDisp.textContent = meta.pageCount + ' ' + _tPages;
                        if (pgHid) pgHid.value = meta.pageCount;
                    } else {
                        if (pgDisp) pgDisp.textContent = '';
                        if (pgHid) pgHid.value = '';
                    }
                });
            } else if (typeof JSZip !== 'undefined' && ZIP_EXTS.indexOf(ext) !== -1) {
                JSZip.loadAsync(file).then(function(zip) {
                    var entry = zip.file('docProps/app.xml');
                    if (!entry) return null;
                    return entry.async('string').then(function(xml) {
                        var mp = xml.match(/<Pages>(\d+)<\/Pages>/);
                        if (mp) return { count: parseInt(mp[1]), unit: _tPages };
                        var ms = xml.match(/<Slides>(\d+)<\/Slides>/);
                        if (ms) return { count: parseInt(ms[1]), unit: _tSlides };
                        return null;
                    });
                }).then(function(result) {
                    if (result) {
                        if (pgDisp) pgDisp.textContent = result.count + ' ' + result.unit;
                        if (pgHid) pgHid.value = result.count;
                    } else {
                        if (pgDisp) pgDisp.textContent = '';
                        if (pgHid) pgHid.value = '';
                    }
                }).catch(function() {});
            }
        }

        // ── Author autocomplete ────────────────────────────────────────────
        (function() {
            var authors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(existingAuthors));
            var inp  = document.getElementById('authorInput');
            var drop = document.getElementById('authorDropdown');
            if (!inp || !drop || !authors || !authors.length) return;

            function showDrop(matches) {
                drop.innerHTML = '';
                if (!matches.length) { drop.style.display = 'none'; return; }
                matches.forEach(function(a) {
                    var li  = document.createElement('li');
                    var btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'dropdown-item py-1 small';
                    btn.textContent = a;
                    btn.addEventListener('mousedown', function(e) {
                        e.preventDefault();
                        inp.value = a;
                        drop.style.display = 'none';
                    });
                    li.appendChild(btn);
                    drop.appendChild(li);
                });
                drop.style.display = 'block';
            }

            function filter(term) {
                if (!term) { drop.style.display = 'none'; return; }
                var lc = term.toLowerCase();
                var m = authors.filter(function(a) {
                    return a && a.toLowerCase().indexOf(lc) !== -1;
                }).slice(0, 12);
                showDrop(m);
            }

            inp.addEventListener('input',  function() { filter(this.value.trim()); });
            inp.addEventListener('focus',  function() { if (this.value.trim()) filter(this.value.trim()); });
            inp.addEventListener('blur',   function() { setTimeout(function(){ drop.style.display='none'; }, 150); });
            inp.addEventListener('keydown', function(e) {
                var items = Array.from(drop.querySelectorAll('.dropdown-item'));
                if (e.key === 'ArrowDown' && items.length) { items[0].focus(); e.preventDefault(); }
                else if (e.key === 'Escape') { drop.style.display = 'none'; }
            });
            drop.addEventListener('keydown', function(e) {
                var items = Array.from(drop.querySelectorAll('.dropdown-item'));
                var idx = items.indexOf(document.activeElement);
                if (e.key === 'ArrowDown' && idx < items.length - 1) { items[idx+1].focus(); e.preventDefault(); }
                else if (e.key === 'ArrowUp') {
                    if (idx > 0) items[idx-1].focus(); else inp.focus();
                    e.preventDefault();
                } else if (e.key === 'Escape') { drop.style.display='none'; inp.focus(); }
            });
        })();
    </script>
}
