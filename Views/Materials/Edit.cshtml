@model MaterialFormViewModel
@{
    ViewData["Title"] = T["mat.edit_title"];
    var material = ViewBag.Material as BocconiLMS.Models.Material;
    var docTypes = ViewBag.DocumentTypes as List<BocconiLMS.Models.DocumentType> ?? new();
    var languages = ViewBag.Languages as string[] ?? BocconiLMS.Models.Material.Languages;
    var owners = ViewBag.AvailableOwners as List<BocconiLMS.Models.User> ?? new();
    var existingAuthors = ViewBag.ExistingAuthors as List<string> ?? new();
    var availableAreas  = ViewBag.AvailableAreas as List<BocconiLMS.Models.Area> ?? new();
    var existingFolders = ViewBag.ExistingFolders as List<BocconiLMS.Models.MaterialFolder> ?? new();
    var platforms       = ViewBag.Platforms as List<BocconiLMS.Models.Platform> ?? new();
    bool canSetStatus   = ViewBag.CanSetStatus == true;
    bool canPublish     = ViewBag.CanPublish == true;

    bool hasProtocol = material?.ProtocolNumber != null;
    bool hasFolder   = material?.FolderId != null;
}


<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-bocconi text-white">
                <h5 class="mb-0"><i class="bi bi-pencil me-2"></i>@T["mat.edit_title"]</h5>
            </div>
            <div class="card-body">
                <form id="matForm" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data"
                      data-has-protocol="@hasProtocol.ToString().ToLower()"
                      data-has-folder="@hasFolder.ToString().ToLower()">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OwnerId" />
                    <input type="hidden" asp-for="FolderId" id="hidFolderId" />
                    <input type="hidden" asp-for="FolderName" id="hidFolderName" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" id="valSummary"></div>

                    @* ── Versione attiva ─────────────────────────────────── *@
                    <div class="d-flex align-items-center justify-content-between gap-3 rounded border px-3 py-2 mb-3"
                         style="background:#e8f4fd; border-color:#b6d4f5!important;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary" style="font-size:.8rem;">
                                <i class="bi bi-file-earmark me-1"></i>
                                @if (material?.ActiveVersion != null)
                                {
                                    <text>v@(material.CurrentVersion)</text>
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </span>
                            <span class="fw-semibold text-truncate" style="max-width:340px;">
                                @(material?.ActiveVersion?.FileName ?? T["mat.no_files"])
                            </span>
                            @if (material?.ActiveVersion != null)
                            {
                                <span class="text-muted small">(@material.ActiveVersion.FileSizeFormatted)</span>
                            }
                        </div>
                        <a asp-action="Details" asp-route-id="@Model.Id"
                           class="btn btn-sm btn-outline-primary text-nowrap">
                            <i class="bi bi-clock-history me-1"></i>@T["mat.versions"]
                        </a>
                    </div>

                    <div class="row mb-3 g-2 align-items-start">
                        <div class="col-md-4">
                            <label asp-for="AuthorName" class="form-label fw-semibold">
                                @T["mat.label_author"] <span class="text-danger">*</span>
                            </label>
                            <div class="position-relative">
                                <input asp-for="AuthorName" id="authorInput" class="form-control"
                                       placeholder="@T["mat.author_placeholder"]"
                                       autocomplete="off" />
                                <ul id="authorDropdown"
                                    class="dropdown-menu w-100 shadow-sm py-1"
                                    style="max-height:200px;overflow-y:auto;display:none;position:absolute;z-index:1055"></ul>
                            </div>
                            <span asp-validation-for="AuthorName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Title" class="form-label fw-semibold">
                                @T["mat.label_title"] <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Title" id="matTitle" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3 g-2 align-items-start">
                        <div class="col-md-8">
                            <label asp-for="DocumentTypeId" class="form-label fw-semibold">
                                @T["mat.label_doctype"] <span class="text-danger">*</span>
                            </label>
                            <select asp-for="DocumentTypeId" class="form-select">
                                <option value="">@T["mat.select_type"]</option>
                                @foreach (var t in docTypes)
                                {
                                    <option value="@t.Id" selected="@(Model.DocumentTypeId == t.Id ? "selected" : null)">@t.Name</option>
                                }
                            </select>
                            <span asp-validation-for="DocumentTypeId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Language" class="form-label fw-semibold">
                                @T["mat.label_language"] <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Language" id="langSelect" class="form-select">
                                @foreach (var l in languages)
                                {
                                    <option value="@l" selected="@(Model.Language == l ? "selected" : null)">@l</option>
                                }
                            </select>
                            <span asp-validation-for="Language" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-semibold">@T["mat.label_status"]</label>
                        @if (canSetStatus)
                        {
                            <select asp-for="Status" id="statusSelect" class="form-select">
                                <option value="draft"        selected="@(Model.Status=="draft"?"selected":null)">@T["mat.status_bozza"]</option>
                                <option value="under_review" selected="@(Model.Status=="under_review"?"selected":null)">@T["mat.status_in_revisione"]</option>
                                <option value="verified"     selected="@(Model.Status=="verified"?"selected":null)">@T["mat.status_verificato"]</option>
                            </select>
                        }
                        else
                        {
                            @* Utenti senza flag: preserva lo stato attuale del materiale *@
                            <input type="hidden" id="statusSelect" name="Status" value="@Model.Status" />
                            <input type="text" class="form-control bg-light" readonly
                                   value="@(Model.Status == "verified" ? T["mat.status_verificato"] : Model.Status == "under_review" ? T["mat.status_in_revisione"] : T["mat.status_bozza"])" />
                            <div class="form-text">
                                <i class="bi bi-lock me-1"></i>@T["mat.status_locked_edit"]
                            </div>
                        }
                    </div>

                    @* Show current protocol/folder info if already set (read-only) *@
                    @if (hasProtocol || hasFolder)
                    {
                        <div class="card border-success mb-3">
                            <div class="card-header bg-success bg-opacity-10 text-success fw-semibold py-2">
                                <i class="bi bi-shield-check me-1"></i>@T["mat.verified_fields"]
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    @if (hasProtocol)
                                    {
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">@T["mat.protocol_number"]</label>
                                            <input type="text" class="form-control" readonly value="@material!.ProtocolNumber" />
                                        </div>
                                    }
                                    @if (hasFolder)
                                    {
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">@T["mat.label_folder"]</label>
                                            <input type="text" class="form-control" readonly value="@material!.FolderName" />
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (availableAreas.Any())
                    {
                        <div class="row mb-3 g-2">
                            <div class="col-md-6">
                                <label asp-for="AreaId" class="form-label fw-semibold">
                                    @T["mat.label_area"] <span class="text-danger">*</span>
                                </label>
                                <select asp-for="AreaId" class="form-select">
                                    <option value="">@T["mat.select_area"]</option>
                                    @foreach (var ar in availableAreas)
                                    {
                                        <option value="@ar.Id" selected="@(Model.AreaId == ar.Id ? "selected" : null)">@ar.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="AreaId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CatalogationDate" class="form-label fw-semibold">
                                    @T["mat.label_cat_date"] <span class="text-danger">*</span>
                                </label>
                                <input asp-for="CatalogationDate" type="date" class="form-control"
                                       value="@(Model.CatalogationDate.HasValue ? Model.CatalogationDate.Value.ToString("yyyy-MM-dd") : "")" />
                                <span asp-validation-for="CatalogationDate" class="text-danger small"></span>
                            </div>
                        </div>
                    }

                    <div class="row mb-3 g-2">
                        <div class="col-md-3">
                            <label asp-for="PageCount" class="form-label fw-semibold">
                                @T["mat.label_page_count"]
                            </label>
                            <input asp-for="PageCount" id="pageCountInput" type="number" min="1"
                                   class="form-control" placeholder="—" />
                        </div>
                    </div>

                    <hr />

                    @* ── Publish section ─────────────────────────────────── *@
                    @if (canPublish)
                    {
                        <div class="border border-primary rounded p-3 mb-3 bg-primary bg-opacity-10" id="publishSection">
                            <div class="mb-3">
                                <div class="form-check">
                                    <input asp-for="IsPublishable" class="form-check-input" id="isPublishableCheck"
                                           onchange="togglePublishFields()" />
                                    <label class="form-check-label fw-semibold" for="isPublishableCheck">
                                        @T["mat.label_publishable"]
                                    </label>
                                </div>
                            </div>
                            <div id="publishFields" style="@(Model.IsPublishable ? "" : "display:none;")">
                                <div class="row g-2 mb-2">
                                    <div class="col-md-6">
                                        <label asp-for="ExternalProtocolCode" class="form-label fw-semibold">
                                            @T["mat.label_ext_protocol"]
                                        </label>
                                        <input asp-for="ExternalProtocolCode" class="form-control" id="extProtocolInput"
                                               oninput="updatePublishedState()" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="PlatformId" class="form-label fw-semibold">
                                            @T["mat.label_platform"]
                                        </label>
                                        <select asp-for="PlatformId" class="form-select">
                                            <option value="">@T["mat.select_platform"]</option>
                                            @foreach (var pl in platforms)
                                            {
                                                <option value="@pl.Id" selected="@(Model.PlatformId == pl.Id ? "selected" : null)">@pl.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="row g-2 mb-2">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">@T["mat.label_published"]</label>
                                        <div class="form-control bg-light" id="publishedDisplay">
                                            @if (!string.IsNullOrEmpty(Model.ExternalProtocolCode))
                                            {
                                                <span class="badge bg-success"><i class="bi bi-check2 me-1"></i>@T["mat.badge_published"]</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@T["mat.badge_publishable"]</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="ExternalLink" class="form-label fw-semibold">
                                            @T["mat.label_ext_link"]
                                        </label>
                                        <input asp-for="ExternalLink" type="url" class="form-control"
                                               placeholder="https://..." />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x me-1"></i>@T["mat.cancel"]
                        </a>
                        <button type="button" id="submitBtn" class="btn btn-bocconi">
                            <i class="bi bi-check-lg me-1"></i>@T["mat.save_btn"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@* ── Verified-fields modal ──────────────────────────────────────────────── *@
<div class="modal fade" id="verifiedModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success bg-opacity-10 border-success">
                <h5 class="modal-title text-success">
                    <i class="bi bi-shield-check me-2"></i>@T["mat.verified_modal_title"]
                </h5>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">@T["mat.verified_modal_hint"]</p>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-hash me-1"></i>@T["mat.protocol_number"]
                    </label>
                    <div class="d-flex align-items-center gap-2 px-3 py-2 rounded border bg-light text-muted small">
                        <i class="bi bi-magic"></i>
                        <span>@T["mat.protocol_auto"]</span>
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-folder2 me-1"></i>@T["mat.label_folder"] <span class="text-danger">*</span>
                    </label>
                    <div class="input-group input-group-sm mb-1">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="folderSearch" class="form-control border-start-0 ps-0"
                               placeholder="@T["mat.folder_filter"]"
                               autocomplete="off" />
                    </div>
                    <div id="folderList"
                         class="overflow-auto border rounded bg-white"
                         style="max-height:180px; min-height:38px"></div>
                    <div id="newFolderInputGroup" class="input-group input-group-sm mt-1 d-none">
                        <span class="input-group-text fw-bold text-secondary" id="folderPrefixBadge" style="min-width:3rem;justify-content:center">IT</span>
                        <span class="input-group-text border-start-0 px-1 text-muted">–</span>
                        <input type="text" id="newFolderInput" class="form-control"
                               placeholder="@T["mat.folder_new_placeholder"]"
                               maxlength="120" autocomplete="off" />
                    </div>
                    <div id="folderError" class="text-danger small d-none mt-1">
                        @T["mat.folder_required"]
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" id="modalCancelBtn">
                    @T["common.cancel"]
                </button>
                <button type="button" class="btn btn-success" id="modalConfirmBtn">
                    <i class="bi bi-check-lg me-1"></i>@T["mat.modal_confirm"]
                </button>
            </div>
        </div>
    </div>
</div>

<div id="folderMap" data-folders="@System.Text.Json.JsonSerializer.Serialize(existingFolders.Select(f => new { f.Id, f.Name }))"></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var summary = document.getElementById('valSummary');
            if (summary && summary.querySelectorAll('li').length > 0)
                summary.classList.remove('d-none');
        })();

        var LANG_PREFIX = {
            'Italiano':'IT','Inglese':'EN','Francese':'FR','Tedesco':'DE',
            'Spagnolo':'ES','Russo':'RU','Cinese':'ZH','Arabo':'AR',
            'Portoghese':'PT','Altro':'XX'
        };

        // ── Verified modal logic ───────────────────────────────────────────
        var verifiedModal = new bootstrap.Modal(document.getElementById('verifiedModal'));
        var folderMap = [];
        try { folderMap = JSON.parse(document.getElementById('folderMap').dataset.folders); } catch(e){}

        var form = document.getElementById('matForm');
        var hasProtocol = form.dataset.hasProtocol === 'true';
        var hasFolder   = form.dataset.hasFolder === 'true';

        var _selectedFolderId   = null;
        var _selectedFolderName = null;
        var _selectedIsNew      = false;
        var _tNewFolder = @Json.Serialize(T["mat.folder_new"]);

        function escHtml(s) {
            return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        function folderListBuild(filter) {
            var list = document.getElementById('folderList');
            list.innerHTML = '';
            var term = (filter || '').toLowerCase();
            var filtered = folderMap.filter(function(f) {
                return !term || f.Name.toLowerCase().indexOf(term) !== -1;
            });
            filtered.forEach(function(f) {
                var btn = document.createElement('button');
                btn.type = 'button';
                var active = (_selectedFolderId === f.Id && !_selectedIsNew);
                btn.className = 'list-group-item list-group-item-action py-1 px-2 small border-0' + (active ? ' active' : '');
                btn.innerHTML = '<i class="bi bi-folder me-1"></i>' + escHtml(f.Name);
                btn.addEventListener('click', function() {
                    _selectedFolderId   = f.Id;
                    _selectedFolderName = f.Name;
                    _selectedIsNew      = false;
                    document.getElementById('newFolderInputGroup').classList.add('d-none');
                    document.getElementById('newFolderInput').value = '';
                    document.getElementById('folderError').classList.add('d-none');
                    folderListBuild(document.getElementById('folderSearch').value);
                });
                list.appendChild(btn);
            });
            var newBtn = document.createElement('button');
            newBtn.type = 'button';
            newBtn.className = 'list-group-item list-group-item-action py-1 px-2 small border-0 text-primary fw-semibold' +
                               (_selectedIsNew ? ' active text-white' : '');
            newBtn.innerHTML = _tNewFolder;
            newBtn.addEventListener('click', function() {
                _selectedFolderId   = null;
                _selectedFolderName = null;
                _selectedIsNew      = true;
                document.getElementById('newFolderInputGroup').classList.remove('d-none');
                document.getElementById('newFolderInput').focus();
                document.getElementById('folderError').classList.add('d-none');
                folderListBuild(document.getElementById('folderSearch').value);
            });
            list.appendChild(newBtn);
        }

        document.getElementById('folderSearch').addEventListener('input', function() {
            folderListBuild(this.value);
        });

        function langPrefix() {
            var lang = document.getElementById('langSelect').value;
            return LANG_PREFIX[lang] || 'XX';
        }

        function needsModal() {
            if (document.getElementById('statusSelect').value !== 'verified') return false;
            return !hasProtocol || !hasFolder;
        }

        function openVerifiedModal() {
            _selectedFolderId   = null;
            _selectedFolderName = null;
            _selectedIsNew      = false;
            document.getElementById('folderSearch').value = '';
            document.getElementById('newFolderInputGroup').classList.add('d-none');
            document.getElementById('newFolderInput').value = '';
            document.getElementById('folderError').classList.add('d-none');
            document.getElementById('folderPrefixBadge').textContent = langPrefix();
            folderListBuild('');
            verifiedModal.show();
            setTimeout(function() { document.getElementById('folderSearch').focus(); }, 300);
        }

        document.getElementById('submitBtn').addEventListener('click', function() {
            if (!form.reportValidity || !form.reportValidity()) return;

            if (needsModal()) {
                openVerifiedModal();
            } else {
                form.submit();
            }
        });

        document.getElementById('modalConfirmBtn').addEventListener('click', function() {
            var errEl = document.getElementById('folderError');
            if (_selectedFolderId && !_selectedIsNew) {
                document.getElementById('hidFolderId').value = _selectedFolderId;
                document.getElementById('hidFolderName').value = '';
            } else if (_selectedIsNew) {
                var newName = (document.getElementById('newFolderInput').value || '').trim();
                if (!newName) {
                    errEl.classList.remove('d-none');
                    document.getElementById('newFolderInput').focus();
                    return;
                }
                var prefix = langPrefix();
                document.getElementById('hidFolderId').value = '';
                document.getElementById('hidFolderName').value = prefix + ' \u2013 ' + newName;
            } else {
                errEl.classList.remove('d-none');
                return;
            }
            verifiedModal.hide();
            form.submit();
        });

        document.getElementById('modalCancelBtn').addEventListener('click', function() {
            // Revert status to under_review
            document.getElementById('statusSelect').value = 'under_review';
            verifiedModal.hide();
        });

        // ── Author autocomplete ────────────────────────────────────────────
        (function() {
            var authors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(existingAuthors));
            var inp  = document.getElementById('authorInput');
            var drop = document.getElementById('authorDropdown');
            if (!inp || !drop || !authors || !authors.length) return;

            function showDrop(matches) {
                drop.innerHTML = '';
                if (!matches.length) { drop.style.display = 'none'; return; }
                matches.forEach(function(a) {
                    var li  = document.createElement('li');
                    var btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'dropdown-item py-1 small';
                    btn.textContent = a;
                    btn.addEventListener('mousedown', function(e) {
                        e.preventDefault();
                        inp.value = a;
                        drop.style.display = 'none';
                    });
                    li.appendChild(btn);
                    drop.appendChild(li);
                });
                drop.style.display = 'block';
            }

            function filter(term) {
                if (!term) { drop.style.display = 'none'; return; }
                var lc = term.toLowerCase();
                var m = authors.filter(function(a) {
                    return a && a.toLowerCase().indexOf(lc) !== -1;
                }).slice(0, 12);
                showDrop(m);
            }

            inp.addEventListener('input',  function() { filter(this.value.trim()); });
            inp.addEventListener('focus',  function() { if (this.value.trim()) filter(this.value.trim()); });
            inp.addEventListener('blur',   function() { setTimeout(function(){ drop.style.display='none'; }, 150); });
            inp.addEventListener('keydown', function(e) {
                var items = Array.from(drop.querySelectorAll('.dropdown-item'));
                if (e.key === 'ArrowDown' && items.length) { items[0].focus(); e.preventDefault(); }
                else if (e.key === 'Escape') { drop.style.display = 'none'; }
            });
            drop.addEventListener('keydown', function(e) {
                var items = Array.from(drop.querySelectorAll('.dropdown-item'));
                var idx = items.indexOf(document.activeElement);
                if (e.key === 'ArrowDown' && idx < items.length - 1) { items[idx+1].focus(); e.preventDefault(); }
                else if (e.key === 'ArrowUp') {
                    if (idx > 0) items[idx-1].focus(); else inp.focus();
                    e.preventDefault();
                } else if (e.key === 'Escape') { drop.style.display='none'; inp.focus(); }
            });
        })();

        // ── Publish section toggle ────────────────────────────────────────
        function togglePublishFields() {
            var checked = document.getElementById('isPublishableCheck')?.checked;
            var fields  = document.getElementById('publishFields');
            if (fields) fields.style.display = checked ? '' : 'none';
            if (!checked) {
                var inp = document.getElementById('extProtocolInput');
                if (inp) inp.value = '';
                updatePublishedState();
            }
        }
        function updatePublishedState() {
            var inp = document.getElementById('extProtocolInput');
            var disp = document.getElementById('publishedDisplay');
            if (!inp || !disp) return;
            var publishedLabel = @Json.Serialize(T["mat.badge_published"]);
            var publishableLabel = @Json.Serialize(T["mat.badge_publishable"]);
            if (inp.value.trim() !== '') {
                disp.innerHTML = '<span class="badge bg-success"><i class="bi bi-check2 me-1"></i>' + publishedLabel + '</span>';
            } else {
                disp.innerHTML = '<span class="text-muted">' + publishableLabel + '</span>';
            }
        }
    </script>
}
