@model BocconiLMS.Models.Material
@{
    ViewData["Title"] = Model.Title;
    var versions = ViewBag.Versions as List<BocconiLMS.Models.MaterialVersion> ?? new();
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">@T["mat.nav","Materials"]</a></li>
        <li class="breadcrumb-item active">@Model.Title</li>
    </ol>
</nav>

<div class="row">
    <div class="col-lg-8">
        <div class="mb-3">
            <h2 class="fw-bold">@Model.Title</h2>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold"><i class="bi bi-clock-history me-2"></i>@T["mat.versions","Versions"] (@versions.Count)</span>
            </div>
            <div class="card-body p-0">
                @if (!versions.Any())
                {
                    <p class="text-muted p-3 mb-0">@T["mat.no_files","No file uploaded yet."]</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var v in versions)
                        {
                            <div class="list-group-item @(v.IsActive ? "bg-light" : "")">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="version-badge">v@(v.VersionNumber)</span>
                                        @if (v.IsActive)
                                        {
                                            <span class="badge bg-success">@T["mat.version_active","Active"]</span>
                                        }
                                        <div>
                                            <div class="fw-semibold small">@v.FileName</div>
                                            <div class="text-muted" style="font-size:.75rem;">
                                                @v.FileSizeFormatted &middot;
                                                @v.UploadedAt.ToString("dd/MM/yyyy HH:mm") &middot;
                                                @v.UploaderName
                                            </div>
                                            @if (!string.IsNullOrEmpty(v.Notes))
                                            {
                                                <div class="text-secondary fst-italic" style="font-size:.75rem;">@v.Notes</div>
                                            }
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-info btn-preview"
                                                data-version-id="@v.Id"
                                                data-file-type="@v.FileType"
                                                data-file-name="@v.FileName"
                                                title="Anteprima">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <a asp-action="Download" asp-route-versionId="@v.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="@T["mat.download_btn","Download"]">
                                            <i class="bi bi-download"></i>
                                        </a>
                                        @if (!v.IsActive && (bool)(ViewBag.CanEdit ?? false))
                                        {
                                            <form asp-action="Restore" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="materialId" value="@Model.Id" />
                                                <input type="hidden" name="versionId" value="@v.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-warning"
                                                        data-confirm="@T["mat.restore_confirm","Restore version"] v@(v.VersionNumber)?"
                                                        title="@T["mat.restore_btn","Restore"]">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            </form>
                                        }
                                        @if ((bool)(ViewBag.CanEdit ?? false))
                                        {
                                            <form asp-action="DeleteVersion" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="versionId" value="@v.Id" />
                                                <input type="hidden" name="materialId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        data-confirm="@T["mat.delete_version_confirm","Eliminare la versione"] v@(v.VersionNumber)?"
                                                        title="@T["mat.delete_version_btn","Elimina versione"]">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @if ((bool)(ViewBag.CanEdit ?? false))
        {
            <div class="card">
                <div class="card-header fw-semibold">
                    <i class="bi bi-upload me-2"></i>@T["mat.upload_version","Upload new version"]
                </div>
                <div class="card-body">
                    <form asp-action="UploadVersion" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="row g-2 align-items-end">
                            <div class="col-md-5">
                                <label class="form-label small fw-semibold">@T["mat.label_file","File"]</label>
                                <div class="input-group input-group-sm">
                                    <label for="fileUploadDetails" class="btn btn-outline-secondary btn-sm mb-0">
                                        <i class="bi bi-folder2-open me-1"></i>@T["mat.choose_file","Choose file"]
                                    </label>
                                    <span class="form-control text-muted text-truncate"
                                          id="fileNameDetails"
                                          data-placeholder="@T["mat.no_file_chosen","No file chosen"]">@T["mat.no_file_chosen","No file chosen"]</span>
                                    <input type="file" name="file" id="fileUploadDetails" class="d-none" required
                                           onchange="bocconiFileInput(this,'fileNameDetails')" />
                                </div>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label small fw-semibold">@T["mat.notes","Notes"]</label>
                                <input type="text" name="notes" class="form-control form-control-sm"
                                       placeholder="@T["mat.notes_placeholder","What changed?"]" />
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-bocconi btn-sm w-100">
                                    <i class="bi bi-upload me-1"></i>@T["mat.upload_btn","Upload"]
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h6 class="fw-semibold mb-3"><i class="bi bi-info-circle me-1"></i>@T["mat.info_panel","Information"]</h6>
                @{
                    var (stCss, stLabel) = Model.Status switch {
                        "verificato"   => ("success",   T["mat.status_verificato","Verified"]),
                        "in_revisione" => ("warning",   T["mat.status_in_revisione","In review"]),
                        _              => ("secondary", T["mat.status_bozza","Draft"])
                    };
                }
                <dl class="row mb-0 small">
                    <dt class="col-5 text-muted">@T["mat.col_type","Type"]</dt>
                    <dd class="col-7">@(string.IsNullOrEmpty(Model.DocumentTypeName) ? "—" : Model.DocumentTypeName)</dd>
                    <dt class="col-5 text-muted">@T["mat.col_lang","Language"]</dt>
                    <dd class="col-7">@Model.Language</dd>
                    <dt class="col-5 text-muted">@T["mat.col_author","Author"]</dt>
                    <dd class="col-7">@(string.IsNullOrEmpty(Model.AuthorName) ? "—" : Model.AuthorName)</dd>
                    @if (Model.PageCount.HasValue)
                    {
                        <dt class="col-5 text-muted">@T["mat.page_count","Pages"]</dt>
                        <dd class="col-7">@Model.PageCount</dd>
                    }
                    <dt class="col-5 text-muted">@T["mat.label_owner","Responsible (system)"]</dt>
                    <dd class="col-7">@(string.IsNullOrEmpty(Model.OwnerName) ? "—" : Model.OwnerName)</dd>
                    <dt class="col-5 text-muted">@T["mat.col_status","Status"]</dt>
                    <dd class="col-7"><span class="badge bg-@stCss">@stLabel</span></dd>
                    @if (Model.ProtocolNumber.HasValue)
                    {
                        <dt class="col-5 text-muted">@T["mat.col_protocol","Protocollo"]</dt>
                        <dd class="col-7">
                            <code class="text-success fw-semibold">@Model.ProtocolNumber</code>
                        </dd>
                    }
                    @if (!string.IsNullOrEmpty(Model.FolderName))
                    {
                        <dt class="col-5 text-muted">@T["mat.label_folder","Cartella"]</dt>
                        <dd class="col-7">
                            <span><i class="bi bi-folder me-1 text-muted"></i>@Model.FolderName</span>
                        </dd>
                    }
                    @if (Model.AreaId.HasValue || !string.IsNullOrEmpty(Model.AreaName))
                    {
                        <dt class="col-5 text-muted">@T["mat.label_area","Area"]</dt>
                        <dd class="col-7">@(string.IsNullOrEmpty(Model.AreaName) ? "—" : Model.AreaName)</dd>
                    }
                    @if (Model.CatalogationDate.HasValue)
                    {
                        <dt class="col-5 text-muted">@T["mat.label_cat_date","Data catalogazione"]</dt>
                        <dd class="col-7">@Model.CatalogationDate.Value.ToString("dd/MM/yyyy")</dd>
                    }
                    <dt class="col-5 text-muted">@T["mat.col_version","Ver."]</dt>
                    <dd class="col-7">
                        @if (Model.CurrentVersion > 0)
                        { <span class="version-badge">v@(Model.CurrentVersion)</span> }
                        else { <span class="text-muted">—</span> }
                    </dd>
                    <dt class="col-5 text-muted">@T["mat.col_created","Created"]</dt>
                    <dd class="col-7">@Model.CreatedAt.ToString("dd/MM/yyyy")</dd>
                </dl>
                <hr />
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="bi bi-arrow-left me-1"></i>@T["mat.back","Back to Materials"]
                </a>
            </div>
        </div>

        @* ── Publish block ──────────────────────────────────────────── *@
        @if (Model.IsPublishable)
        {
            <div class="card mt-3 border-primary">
                <div class="card-header bg-primary bg-opacity-10 fw-semibold text-primary py-2">
                    <i class="bi bi-send me-1"></i>@T["mat.publish_section","Publication"]
                </div>
                <div class="card-body small">
                    <dl class="row mb-0">
                        <dt class="col-5 text-muted">@T["mat.label_publishable","Pubblicabile"]</dt>
                        <dd class="col-7">
                            <span class="badge bg-primary">@T["mat.badge_publishable","Pubblicabile"]</span>
                        </dd>
                        @if (Model.IsPublished)
                        {
                            <dt class="col-5 text-muted">@T["mat.label_published","Pubblicato"]</dt>
                            <dd class="col-7">
                                <span class="badge bg-success"><i class="bi bi-check2 me-1"></i>@T["mat.badge_published","Pubblicato"]</span>
                            </dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.ExternalProtocolCode))
                        {
                            <dt class="col-5 text-muted">@T["mat.label_ext_protocol","Codice protocollo esterno"]</dt>
                            <dd class="col-7"><code class="text-primary fw-semibold">@Model.ExternalProtocolCode</code></dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.PlatformName))
                        {
                            <dt class="col-5 text-muted">@T["mat.label_platform","Piattaforma"]</dt>
                            <dd class="col-7">@Model.PlatformName</dd>
                        }
                        @if (!string.IsNullOrEmpty(Model.ExternalLink))
                        {
                            <dt class="col-5 text-muted">@T["mat.label_ext_link","Link esterno"]</dt>
                            <dd class="col-7">
                                <a href="@Model.ExternalLink" target="_blank" rel="noopener" class="text-truncate d-inline-block" style="max-width:160px;">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>@T["mat.label_ext_link","Link"]
                                </a>
                            </dd>
                        }
                    </dl>
                </div>
            </div>
        }
    </div>
</div>

@* ── Modal anteprima file ─────────────────────────────────────────── *@
<div class="modal fade" id="previewModal" tabindex="-1" aria-labelledby="previewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title fw-semibold text-truncate me-3" id="previewModalLabel" style="max-width:75%;"></h6>
                <div class="d-flex gap-2 ms-auto align-items-center">
                    <a href="#" id="previewDownloadBtn" class="btn btn-sm btn-outline-primary" title="Download">
                        <i class="bi bi-download"></i>
                    </a>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
            </div>
            <div class="modal-body p-0" id="previewModalBody" style="min-height:70vh; background:#f5f5f5;"></div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js" crossorigin="anonymous"></script>
<script>
(function () {
    var imageTypes = ['PNG','JPG','JPEG','GIF','SVG','BMP','WEBP'];
    var videoTypes = ['MP4','WEBM','MOV','AVI','MKV'];

    document.addEventListener('click', function (e) {
        var btn = e.target.closest('.btn-preview');
        if (!btn) return;
        e.preventDefault();
        var versionId  = btn.dataset.versionId;
        var fileType   = (btn.dataset.fileType || '').toUpperCase();
        var fileName   = btn.dataset.fileName || '';
        var previewUrl  = '/Materials/Preview?versionId=' + versionId;
        var downloadUrl = '/Materials/Download?versionId=' + versionId;

        document.getElementById('previewModalLabel').textContent = fileName;
        document.getElementById('previewDownloadBtn').href = downloadUrl;

        var body = document.getElementById('previewModalBody');
        bootstrap.Modal.getOrCreateInstance(document.getElementById('previewModal')).show();

        if (fileType === 'PDF') {
            // PDF: PDF.js su canvas — evita blocchi Edge/Chrome per iframe con PDF
            body.innerHTML =
                '<div class="d-flex justify-content-center align-items-center" style="min-height:70vh;">' +
                '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Caricamento...</span></div></div>';
            fetch(previewUrl, { credentials: 'same-origin' })
                .then(function(r) { return r.ok ? r.arrayBuffer() : Promise.reject(r.status); })
                .then(function(buf) {
                    pdfjsLib.GlobalWorkerOptions.workerSrc =
                        'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
                    return pdfjsLib.getDocument({ data: buf }).promise;
                })
                .then(function(pdf) {
                    body._pdfDoc = pdf;
                    var wrap = document.createElement('div');
                    wrap.style.cssText = 'overflow-y:auto;height:80vh;background:#616161;padding:12px;box-sizing:border-box;';
                    body.innerHTML = '';
                    body.appendChild(wrap);
                    var seq = Promise.resolve();
                    for (var n = 1; n <= pdf.numPages; n++) {
                        (function(pageNum) {
                            seq = seq.then(function() {
                                return pdf.getPage(pageNum).then(function(page) {
                                    var vp0 = page.getViewport({ scale: 1 });
                                    var scale = Math.min((wrap.clientWidth - 24) / vp0.width, 2);
                                    var vp = page.getViewport({ scale: scale });
                                    var canvas = document.createElement('canvas');
                                    canvas.width  = vp.width;
                                    canvas.height = vp.height;
                                    canvas.style.cssText = 'display:block;margin:0 auto 8px;box-shadow:0 2px 8px rgba(0,0,0,.5);background:#fff;';
                                    wrap.appendChild(canvas);
                                    return page.render({ canvasContext: canvas.getContext('2d'), viewport: vp }).promise;
                                });
                            });
                        })(n);
                    }
                    return seq;
                })
                .catch(function() {
                    body.innerHTML =
                        '<div class="text-center p-5">' +
                        '<i class="bi bi-exclamation-triangle display-1 text-warning d-block mb-3"></i>' +
                        '<p class="text-muted mb-4">Impossibile caricare l\'anteprima.<br>Prova a scaricare il file.</p>' +
                        '<a href="' + downloadUrl + '" class="btn btn-bocconi"><i class="bi bi-download me-2"></i>Scarica</a></div>';
                });
        } else if (imageTypes.includes(fileType) || videoTypes.includes(fileType)) {
            body.innerHTML =
                '<div class="d-flex justify-content-center align-items-center" style="min-height:70vh;">' +
                '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Caricamento...</span></div></div>';
            fetch(previewUrl, { credentials: 'same-origin' })
                .then(function(r) { return r.ok ? r.blob() : Promise.reject(r.status); })
                .then(function(blob) {
                    var blobUrl = URL.createObjectURL(blob);
                    body._blobUrl = blobUrl;
                    if (imageTypes.includes(fileType)) {
                        body.innerHTML = '<div class="d-flex align-items-center justify-content-center p-3" style="min-height:70vh;"><img src="' + blobUrl + '" style="max-width:100%;max-height:80vh;object-fit:contain;" /></div>';
                    } else {
                        body.innerHTML = '<video controls class="w-100 d-block" style="max-height:80vh;background:#000;"><source src="' + blobUrl + '" /></video>';
                    }
                })
                .catch(function() {
                    body.innerHTML =
                        '<div class="text-center p-5">' +
                        '<i class="bi bi-exclamation-triangle display-1 text-warning d-block mb-3"></i>' +
                        '<p class="text-muted mb-4">Impossibile caricare l\'anteprima.<br>Prova a scaricare il file.</p>' +
                        '<a href="' + downloadUrl + '" class="btn btn-bocconi"><i class="bi bi-download me-2"></i>Scarica</a></div>';
                });
        } else {
            body.innerHTML = '<div class="text-center p-5"><i class="bi bi-file-earmark-text display-1 text-muted d-block mb-3"></i><p class="text-muted mb-4">Anteprima non disponibile per i file <strong>.' + fileType + '</strong>.<br>Scarica il file per visualizzarlo.</p><a href="' + downloadUrl + '" class="btn btn-bocconi"><i class="bi bi-download me-2"></i>Scarica</a></div>';
        }
    });

    document.getElementById('previewModal').addEventListener('hidden.bs.modal', function () {
        var body = document.getElementById('previewModalBody');
        if (body._blobUrl) { URL.revokeObjectURL(body._blobUrl); body._blobUrl = null; }
        if (body._pdfDoc) { body._pdfDoc.destroy(); body._pdfDoc = null; }
        body.innerHTML = '';
    });
})();
</script>
}
