@model BocconiLMS.Models.Material
@{
    ViewData["Title"] = Model.Title;
    var versions = ViewBag.Versions as List<BocconiLMS.Models.MaterialVersion> ?? new();
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">@T["mat.nav","Materials"]</a></li>
        <li class="breadcrumb-item active">@Model.Title</li>
    </ol>
</nav>

<div class="row">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <h2 class="fw-bold">@Model.Title</h2>
            @if (User.IsInRole("Teacher") || User.IsInRole("Admin"))
            {
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-pencil me-1"></i>@T["common.edit","Edit"]
                    </a>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                data-confirm="@T["common.delete","Delete"] «@Model.Title»?"
                                title="@T["common.delete","Delete"]">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>
            }
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold"><i class="bi bi-clock-history me-2"></i>@T["mat.versions","Versions"] (@versions.Count)</span>
            </div>
            <div class="card-body p-0">
                @if (!versions.Any())
                {
                    <p class="text-muted p-3 mb-0">@T["mat.no_files","No file uploaded yet."]</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var v in versions)
                        {
                            <div class="list-group-item @(v.IsActive ? "bg-light" : "")">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="version-badge">v@(v.VersionNumber)</span>
                                        @if (v.IsActive)
                                        {
                                            <span class="badge bg-success">@T["mat.version_active","Active"]</span>
                                        }
                                        <div>
                                            <div class="fw-semibold small">@v.FileName</div>
                                            <div class="text-muted" style="font-size:.75rem;">
                                                @v.FileSizeFormatted &middot;
                                                @v.UploadedAt.ToString("dd/MM/yyyy HH:mm") &middot;
                                                @v.UploaderName
                                            </div>
                                            @if (!string.IsNullOrEmpty(v.Notes))
                                            {
                                                <div class="text-secondary fst-italic" style="font-size:.75rem;">@v.Notes</div>
                                            }
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-info btn-preview"
                                                data-version-id="@v.Id"
                                                data-file-type="@v.FileType"
                                                data-file-name="@v.FileName"
                                                title="Anteprima">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <a asp-action="Download" asp-route-versionId="@v.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="@T["mat.download_btn","Download"]">
                                            <i class="bi bi-download"></i>
                                        </a>
                                        @if (!v.IsActive && (User.IsInRole("Teacher") || User.IsInRole("Admin")))
                                        {
                                            <form asp-action="Restore" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="materialId" value="@Model.Id" />
                                                <input type="hidden" name="versionId" value="@v.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-warning"
                                                        data-confirm="@T["mat.restore_confirm","Restore version"] v@(v.VersionNumber)?"
                                                        title="@T["mat.restore_btn","Restore"]">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @if (User.IsInRole("Teacher") || User.IsInRole("Admin"))
        {
            <div class="card">
                <div class="card-header fw-semibold">
                    <i class="bi bi-upload me-2"></i>@T["mat.upload_version","Upload new version"]
                </div>
                <div class="card-body">
                    <form asp-action="UploadVersion" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="row g-2 align-items-end">
                            <div class="col-md-5">
                                <label class="form-label small fw-semibold">@T["mat.label_file","File"]</label>
                                <div class="input-group input-group-sm">
                                    <label for="fileUploadDetails" class="btn btn-outline-secondary btn-sm mb-0">
                                        <i class="bi bi-folder2-open me-1"></i>@T["mat.choose_file","Choose file"]
                                    </label>
                                    <span class="form-control text-muted text-truncate"
                                          id="fileNameDetails"
                                          data-placeholder="@T["mat.no_file_chosen","No file chosen"]">@T["mat.no_file_chosen","No file chosen"]</span>
                                    <input type="file" name="file" id="fileUploadDetails" class="d-none" required
                                           onchange="bocconiFileInput(this,'fileNameDetails')" />
                                </div>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label small fw-semibold">@T["mat.notes","Notes"]</label>
                                <input type="text" name="notes" class="form-control form-control-sm"
                                       placeholder="@T["mat.notes_placeholder","What changed?"]" />
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-bocconi btn-sm w-100">
                                    <i class="bi bi-upload me-1"></i>@T["mat.upload_btn","Upload"]
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h6 class="fw-semibold mb-3"><i class="bi bi-info-circle me-1"></i>@T["mat.info_panel","Information"]</h6>
                @{
                    var (stCss, stLabel) = Model.Status switch {
                        "verificato"   => ("success",   T["mat.status_verificato","Verified"]),
                        "in_revisione" => ("warning",   T["mat.status_in_revisione","In review"]),
                        _              => ("secondary", T["mat.status_bozza","Draft"])
                    };
                }
                <dl class="row mb-0 small">
                    <dt class="col-5 text-muted">@T["mat.col_type","Type"]</dt>
                    <dd class="col-7">@(string.IsNullOrEmpty(Model.DocumentTypeName) ? "—" : Model.DocumentTypeName)</dd>
                    <dt class="col-5 text-muted">@T["mat.col_lang","Language"]</dt>
                    <dd class="col-7">@Model.Language</dd>
                    <dt class="col-5 text-muted">@T["mat.col_author","Author"]</dt>
                    <dd class="col-7">@(string.IsNullOrEmpty(Model.AuthorName) ? "—" : Model.AuthorName)</dd>
                    <dt class="col-5 text-muted">@T["mat.label_owner","Responsible (system)"]</dt>
                    <dd class="col-7">@(string.IsNullOrEmpty(Model.OwnerName) ? "—" : Model.OwnerName)</dd>
                    <dt class="col-5 text-muted">@T["mat.col_status","Status"]</dt>
                    <dd class="col-7"><span class="badge bg-@stCss">@stLabel</span></dd>
                    @if (Model.Status == "verificato")
                    {
                        <dt class="col-5 text-muted">@T["mat.col_protocol","Protocollo"]</dt>
                        <dd class="col-7">
                            @if (!string.IsNullOrEmpty(Model.ProtocolNumber))
                            {
                                <code class="text-success fw-semibold">@Model.ProtocolNumber</code>
                            }
                            else
                            {
                                <span class="text-muted fst-italic" style="font-size:.8rem;">—</span>
                            }
                        </dd>
                        <dt class="col-5 text-muted">@T["mat.label_folder","Cartella"]</dt>
                        <dd class="col-7">
                            @if (!string.IsNullOrEmpty(Model.Folder))
                            {
                                <span>@Model.Folder</span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic" style="font-size:.8rem;">—</span>
                            }
                        </dd>
                    }
                    <dt class="col-5 text-muted">@T["mat.col_version","Ver."]</dt>
                    <dd class="col-7">
                        @if (Model.CurrentVersion > 0)
                        { <span class="version-badge">v@(Model.CurrentVersion)</span> }
                        else { <span class="text-muted">—</span> }
                    </dd>
                    <dt class="col-5 text-muted">@T["mat.col_created","Created"]</dt>
                    <dd class="col-7">@Model.CreatedAt.ToString("dd/MM/yyyy")</dd>
                </dl>
                <hr />
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="bi bi-arrow-left me-1"></i>@T["mat.back","Back to Materials"]
                </a>
            </div>
        </div>
    </div>
</div>

@* ── Modal anteprima file ─────────────────────────────────────────── *@
<div class="modal fade" id="previewModal" tabindex="-1" aria-labelledby="previewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title fw-semibold text-truncate me-3" id="previewModalLabel" style="max-width:75%;"></h6>
                <div class="d-flex gap-2 ms-auto align-items-center">
                    <a href="#" id="previewDownloadBtn" class="btn btn-sm btn-outline-primary" title="Download">
                        <i class="bi bi-download"></i>
                    </a>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
            </div>
            <div class="modal-body p-0" id="previewModalBody" style="min-height:70vh; background:#f5f5f5;"></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var imageTypes = ['PNG','JPG','JPEG','GIF','SVG','BMP','WEBP'];
    var videoTypes = ['MP4','WEBM','MOV','AVI','MKV'];

    document.addEventListener('click', function (e) {
        var btn = e.target.closest('.btn-preview');
        if (!btn) return;
        e.preventDefault();
        var versionId  = btn.dataset.versionId;
        var fileType   = (btn.dataset.fileType || '').toUpperCase();
        var fileName   = btn.dataset.fileName || '';
        var previewUrl  = '/Materials/Preview/' + versionId;
        var downloadUrl = '/Materials/Download/' + versionId;

        document.getElementById('previewModalLabel').textContent = fileName;
        document.getElementById('previewDownloadBtn').href = downloadUrl;

        var body = document.getElementById('previewModalBody');
        if (fileType === 'PDF') {
            body.innerHTML = '<iframe src="' + previewUrl + '" style="width:100%;height:80vh;border:none;display:block;"></iframe>';
        } else if (imageTypes.includes(fileType)) {
            body.innerHTML = '<div class="d-flex align-items-center justify-content-center p-3" style="min-height:70vh;"><img src="' + previewUrl + '" style="max-width:100%;max-height:80vh;object-fit:contain;" /></div>';
        } else if (videoTypes.includes(fileType)) {
            body.innerHTML = '<video controls class="w-100 d-block" style="max-height:80vh;background:#000;"><source src="' + previewUrl + '" /></video>';
        } else {
            body.innerHTML = '<div class="text-center p-5"><i class="bi bi-file-earmark-text display-1 text-muted d-block mb-3"></i><p class="text-muted mb-4">Anteprima non disponibile per i file <strong>.' + fileType + '</strong>.<br>Scarica il file per visualizzarlo.</p><a href="' + downloadUrl + '" class="btn btn-bocconi"><i class="bi bi-download me-2"></i>Scarica</a></div>';
        }
        bootstrap.Modal.getOrCreate(document.getElementById('previewModal')).show();
    });

    document.getElementById('previewModal').addEventListener('hidden.bs.modal', function () {
        document.getElementById('previewModalBody').innerHTML = '';
    });
})();
</script>
}
