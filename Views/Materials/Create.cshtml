@model MaterialFormViewModel
@{
    ViewData["Title"] = T["mat.create_title"];
    var docTypes        = ViewBag.DocumentTypes as List<BocconiLMS.Models.DocumentType> ?? new();
    var languages       = ViewBag.Languages as string[] ?? BocconiLMS.Models.Material.Languages;
    var owners          = ViewBag.AvailableOwners as List<BocconiLMS.Models.User> ?? new();
    var existingAuthors = ViewBag.ExistingAuthors as List<string> ?? new();
    var currentOwnerName= ViewBag.CurrentUserFullName as string ?? "";
    var availableAreas  = ViewBag.AvailableAreas as List<BocconiLMS.Models.Area> ?? new();
    var existingFolders = ViewBag.ExistingFolders as List<BocconiLMS.Models.MaterialFolder> ?? new();
    bool canSetStatus   = ViewBag.CanSetStatus == true;
    bool formLocked     = string.IsNullOrEmpty(Model.Title);
    bool needsReupload  = !formLocked; // POST ritornato: titolo presente ma file perso
}


<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-bocconi text-white">
                <h5 class="mb-0"><i class="bi bi-file-earmark-plus me-2"></i>@T["mat.create_title"]</h5>
            </div>
            <div class="card-body">
                <form id="matForm" asp-action="Create" method="post" enctype="multipart/form-data"
                      data-has-protocol="false" data-has-folder="false">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="FolderId" id="hidFolderId" />
                    <input type="hidden" asp-for="FolderName" id="hidFolderName" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" id="valSummary"></div>

                    @* ── SEZIONE FILE (sempre attiva) ─────────────────────── *@

                    @* Stato: nessun file — pulsante grande di caricamento *@
                    <div id="noFileState">
                        @if (needsReupload)
                        {
                            <div class="alert alert-warning py-2 mb-3">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                @T["mat.file_lost_warn"]
                            </div>
                        }
                        <div id="uploadDropZone"
                             class="text-center py-3 mb-3 border rounded-3 bg-light"
                             style="border: 2px dashed #ccc !important; cursor: pointer;">
                            <i class="bi bi-cloud-upload text-bocconi" style="font-size: 1.8rem;"></i>
                            <div class="mt-2">
                                <label for="File" class="btn btn-bocconi px-4" style="cursor:pointer">
                                    <i class="bi bi-upload me-2"></i>@T["mat.upload_document"]
                                </label>
                            </div>
                            <p class="text-muted small mt-2 mb-0">
                                @T["mat.upload_hint"]
                            </p>
                        </div>
                    </div>

                    @* Stato: file selezionato — info file *@
                    <div id="hasFileState" class="d-none mb-3">
                        <div class="d-flex align-items-center gap-3 p-3 border rounded-3 bg-light">
                            <i id="fileTypeIcon" class="bi bi-file-earmark-text fs-2 text-bocconi flex-shrink-0"></i>
                            <div class="flex-grow-1" style="min-width:0">
                                <div class="fw-semibold text-truncate" id="fileNameDisplay"></div>
                                <div class="text-muted small mt-1">
                                    <span id="fileSizeDisplay"></span>
                                    <span id="pageCountDisplay" class="ms-2 fw-semibold text-bocconi"></span>
                                </div>
                            </div>
                            <button type="button" id="removeFileBtn"
                                    class="btn btn-sm btn-outline-secondary flex-shrink-0"
                                    title="@T["mat.remove_file"]">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                        <div id="convertPdfBox" class="alert alert-warning d-none py-2 mt-2 mb-0">
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox"
                                       id="ConvertToPdf" name="ConvertToPdf" value="true" />
                                <label class="form-check-label fw-semibold" for="ConvertToPdf">
                                    <i class="bi bi-file-earmark-pdf me-1"></i>@T["mat.convert_to_pdf"]
                                </label>
                            </div>
                        </div>
                    </div>

                    @* Input file nascosto *@
                    <input asp-for="File" type="file" class="d-none" id="File"
                           onchange="matFileChanged(this)" />
                    <span asp-validation-for="File" class="text-danger small"></span>

                    <hr id="formFieldsSep" class="@(formLocked && !needsReupload ? "d-none" : "")" />

                    @* ── CAMPI DEL FORM (bloccati fino al caricamento del file) *@

                    <div class="row mb-3 g-2 align-items-start">
                        <div class="col-md-4">
                            <label asp-for="AuthorName" class="form-label fw-semibold">
                                @T["mat.label_author"] <span class="text-danger">*</span>
                            </label>
                            <div class="position-relative">
                                <input asp-for="AuthorName" id="authorInput" class="form-control"
                                       placeholder="@T["mat.author_placeholder"]"
                                       autocomplete="off"
                                       data-lockable />
                                <ul id="authorDropdown"
                                    class="dropdown-menu w-100 shadow-sm py-1"
                                    style="max-height:200px;overflow-y:auto;display:none;position:absolute;z-index:1055"></ul>
                            </div>
                            <span asp-validation-for="AuthorName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Title" class="form-label fw-semibold">
                                @T["mat.label_title"] <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Title" id="matTitle" class="form-control"
                                   placeholder="@T["mat.title_placeholder"]"
                                   data-lockable />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                            <div id="similarTitlesWarn" class="d-none mt-2">
                                <div class="alert alert-warning py-2 mb-0 small">
                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                    <strong>@T["mat.similar_titles_found"]</strong>
                                    <ul id="similarTitlesList" class="mb-0 mt-1 ps-3"></ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3 g-2 align-items-start">
                        <div class="col-md-8">
                            <label asp-for="DocumentTypeId" class="form-label fw-semibold">
                                @T["mat.label_doctype"] <span class="text-danger">*</span>
                            </label>
                            <select asp-for="DocumentTypeId" class="form-select" data-lockable>
                                <option value="">@T["mat.select_type"]</option>
                                @foreach (var t in docTypes)
                                {
                                    <option value="@t.Id">@t.Name</option>
                                }
                            </select>
                            <span asp-validation-for="DocumentTypeId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Language" class="form-label fw-semibold">
                                @T["mat.label_language"] <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Language" id="langSelect" class="form-select" data-lockable>
                                @foreach (var l in languages)
                                {
                                    <option value="@l">@l</option>
                                }
                            </select>
                            <span asp-validation-for="Language" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-semibold">@T["mat.label_status"]</label>
                        @if (canSetStatus)
                        {
                            <select asp-for="Status" id="statusSelect" class="form-select" data-lockable>
                                <option value="draft"        selected="@(Model.Status=="draft"?"selected":null)">@T["mat.status_bozza"]</option>
                                <option value="under_review" selected="@(Model.Status=="under_review"?"selected":null)">@T["mat.status_in_revisione"]</option>
                                <option value="verified"     selected="@(Model.Status=="verified"?"selected":null)">@T["mat.status_verificato"]</option>
                            </select>
                        }
                        else
                        {
                            <input type="hidden" id="statusSelect" name="Status" value="draft" />
                            <input type="text" class="form-control bg-light" readonly
                                   value="@T["mat.status_bozza"]" />
                        }
                    </div>

                    @if (availableAreas.Any())
                    {
                        <div class="row mb-3 g-2">
                            <div class="col-md-6">
                                <label asp-for="AreaId" class="form-label fw-semibold">
                                    @T["mat.label_area"] <span class="text-danger">*</span>
                                </label>
                                <select asp-for="AreaId" class="form-select" data-lockable>
                                    <option value="">@T["mat.select_area"]</option>
                                    @foreach (var ar in availableAreas)
                                    {
                                        <option value="@ar.Id">@ar.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="AreaId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CatalogationDate" class="form-label fw-semibold">
                                    @T["mat.label_cat_date"] <span class="text-danger">*</span>
                                </label>
                                <input asp-for="CatalogationDate" type="date" class="form-control"
                                       value="@(Model.CatalogationDate.HasValue ? Model.CatalogationDate.Value.ToString("yyyy-MM-dd") : "")"
                                       data-lockable />
                                <span asp-validation-for="CatalogationDate" class="text-danger small"></span>
                            </div>
                        </div>
                    }

                    <div class="row mb-3 g-2">
                        <div class="col-md-3">
                            <label asp-for="PageCount" class="form-label fw-semibold">
                                @T["mat.label_page_count"]
                            </label>
                            <input asp-for="PageCount" id="pageCountInput" type="number" min="1"
                                   class="form-control" placeholder="—"
                                   data-lockable />
                        </div>
                        <div class="col-md-9">
                            <label asp-for="Notes" class="form-label fw-semibold">@T["mat.label_notes"]</label>
                            <textarea asp-for="Notes" class="form-control" rows="3"
                                      placeholder="@T["mat.notes_file_placeholder"]"
                                      data-lockable></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x me-1"></i>@T["mat.cancel"]
                        </a>
                        <button type="button" id="submitBtn" class="btn btn-bocconi">
                            <i class="bi bi-check-lg me-1"></i>@T["mat.create_btn"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@* ── Modale Verificato ──────────────────────────────────────────────── *@
<div class="modal fade" id="verifiedModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success bg-opacity-10 border-success">
                <h5 class="modal-title text-success">
                    <i class="bi bi-shield-check me-2"></i>@T["mat.verified_modal_title"]
                </h5>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">@T["mat.verified_modal_hint"]</p>
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-hash me-1"></i>@T["mat.protocol_number"]
                    </label>
                    <div class="d-flex align-items-center gap-2 px-3 py-2 rounded border bg-light text-muted small">
                        <i class="bi bi-magic"></i>
                        <span>@T["mat.protocol_auto"]</span>
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-folder2 me-1"></i>@T["mat.label_folder"] <span class="text-danger">*</span>
                    </label>
                    <div class="input-group input-group-sm mb-1">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="folderSearch" class="form-control border-start-0 ps-0"
                               placeholder="@T["mat.folder_filter"]"
                               autocomplete="off" />
                    </div>
                    <div id="folderList"
                         class="overflow-auto border rounded bg-white"
                         style="max-height:180px; min-height:38px"></div>
                    <div id="newFolderInputGroup" class="input-group input-group-sm mt-1 d-none">
                        <span class="input-group-text fw-bold text-secondary" id="folderPrefixBadge" style="min-width:3rem;justify-content:center">IT</span>
                        <span class="input-group-text border-start-0 px-1 text-muted">–</span>
                        <input type="text" id="newFolderInput" class="form-control"
                               placeholder="@T["mat.folder_new_placeholder"]"
                               maxlength="120" autocomplete="off" />
                    </div>
                    <div id="folderError" class="text-danger small d-none mt-1">
                        @T["mat.folder_required"]
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" id="modalCancelBtn">
                    @T["common.cancel"]
                </button>
                <button type="button" class="btn btn-success" id="modalConfirmBtn">
                    <i class="bi bi-check-lg me-1"></i>@T["mat.modal_confirm"]
                </button>
            </div>
        </div>
    </div>
</div>

<div id="folderMap" data-folders="@System.Text.Json.JsonSerializer.Serialize(existingFolders.Select(f => new { f.Id, f.Name }))"></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        // ── Inizializzazione stato form ────────────────────────────────────
        var FORM_LOCKED_INIT  = @(formLocked ? "true" : "false");
        var NEEDS_REUPLOAD    = @(needsReupload ? "true" : "false");
        var OFFICE_EXTS = ['doc','docx','ppt','pptx'];
        var ZIP_EXTS    = ['docx','pptx','xlsx'];
        var LANG_PREFIX = {
            'Italiano':'IT','Inglese':'EN','Francese':'FR','Tedesco':'DE',
            'Spagnolo':'ES','Russo':'RU','Cinese':'ZH','Arabo':'AR',
            'Portoghese':'PT','Altro':'XX'
        };
        var FILE_ICONS = {
            'pdf':'bi-file-earmark-pdf text-danger',
            'doc':'bi-file-earmark-word text-primary',
            'docx':'bi-file-earmark-word text-primary',
            'ppt':'bi-file-earmark-slides text-warning',
            'pptx':'bi-file-earmark-slides text-warning',
            'xls':'bi-file-earmark-spreadsheet text-success',
            'xlsx':'bi-file-earmark-spreadsheet text-success',
            'jpg':'bi-file-earmark-image text-info',
            'jpeg':'bi-file-earmark-image text-info',
            'png':'bi-file-earmark-image text-info'
        };
        // Stringhe tradotte per uso in JS (Json.Serialize evita problemi di encoding HTML nelle property textContent)
        var _t = {
            fileRequired:    @Json.Serialize(T["mat.file_required_warn"]),
            titleRequired:   @Json.Serialize(T["mat.title_required"]),
            doctypeRequired: @Json.Serialize(T["mat.doctype_required"]),
            pages:           @Json.Serialize(T["mat.pages"]),
            slides:          @Json.Serialize(T["mat.slides"])
        };

        // Valida la summary di ModelState
        (function () {
            var summary = document.getElementById('valSummary');
            if (summary && summary.querySelectorAll('li').length > 0)
                summary.classList.remove('d-none');
        })();

        // Blocca / sblocca tutti i campi data-lockable
        function lockForm() {
            document.querySelectorAll('[data-lockable]').forEach(function (el) {
                el.disabled = true;
            });
            document.getElementById('formFieldsSep').classList.add('d-none');
        }
        function unlockForm() {
            document.querySelectorAll('[data-lockable]').forEach(function (el) {
                el.disabled = false;
            });
            document.getElementById('formFieldsSep').classList.remove('d-none');
        }

        // Inizializzazione: blocca se form è in stato "vuoto"
        if (FORM_LOCKED_INIT) lockForm();

        // ── Modale Verificato ─────────────────────────────────────────────
        var verifiedModal = new bootstrap.Modal(document.getElementById('verifiedModal'));
        var folderMap = [];
        try { folderMap = JSON.parse(document.getElementById('folderMap').dataset.folders); } catch(e){}

        var _selectedFolderId   = null;   // ID cartella esistente selezionata
        var _selectedFolderName = null;   // nome (solo se esistente, per display)
        var _selectedIsNew      = false;  // è selezionata la riga "Nuova cartella"

        var _tNewFolder = @Json.Serialize(T["mat.folder_new"]);

        function folderListBuild(filter) {
            var list = document.getElementById('folderList');
            list.innerHTML = '';
            var term = (filter || '').toLowerCase();
            var filtered = folderMap.filter(function(f) {
                return !term || f.Name.toLowerCase().indexOf(term) !== -1;
            });
            if (filtered.length === 0 && !term) {
                // nessuna cartella ancora — mostra solo "nuova"
            }
            filtered.forEach(function(f) {
                var btn = document.createElement('button');
                btn.type = 'button';
                var active = (_selectedFolderId === f.Id && !_selectedIsNew);
                btn.className = 'list-group-item list-group-item-action py-1 px-2 small border-0' + (active ? ' active' : '');
                btn.innerHTML = '<i class="bi bi-folder me-1"></i>' + escHtml(f.Name);
                btn.addEventListener('click', function() {
                    _selectedFolderId   = f.Id;
                    _selectedFolderName = f.Name;
                    _selectedIsNew      = false;
                    document.getElementById('newFolderInput').classList.add('d-none');
                    document.getElementById('newFolderInput').value = '';
                    document.getElementById('folderError').classList.add('d-none');
                    folderListBuild(document.getElementById('folderSearch').value);
                });
                list.appendChild(btn);
            });
            // Riga "Nuova cartella"
            var newBtn = document.createElement('button');
            newBtn.type = 'button';
            newBtn.className = 'list-group-item list-group-item-action py-1 px-2 small border-0 text-primary fw-semibold' +
                               (_selectedIsNew ? ' active text-white' : '');
            newBtn.innerHTML = _tNewFolder;
            newBtn.addEventListener('click', function() {
                _selectedFolderId   = null;
                _selectedFolderName = null;
                _selectedIsNew      = true;
                document.getElementById('newFolderInputGroup').classList.remove('d-none');
                document.getElementById('newFolderInput').focus();
                document.getElementById('folderError').classList.add('d-none');
                folderListBuild(document.getElementById('folderSearch').value);
            });
            list.appendChild(newBtn);
        }
        function escHtml(s) {
            return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }
        document.getElementById('folderSearch').addEventListener('input', function() {
            folderListBuild(this.value);
        });

        function langPrefix() {
            var el = document.getElementById('langSelect');
            return el ? (LANG_PREFIX[el.value] || 'XX') : 'XX';
        }
        function needsModal() {
            var sel = document.getElementById('statusSelect');
            return sel ? sel.value === 'verified' : false;
        }
        function openVerifiedModal() {
            // Reset selezione
            _selectedFolderId   = null;
            _selectedFolderName = null;
            _selectedIsNew      = false;
            document.getElementById('folderSearch').value = '';
            document.getElementById('newFolderInputGroup').classList.add('d-none');
            document.getElementById('newFolderInput').value = '';
            document.getElementById('folderError').classList.add('d-none');
            document.getElementById('folderPrefixBadge').textContent = langPrefix();
            folderListBuild('');
            verifiedModal.show();
            setTimeout(function() { document.getElementById('folderSearch').focus(); }, 300);
        }

        // ── Helpers validazione client-side ──────────────────────────────
        function setFieldError(inputEl, spanEl, message) {
            if (inputEl) inputEl.classList.add('is-invalid');
            if (spanEl)  { spanEl.textContent = message; spanEl.style.display = 'block'; }
        }
        function clearFieldError(inputEl, spanEl) {
            if (inputEl) inputEl.classList.remove('is-invalid');
            if (spanEl)  { spanEl.textContent = ''; spanEl.style.display = ''; }
        }

        var titleInp  = document.getElementById('matTitle');
        var titleSpan = document.querySelector('span[data-valmsg-for="Title"]');
        var dtSelect  = document.querySelector('select[name="DocumentTypeId"]');
        var dtSpan    = document.querySelector('span[data-valmsg-for="DocumentTypeId"]');

        // Pulisce errore live mentre l'utente corregge
        if (titleInp) titleInp.addEventListener('input', function() { clearFieldError(titleInp, titleSpan); });
        if (dtSelect) dtSelect.addEventListener('change', function() { clearFieldError(dtSelect, dtSpan); });

        document.getElementById('submitBtn').addEventListener('click', function() {
            var hasError = false;

            // 1. Verifica file
            var fileInp = document.getElementById('File');
            if (!fileInp.files || fileInp.files.length === 0) {
                var dropZone = document.getElementById('uploadDropZone');
                dropZone.style.borderColor = '#dc3545';
                dropZone.style.backgroundColor = '#fff5f5';
                var warn = document.getElementById('noFileUploadWarn');
                if (!warn) {
                    warn = document.createElement('p');
                    warn.id = 'noFileUploadWarn';
                    warn.className = 'text-danger small mt-2 mb-0 fw-semibold';
                    warn.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i>' + _t.fileRequired;
                    dropZone.appendChild(warn);
                }
                hasError = true;
            }

            // 2. Verifica Titolo
            if (!titleInp || !titleInp.value.trim()) {
                setFieldError(titleInp, titleSpan, _t.titleRequired);
                hasError = true;
            } else {
                clearFieldError(titleInp, titleSpan);
            }

            // 3. Verifica Tipo Documento
            if (!dtSelect || !dtSelect.value) {
                setFieldError(dtSelect, dtSpan, _t.doctypeRequired);
                hasError = true;
            } else {
                clearFieldError(dtSelect, dtSpan);
            }

            if (hasError) {
                // Scrolla al primo campo in errore
                var firstErr = document.querySelector('.is-invalid') || document.getElementById('noFileUploadWarn');
                if (firstErr) firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return; // blocca il submit — file preservato
            }

            if (needsModal()) {
                openVerifiedModal();
            } else {
                document.getElementById('hidFolderId').value = '';
                document.getElementById('hidFolderName').value = '';
                document.getElementById('matForm').submit();
            }
        });

        document.getElementById('modalConfirmBtn').addEventListener('click', function() {
            var errEl = document.getElementById('folderError');
            if (_selectedFolderId && !_selectedIsNew) {
                // Cartella esistente selezionata
                document.getElementById('hidFolderId').value = _selectedFolderId;
                document.getElementById('hidFolderName').value = '';
            } else if (_selectedIsNew) {
                var newName = (document.getElementById('newFolderInput').value || '').trim();
                if (!newName) {
                    errEl.classList.remove('d-none');
                    document.getElementById('newFolderInput').focus();
                    return;
                }
                var prefix = langPrefix();
                document.getElementById('hidFolderId').value = '';
                document.getElementById('hidFolderName').value = prefix + ' \u2013 ' + newName;
            } else {
                errEl.classList.remove('d-none');
                return;
            }
            verifiedModal.hide();
            document.getElementById('matForm').submit();
        });

        document.getElementById('modalCancelBtn').addEventListener('click', function() {
            var sel = document.getElementById('statusSelect');
            if (sel) sel.value = 'under_review';
            verifiedModal.hide();
        });

        // ── Rimozione file ─────────────────────────────────────────────────
        document.getElementById('removeFileBtn').addEventListener('click', function() {
            var fileInp = document.getElementById('File');
            fileInp.value = '';
            document.getElementById('noFileState').classList.remove('d-none');
            document.getElementById('hasFileState').classList.add('d-none');
            document.getElementById('convertPdfBox').classList.add('d-none');
            document.getElementById('ConvertToPdf').checked = false;
            document.getElementById('pageCountDisplay').textContent = '';
            var pgInp = document.getElementById('pageCountInput');
            if (pgInp) pgInp.value = '';
            hideSimilarTitles();
            // Azzera i campi auto-popolati dal file
            var tInp  = document.getElementById('matTitle');
            var tSpan = document.querySelector('span[data-valmsg-for="Title"]');
            var aInp  = document.querySelector('input[name="AuthorName"]');
            var aSpan = document.querySelector('span[data-valmsg-for="AuthorName"]');
            if (tInp)  tInp.value  = '';
            if (aInp)  aInp.value  = '';
            clearFieldError(tInp, tSpan);
            clearFieldError(aInp, aSpan);
            // Se i campi erano già compilati (ritorno da POST), non li blocchiamo
            if (!NEEDS_REUPLOAD) lockForm();
        });

        // ── Titoli simili ─────────────────────────────────────────────────
        function hideSimilarTitles() {
            document.getElementById('similarTitlesWarn').classList.add('d-none');
            document.getElementById('similarTitlesList').innerHTML = '';
        }
        function showSimilarTitles(items) {
            var list = document.getElementById('similarTitlesList');
            list.innerHTML = '';
            items.forEach(function(m) {
                var li = document.createElement('li');
                var a = document.createElement('a');
                a.href = '@Url.Action("Details","Materials")?id=' + m.id;
                a.target = '_blank';
                a.textContent = m.title;
                li.appendChild(a);
                list.appendChild(li);
            });
            document.getElementById('similarTitlesWarn').classList.remove('d-none');
        }
        var titleCheckTimer = null;
        async function checkSimilarTitles(title) {
            if (!title || title.trim().length < 3) { hideSimilarTitles(); return; }
            try {
                var url = '@Url.Action("CheckSimilarTitles","Materials")' + '?title=' + encodeURIComponent(title.trim());
                var resp = await fetch(url, {headers:{'X-Requested-With':'XMLHttpRequest'}});
                var data = await resp.json();
                if (data && data.length > 0) showSimilarTitles(data);
                else hideSimilarTitles();
            } catch(e) { hideSimilarTitles(); }
        }

        document.getElementById('matTitle').addEventListener('input', function() {
            clearTimeout(titleCheckTimer);
            titleCheckTimer = setTimeout(function() {
                checkSimilarTitles(document.getElementById('matTitle').value);
            }, 600);
        });

        // ── Estrazione metadati da file Office (JSZip) ────────────────────
        function extractOfficeAuthor(file) {
            if (typeof JSZip === 'undefined') return Promise.resolve(null);
            return JSZip.loadAsync(file).then(function(zip) {
                var entry = zip.file('docProps/core.xml');
                if (!entry) return null;
                return entry.async('string').then(function(xml) {
                    var m = xml.match(/<dc:creator[^>]*>([\s\S]*?)<\/dc:creator>/);
                    return (m && m[1].trim()) ? m[1].trim() : null;
                });
            }).catch(function() { return null; });
        }

        function extractPageCount(file) {
            var ext = file.name.split('.').pop().toLowerCase();
            if (ext === 'pdf') {
                return extractPdfMetadata(file).then(function(meta) {
                    if (!meta || !meta.pageCount) return null;
                    return { count: meta.pageCount, unit: _t.pages };
                });
            }
            if (typeof JSZip === 'undefined') return Promise.resolve(null);
            if (['docx','pptx'].indexOf(ext) === -1) return Promise.resolve(null);
            return JSZip.loadAsync(file).then(function(zip) {
                var entry = zip.file('docProps/app.xml');
                if (!entry) return null;
                return entry.async('string').then(function(xml) {
                    var mp = xml.match(/<Pages>(\d+)<\/Pages>/);
                    if (mp) return { count: parseInt(mp[1]), unit: _t.pages };
                    var ms = xml.match(/<Slides>(\d+)<\/Slides>/);
                    if (ms) return { count: parseInt(ms[1]), unit: _t.slides };
                    return null;
                });
            }).catch(function() { return null; });
        }

        // Configura il worker di pdf.js (necessario per parsing fuori dal main thread)
        if (window.pdfjsLib) {
            window.pdfjsLib.GlobalWorkerOptions.workerSrc =
                'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
        }

        // Estrazione metadati PDF con pdf.js (fallback a regex sui primi 64 KB)
        function extractPdfMetadata(file) {
            // ── Tentativo 1: pdf.js (legge xref/trailer → metadati completi) ─
            if (window.pdfjsLib) {
                return file.arrayBuffer().then(function(ab) {
                    return window.pdfjsLib.getDocument({ data: ab }).promise;
                }).then(function(pdf) {
                    var numPages = pdf.numPages;
                    return pdf.getMetadata().then(function(meta) {
                        var author = null;
                        if (meta && meta.info) {
                            author = (meta.info.Author || meta.info.author || '').trim() || null;
                        }
                        if (!author && meta && meta.metadata) {
                            try {
                                var raw = meta.metadata.getRaw ? meta.metadata.getRaw() : '';
                                var mXmp = raw.match(/<dc:creator[\s\S]{0,400}?<rdf:li[^>]*>([\s\S]*?)<\/rdf:li>/);
                                if (mXmp && mXmp[1].trim()) author = mXmp[1].trim();
                            } catch(e) {}
                        }
                        return { author: author, pageCount: numPages };
                    }).catch(function() {
                        return { author: null, pageCount: numPages };
                    });
                }).catch(function() {
                    return _extractPdfFallback(file);
                });
            }
            // ── Tentativo 2 (fallback): regex sui primi 64 KB ────────────────
            return _extractPdfFallback(file);
        }

        function _extractPdfFallback(file) {
            return new Promise(function(resolve) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    try {
                        var text = e.target.result;
                        var author = null;
                        var mAuth = text.match(/\/Author\s*\(([^)\\]*(?:\\.[^)\\]*)*)\)/);
                        if (mAuth && mAuth[1].trim()) author = mAuth[1].trim();
                        if (!author) {
                            var mXmp = text.match(/<dc:creator[\s\S]{0,200}?<rdf:li[^>]*>([\s\S]*?)<\/rdf:li>/);
                            if (mXmp && mXmp[1].trim()) author = mXmp[1].trim();
                        }
                        var pageCount = null;
                        var mPg = text.match(/\/Type\s*\/Pages[\s\S]{0,300}?\/Count\s+(\d+)/);
                        if (mPg) {
                            pageCount = parseInt(mPg[1]);
                        } else {
                            var all = [], re = /\/Count\s+(\d+)/g, mc;
                            while ((mc = re.exec(text)) !== null) all.push(parseInt(mc[1]));
                            if (all.length) pageCount = Math.max.apply(null, all);
                        }
                        resolve({ author: author, pageCount: pageCount });
                    } catch(err) { resolve(null); }
                };
                reader.onerror = function() { resolve(null); };
                reader.readAsText(file.slice(0, 65536), 'windows-1252');
            });
        }

        function formatBytes(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / 1048576).toFixed(1) + ' MB';
        }

        // ── Cambio file ───────────────────────────────────────────────────
        function matFileChanged(inp) {
            if (!inp.files || inp.files.length === 0) return;
            var file = inp.files[0];
            var ext  = file.name.split('.').pop().toLowerCase();
            var nameNoExt = file.name.replace(/\.[^.]+$/, '');

            // Mostra info file
            document.getElementById('fileNameDisplay').textContent = file.name;
            document.getElementById('fileSizeDisplay').textContent = formatBytes(file.size);
            document.getElementById('pageCountDisplay').textContent = '';

            // Icona tipo file
            var iconEl = document.getElementById('fileTypeIcon');
            iconEl.className = 'bi ' + (FILE_ICONS[ext] || 'bi-file-earmark-text text-bocconi') + ' fs-2 flex-shrink-0';

            // Mostra area file info, nascondi upload prompt
            document.getElementById('noFileState').classList.add('d-none');
            document.getElementById('hasFileState').classList.remove('d-none');
            // Azzera eventuale avviso "file obbligatorio"
            var dropZone = document.getElementById('uploadDropZone');
            dropZone.style.borderColor = '';
            dropZone.style.backgroundColor = '';
            var warn = document.getElementById('noFileUploadWarn');
            if (warn) warn.remove();

            // Opzione conversione PDF
            var pdfBox = document.getElementById('convertPdfBox');
            var cb = document.getElementById('ConvertToPdf');
            if (OFFICE_EXTS.indexOf(ext) !== -1) {
                pdfBox.classList.remove('d-none');
            } else {
                pdfBox.classList.add('d-none');
                cb.checked = false;
            }

            // Sblocca campi
            unlockForm();

            // Auto-popola titolo se vuoto
            var titleInp = document.getElementById('matTitle');
            if (titleInp && titleInp.value.trim() === '') {
                titleInp.value = nameNoExt;
            }

            // Estrai autore da metadati
            var authorInp = document.getElementById('authorInput');
            if (authorInp && authorInp.value.trim() === '') {
                if (ZIP_EXTS.indexOf(ext) !== -1) {
                    extractOfficeAuthor(file).then(function(author) {
                        if (author && authorInp.value.trim() === '')
                            authorInp.value = author;
                    });
                } else if (ext === 'pdf') {
                    extractPdfMetadata(file).then(function(meta) {
                        if (meta && meta.author && authorInp.value.trim() === '')
                            authorInp.value = meta.author;
                    });
                }
            }

            // Estrai numero pagine/slide e popola campo form
            extractPageCount(file).then(function(result) {
                var pgInp = document.getElementById('pageCountInput');
                if (result) {
                    document.getElementById('pageCountDisplay').textContent =
                        result.count + ' ' + result.unit;
                    if (pgInp && !pgInp.value) pgInp.value = result.count;
                }
            });

            // Controlla titoli simili
            checkSimilarTitles(titleInp ? titleInp.value : '');
        }

        // ── Author autocomplete ────────────────────────────────────────────
        (function() {
            var authors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(existingAuthors));
            var inp  = document.getElementById('authorInput');
            var drop = document.getElementById('authorDropdown');
            if (!inp || !drop || !authors || !authors.length) return;

            function showDrop(matches) {
                drop.innerHTML = '';
                if (!matches.length) { drop.style.display = 'none'; return; }
                matches.forEach(function(a) {
                    var li  = document.createElement('li');
                    var btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'dropdown-item py-1 small';
                    btn.textContent = a;
                    btn.addEventListener('mousedown', function(e) {
                        e.preventDefault();
                        inp.value = a;
                        drop.style.display = 'none';
                        inp.dispatchEvent(new Event('input'));
                    });
                    li.appendChild(btn);
                    drop.appendChild(li);
                });
                drop.style.display = 'block';
            }

            function filter(term) {
                if (!term) { drop.style.display = 'none'; return; }
                var lc = term.toLowerCase();
                var m = authors.filter(function(a) {
                    return a && a.toLowerCase().indexOf(lc) !== -1;
                }).slice(0, 12);
                showDrop(m);
            }

            inp.addEventListener('input',  function() { filter(this.value.trim()); });
            inp.addEventListener('focus',  function() { if (this.value.trim()) filter(this.value.trim()); });
            inp.addEventListener('blur',   function() { setTimeout(function(){ drop.style.display='none'; }, 150); });
            inp.addEventListener('keydown', function(e) {
                var items = Array.from(drop.querySelectorAll('.dropdown-item'));
                if (e.key === 'ArrowDown' && items.length) { items[0].focus(); e.preventDefault(); }
                else if (e.key === 'Escape') { drop.style.display = 'none'; }
            });
            drop.addEventListener('keydown', function(e) {
                var items = Array.from(drop.querySelectorAll('.dropdown-item'));
                var idx = items.indexOf(document.activeElement);
                if (e.key === 'ArrowDown' && idx < items.length - 1) { items[idx+1].focus(); e.preventDefault(); }
                else if (e.key === 'ArrowUp') {
                    if (idx > 0) items[idx-1].focus(); else inp.focus();
                    e.preventDefault();
                } else if (e.key === 'Escape') { drop.style.display='none'; inp.focus(); }
            });
        })();
    </script>
}
