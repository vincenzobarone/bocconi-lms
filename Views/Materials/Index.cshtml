@model MaterialsIndexViewModel
@{
    ViewData["Title"] = T["mat.page_title","Materials Library"];
    var docTypes = Model.DocumentTypes;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-collection me-2"></i>@T["mat.page_title","Materials Library"]</h2>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Admin" asp-action="DocumentTypes" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-tags me-1"></i>@T["admin.doc_types","Document Types"]
            </a>
        }
        @if (User.IsInRole("Teacher") || User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-bocconi">
                <i class="bi bi-plus-lg me-1"></i>@T["mat.new_btn","New material"]
            </a>
        }
    </div>
</div>
@if (User.IsInRole("Student") && !User.IsInRole("Teacher") && !User.IsInRole("Admin"))
{
    <div class="alert alert-info d-flex align-items-center gap-2 mb-3 py-2">
        <i class="bi bi-info-circle"></i>
        <span>@T["mat.student_readonly","You can browse and download materials. For changes or uploads, contact your teacher."]</span>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">@T["mat.filter_title","Title"]</label>
                <input type="text" name="q" value="@Model.SearchTitle" class="form-control form-control-sm"
                       placeholder="@T["mat.search_placeholder","Search by title…"]" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">@T["mat.filter_lang","Language"]</label>
                <select name="lang" class="form-select form-select-sm">
                    <option value="">@T["mat.all_langs","— All —"]</option>
                    @foreach (var l in BocconiLMS.Models.Material.Languages)
                    {
                        <option value="@l" selected="@(Model.FilterLanguage == l ? "selected" : null)">@l</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">@T["mat.filter_type","Document type"]</label>
                <select name="typeId" class="form-select form-select-sm">
                    <option value="">@T["mat.all_types","— All —"]</option>
                    @foreach (var t in docTypes)
                    {
                        <option value="@t.Id" selected="@(Model.FilterTypeId == t.Id ? "selected" : null)">@t.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-bocconi btn-sm flex-grow-1">
                    <i class="bi bi-search me-1"></i>@T["common.filter","Filter"]
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="@T["common.reset","Reset"]">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Materials.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-collection display-4 d-block mb-3"></i>
        @if (User.IsInRole("Teacher") || User.IsInRole("Admin"))
        {
            <p>@T["mat.no_results","No materials found."] <a asp-action="Create">@T["mat.create_first","Create the first material"]</a>.</p>
        }
        else
        {
            <p>@T["mat.no_results_student","No materials available at the moment."]</p>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle" id="materialsTable">
            <thead class="table-light">
                <tr>
                    <th>@T["mat.filter_title","Title"]</th>
                    <th>@T["mat.col_type","Type"]</th>
                    <th>@T["mat.filter_lang","Language"]</th>
                    <th>@T["mat.col_author","Author"]</th>
                    <th class="text-center">@T["mat.col_status","Status"]</th>
                    <th class="text-center">@T["mat.col_version","Ver."]</th>
                    <th class="text-end">@T["common.actions","Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Materials)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@m.Id" class="fw-semibold text-decoration-none">@m.Title</a>
                            @if (m.ActiveVersion != null)
                            {
                                <span class="badge bg-secondary ms-1" style="font-size:.65rem;">@m.ActiveVersion.FileType</span>
                            }
                        </td>
                        <td><span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(m.DocumentTypeName) ? "—" : m.DocumentTypeName)</span></td>
                        <td>@m.Language</td>
                        <td class="text-muted small">@(string.IsNullOrEmpty(m.AuthorName) ? "—" : m.AuthorName)</td>
                        <td class="text-center">
                            @{
                                var (statusCss, statusLabel) = m.Status switch {
                                    "verificato"   => ("success",   T["mat.status_verificato","Verified"]),
                                    "in_revisione" => ("warning",   T["mat.status_in_revisione","In review"]),
                                    _              => ("secondary", T["mat.status_bozza","Draft"])
                                };
                            }
                            <span class="badge bg-@statusCss" style="font-size:.7rem;">@statusLabel</span>
                        </td>
                        <td class="text-center">
                            @if (m.CurrentVersion > 0)
                            {
                                <span class="version-badge">v@(m.CurrentVersion)</span>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex gap-1 justify-content-end">
                                <a asp-action="Details" asp-route-id="@m.Id" class="btn btn-sm btn-outline-info"
                                   title="@T["mat.details_btn","Details"]">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (m.ActiveVersion != null)
                                {
                                    <a asp-action="Download" asp-route-versionId="@m.ActiveVersion.Id"
                                       class="btn btn-sm btn-outline-primary"
                                       title="@T["mat.download_btn","Download active version"]">
                                        <i class="bi bi-download"></i>
                                    </a>
                                }
                                @if (User.IsInRole("Teacher") || User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@m.Id"
                                       class="btn btn-sm btn-outline-secondary"
                                       title="@T["common.edit","Edit"]">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@m.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                data-confirm="@T["common.delete","Delete"] «@m.Title»?"
                                                title="@T["common.delete","Delete"]">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#materialsTable').DataTable({ language: window.dtLang(), pageLength: 25 });
        });
    </script>
}
