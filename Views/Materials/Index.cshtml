@model MaterialsIndexViewModel
@{
    ViewData["Title"] = "Libreria Materiali";
    var docTypes = Model.DocumentTypes;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-collection me-2"></i>Libreria Materiali</h2>
    <a asp-action="Create" class="btn btn-bocconi">
        <i class="bi bi-plus-lg me-1"></i>Nuovo materiale
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Titolo</label>
                <input type="text" name="q" value="@Model.SearchTitle" class="form-control form-control-sm" placeholder="Cerca per titolo…" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Lingua</label>
                <select name="lang" class="form-select form-select-sm">
                    <option value="">— Tutte —</option>
                    @foreach (var l in BocconiLMS.Models.Material.Languages)
                    {
                        <option value="@l" selected="@(Model.FilterLanguage == l ? "selected" : null)">@l</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Tipo documento</label>
                <select name="typeId" class="form-select form-select-sm">
                    <option value="">— Tutti —</option>
                    @foreach (var t in docTypes)
                    {
                        <option value="@t.Id" selected="@(Model.FilterTypeId == t.Id ? "selected" : null)">@t.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-bocconi btn-sm flex-grow-1">
                    <i class="bi bi-search me-1"></i>Filtra
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Azzera filtri">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Materials.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-collection display-4 d-block mb-3"></i>
        <p>Nessun materiale trovato. <a asp-action="Create">Crea il primo materiale</a>.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle" id="materialsTable">
            <thead class="table-light">
                <tr>
                    <th>Titolo</th>
                    <th>Tipo</th>
                    <th>Lingua</th>
                    <th>Autore</th>
                    <th class="text-center">Ver.</th>
                    <th class="text-end">Azioni</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Materials)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@m.Id" class="fw-semibold text-decoration-none">@m.Title</a>
                            @if (m.ActiveVersion != null)
                            {
                                <span class="badge bg-secondary ms-1" style="font-size:.65rem;">@m.ActiveVersion.FileType</span>
                            }
                        </td>
                        <td><span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(m.DocumentTypeName) ? "—" : m.DocumentTypeName)</span></td>
                        <td>@m.Language</td>
                        <td class="text-muted small">@(string.IsNullOrEmpty(m.OwnerName) ? "—" : m.OwnerName)</td>
                        <td class="text-center">
                            @if (m.CurrentVersion > 0)
                            {
                                <span class="version-badge">v@(m.CurrentVersion)</span>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex gap-1 justify-content-end">
                                @if (m.ActiveVersion != null)
                                {
                                    <a asp-action="Download" asp-route-versionId="@m.ActiveVersion.Id"
                                       class="btn btn-sm btn-outline-primary" title="Scarica versione attiva">
                                        <i class="bi bi-download"></i>
                                    </a>
                                }
                                <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@m.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            data-confirm="Eliminare il materiale «@m.Title» e tutte le sue versioni?"
                                            title="Elimina">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#materialsTable').DataTable({ language: window.dtLang(), pageLength: 25 });
        });
    </script>
}
