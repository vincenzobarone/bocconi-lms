@model MaterialsIndexViewModel
@{
    ViewData["Title"] = T["mat.page_title"];
    var docTypes = Model.DocumentTypes;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-collection me-2"></i>@T["mat.page_title"]</h2>
    <div class="d-flex gap-2">
        @if ((bool)(ViewBag.CanCreate ?? false))
        {
            <a asp-action="Create" class="btn btn-bocconi">
                <i class="bi bi-plus-lg me-1"></i>@T["mat.new_btn"]
            </a>
        }
    </div>
</div>
@if (User.IsInRole("CanAttend") && !User.IsInRole("CanTeach") && !User.IsInRole("Admin"))
{
    <div class="alert alert-info d-flex align-items-center gap-2 mb-3 py-2">
        <i class="bi bi-info-circle"></i>
        <span>@T["mat.student_readonly"]</span>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            @* ── Riga 1: filtri originali ──────────────────────────────── *@
            <div class="col-md-4">
                <label class="form-label small fw-semibold">@T["mat.filter_title"]</label>
                <input type="text" name="q" value="@Model.SearchTitle" class="form-control form-control-sm"
                       placeholder="@T["mat.search_placeholder"]" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">@T["mat.filter_lang"]</label>
                <select name="lang" class="form-select form-select-sm">
                    <option value="">@T["mat.all_langs"]</option>
                    @foreach (var l in BocconiLMS.Models.Material.Languages)
                    {
                        <option value="@l" selected="@(Model.FilterLanguage == l ? "selected" : null)">@l</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">@T["mat.filter_type"]</label>
                <select name="typeId" class="form-select form-select-sm">
                    <option value="">@T["mat.all_types"]</option>
                    @foreach (var t in docTypes)
                    {
                        <option value="@t.Id" selected="@(Model.FilterTypeId == t.Id ? "selected" : null)">@t.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-bocconi btn-sm flex-grow-1">
                    <i class="bi bi-search me-1"></i>@T["common.filter"]
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="@T["common.reset"]">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>

            @* ── Riga 2: nuovi filtri ───────────────────────────────────── *@
            <div class="col-md-2">
                <label class="form-label small fw-semibold">@T["mat.filter_cat_year"]</label>
                <input type="number" name="catYear" value="@Model.FilterCatalogationYear"
                       class="form-control form-control-sm" placeholder="es. 2024" min="2000" max="2099" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">@T["mat.filter_mod_year"]</label>
                <input type="number" name="modYear" value="@Model.FilterModifiedYear"
                       class="form-control form-control-sm" placeholder="es. 2024" min="2000" max="2099" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">@T["mat.filter_folder_name"]</label>
                <input type="text" name="folderName" value="@Model.FilterFolderName"
                       class="form-control form-control-sm" placeholder="@T["mat.filter_folder_name_ph"]" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">@T["mat.filter_folder_id"]</label>
                <input type="number" name="folderId" value="@Model.FilterFolderId"
                       class="form-control form-control-sm" placeholder="es. 42" min="1" />
            </div>
            <div class="col-md-2">@* spacer *@</div>
        </form>
    </div>
</div>

@{
    // Costruisce la querystring con i filtri attivi per i link di export
    var exportQs = new System.Text.StringBuilder();
    if (!string.IsNullOrEmpty(Model.SearchTitle))        exportQs.Append($"&q={Uri.EscapeDataString(Model.SearchTitle)}");
    if (!string.IsNullOrEmpty(Model.FilterLanguage))     exportQs.Append($"&lang={Uri.EscapeDataString(Model.FilterLanguage)}");
    if (Model.FilterTypeId.HasValue)                     exportQs.Append($"&typeId={Model.FilterTypeId}");
    if (Model.FilterCatalogationYear.HasValue)           exportQs.Append($"&catYear={Model.FilterCatalogationYear}");
    if (Model.FilterModifiedYear.HasValue)               exportQs.Append($"&modYear={Model.FilterModifiedYear}");
    if (!string.IsNullOrEmpty(Model.FilterFolderName))   exportQs.Append($"&folderName={Uri.EscapeDataString(Model.FilterFolderName)}");
    if (Model.FilterFolderId.HasValue)                   exportQs.Append($"&folderId={Model.FilterFolderId}");
    var qs = exportQs.Length > 0 ? "?" + exportQs.ToString().TrimStart('&') : "";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted small">
        <i class="bi bi-list-ul me-1"></i>
        @Model.Materials.Count @T["mat.results_count"]
    </span>
    <div class="d-flex gap-2">
        <a href="@Url.Action("ExportExcel","Materials")@qs"
           class="btn btn-outline-success btn-sm"
           title="@T["mat.export_excel_hint"]">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>@T["mat.export_excel"]
        </a>
        <a href="@Url.Action("ExportPdf","Materials")@qs"
           class="btn btn-outline-danger btn-sm"
           title="@T["mat.export_pdf_hint"]">
            <i class="bi bi-file-earmark-pdf me-1"></i>@T["mat.export_pdf"]
        </a>
    </div>
</div>

@if (!Model.Materials.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-collection display-4 d-block mb-3"></i>
        @if ((bool)(ViewBag.CanCreate ?? false))
        {
            <p>@T["mat.no_results"] <a asp-action="Create">@T["mat.create_first"]</a>.</p>
        }
        else
        {
            <p>@T["mat.no_results_student"]</p>
        }
    </div>
}
else
{
    <form id="bulkForm" asp-action="BulkDownload" method="post">
        @Html.AntiForgeryToken()

        @* ── Barra selezione (nascosta finché non si seleziona almeno un elemento) *@
        <div id="bulkBar" class="d-none mb-3">
            <div class="alert alert-primary d-flex align-items-center justify-content-between py-2 mb-0">
                <span><i class="bi bi-check2-square me-2"></i><strong id="bulkCount">0</strong> @T["mat.selected"]</span>
                <div class="d-flex gap-2">
                    <button type="button" id="deselectAll" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-x-lg me-1"></i>@T["mat.deselect_all"]
                    </button>
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-file-zip me-1"></i>@T["mat.bulk_download"]
                    </button>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle" id="materialsTable">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width:38px;">
                            <input type="checkbox" id="selectAll" class="form-check-input" title="@T["mat.select_all"]" />
                        </th>
                        <th scope="col">@T["mat.filter_title"]</th>
                        <th scope="col">@T["mat.col_type"]</th>
                        <th scope="col">@T["mat.filter_lang"]</th>
                        <th scope="col">@T["mat.col_author"]</th>
                        <th scope="col" class="text-center">@T["mat.col_status"]</th>
                        <th scope="col" class="text-center">@T["mat.col_version"]</th>
                        <th scope="col" class="text-end">@T["common.actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Materials)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" name="ids" value="@m.Id"
                                       class="form-check-input mat-chk"
                                       @(m.ActiveVersion == null ? "disabled title=\"Nessun file disponibile\"" : "") />
                            </td>
                            <td>
                                @if (m.ActiveVersion != null)
                                {
                                    <a asp-action="Download" asp-route-versionId="@m.ActiveVersion.Id" class="fw-semibold text-decoration-none">@m.Title</a>
                                    <span class="badge bg-secondary ms-1" style="font-size:.65rem;">@m.ActiveVersion.FileType</span>
                                }
                                else
                                {
                                    <a asp-action="Details" asp-route-id="@m.Id" class="fw-semibold text-decoration-none">@m.Title</a>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(m.DocumentTypeName) ? "—" : m.DocumentTypeName)</span></td>
                            <td>@m.Language</td>
                            <td class="text-muted small">@(string.IsNullOrEmpty(m.AuthorName) ? "—" : m.AuthorName)</td>
                            <td class="text-center">
                                @{
                                    var (statusCss, statusLabel) = m.Status switch {
                                        "verificato"   => ("success",   T["mat.status_verificato"]),
                                        "in_revisione" => ("warning",   T["mat.status_in_revisione"]),
                                        _              => ("secondary", T["mat.status_bozza"])
                                    };
                                }
                                <span class="badge bg-@statusCss" style="font-size:.7rem;">@statusLabel</span>
                            </td>
                            <td class="text-center">
                                @if (m.CurrentVersion > 0)
                                {
                                    <a asp-action="Details" asp-route-id="@m.Id"
                                       class="version-badge text-decoration-none"
                                       title="@T["mat.details_btn"]">v@(m.CurrentVersion)</a>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end">
                                    @if (m.ActiveVersion != null)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-info btn-preview"
                                                data-version-id="@m.ActiveVersion.Id"
                                                data-file-type="@m.ActiveVersion.FileType"
                                                data-file-name="@m.ActiveVersion.FileName"
                                                data-material-id="@m.Id"
                                                title="@T["mat.preview_btn"]">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <a asp-action="Details" asp-route-id="@m.Id" class="btn btn-sm btn-outline-info"
                                           title="@T["mat.details_btn"]">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    @if ((bool)(ViewBag.CanEdit ?? false))
                                    {
                                        <a asp-action="Edit" asp-route-id="@m.Id"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="@T["common.edit"]">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                data-confirm="@T["common.delete"] «@m.Title»?"
                                                data-delete-url="@Url.Action("Delete", "Materials", new { id = m.Id })"
                                                title="@T["common.delete"]">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
}

@* ── Modal anteprima file ──────────────────────────────────────────── *@
<div class="modal fade" id="previewModal" tabindex="-1" aria-labelledby="previewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title fw-semibold text-truncate me-3" id="previewModalLabel" style="max-width:70%;"></h6>
                <div class="d-flex gap-2 ms-auto align-items-center">
                    <a href="#" id="previewDownloadBtn" class="btn btn-sm btn-outline-primary" title="Download">
                        <i class="bi bi-download"></i>
                    </a>
                    <a href="#" id="previewDetailsBtn" class="btn btn-sm btn-outline-secondary" title="Dettagli / nuova versione">
                        <i class="bi bi-clock-history me-1"></i>Versioni
                    </a>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
            </div>
            <div class="modal-body p-0" id="previewModalBody" style="min-height:70vh; background:#f5f5f5;">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js" crossorigin="anonymous"></script>
    <script>
        $(document).ready(function () {
            $('#materialsTable').DataTable({
                language: window.dtLang(),
                pageLength: 25,
                columnDefs: [{ orderable: false, targets: 0 }]
            });
        });

        // ── Bulk selection logic ──────────────────────────────────────────
        if (document.getElementById('bulkForm')) (function () {
            var selected = new Set();

            function refreshCheckboxes() {
                document.querySelectorAll('.mat-chk').forEach(function (cb) {
                    if (!cb.disabled) cb.checked = selected.has(cb.value);
                });
                var all = document.getElementById('selectAll');
                var total = document.querySelectorAll('.mat-chk:not(:disabled)').length;
                all.indeterminate = selected.size > 0 && selected.size < document.querySelectorAll('.mat-chk:not(:disabled)[data-selectable]').length;
                all.checked = total > 0 && document.querySelectorAll('.mat-chk:not(:disabled)').length === selected.size;
            }

            function updateBulkBar() {
                var bar = document.getElementById('bulkBar');
                var cnt = document.getElementById('bulkCount');
                if (selected.size > 0) {
                    bar.classList.remove('d-none');
                    cnt.textContent = selected.size;
                } else {
                    bar.classList.add('d-none');
                }
                var all = document.getElementById('selectAll');
                var enabledOnPage = document.querySelectorAll('.mat-chk:not(:disabled)').length;
                var checkedOnPage = Array.from(document.querySelectorAll('.mat-chk:not(:disabled)')).filter(function(cb){ return selected.has(cb.value); }).length;
                all.indeterminate = checkedOnPage > 0 && checkedOnPage < enabledOnPage;
                all.checked = enabledOnPage > 0 && checkedOnPage === enabledOnPage;
            }

            // Re-sync checkboxes on DataTable page redraw
            $('#materialsTable').on('draw.dt', function () {
                refreshCheckboxes();
                updateBulkBar();
            });

            document.addEventListener('change', function (e) {
                if (e.target.id === 'selectAll') {
                    document.querySelectorAll('.mat-chk:not(:disabled)').forEach(function (cb) {
                        if (e.target.checked) selected.add(cb.value); else selected.delete(cb.value);
                        cb.checked = e.target.checked;
                    });
                    updateBulkBar();
                } else if (e.target.classList.contains('mat-chk')) {
                    if (e.target.checked) selected.add(e.target.value); else selected.delete(e.target.value);
                    updateBulkBar();
                }
            });

            document.getElementById('deselectAll').addEventListener('click', function () {
                selected.clear();
                document.querySelectorAll('.mat-chk').forEach(function (cb) { cb.checked = false; });
                document.getElementById('selectAll').checked = false;
                updateBulkBar();
            });

            // Inject hidden inputs on form submit so all selected IDs (across pages) are POSTed
            document.getElementById('bulkForm').addEventListener('submit', function () {
                document.querySelectorAll('input[name="ids"]').forEach(function (el) { el.remove(); });
                selected.forEach(function (id) {
                    var inp = document.createElement('input');
                    inp.type = 'hidden';
                    inp.name = 'ids';
                    inp.value = id;
                    document.getElementById('bulkForm').appendChild(inp);
                });
            });
        })();

        (function () {
            var imageTypes = ['PNG','JPG','JPEG','GIF','SVG','BMP','WEBP'];
            var videoTypes = ['MP4','WEBM','MOV','AVI','MKV'];

            function openPreview(versionId, fileType, fileName, materialId) {
                var previewUrl  = '/Materials/Preview?versionId=' + versionId;
                var downloadUrl = '/Materials/Download?versionId=' + versionId;

                document.getElementById('previewModalLabel').textContent = fileName;
                document.getElementById('previewDownloadBtn').href = downloadUrl;

                var detailsBtn = document.getElementById('previewDetailsBtn');
                if (materialId) {
                    detailsBtn.href = '/Materials/Details/' + materialId;
                    detailsBtn.style.display = '';
                } else {
                    detailsBtn.style.display = 'none';
                }

                var body = document.getElementById('previewModalBody');

                bootstrap.Modal.getOrCreateInstance(document.getElementById('previewModal')).show();

                if (fileType === 'PDF') {
                    // PDF: PDF.js su canvas — evita blocchi Edge/Chrome per iframe con PDF
                    body.innerHTML =
                        '<div class="d-flex justify-content-center align-items-center" style="min-height:70vh;">' +
                        '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Caricamento...</span></div></div>';
                    fetch(previewUrl, { credentials: 'same-origin' })
                        .then(function(r) { return r.ok ? r.arrayBuffer() : Promise.reject(r.status); })
                        .then(function(buf) {
                            pdfjsLib.GlobalWorkerOptions.workerSrc =
                                'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
                            return pdfjsLib.getDocument({ data: buf }).promise;
                        })
                        .then(function(pdf) {
                            body._pdfDoc = pdf;
                            var wrap = document.createElement('div');
                            wrap.style.cssText = 'overflow-y:auto;height:80vh;background:#616161;padding:12px;box-sizing:border-box;';
                            body.innerHTML = '';
                            body.appendChild(wrap);
                            var seq = Promise.resolve();
                            for (var n = 1; n <= pdf.numPages; n++) {
                                (function(pageNum) {
                                    seq = seq.then(function() {
                                        return pdf.getPage(pageNum).then(function(page) {
                                            var vp0 = page.getViewport({ scale: 1 });
                                            var scale = Math.min((wrap.clientWidth - 24) / vp0.width, 2);
                                            var vp = page.getViewport({ scale: scale });
                                            var canvas = document.createElement('canvas');
                                            canvas.width  = vp.width;
                                            canvas.height = vp.height;
                                            canvas.style.cssText = 'display:block;margin:0 auto 8px;box-shadow:0 2px 8px rgba(0,0,0,.5);background:#fff;';
                                            wrap.appendChild(canvas);
                                            return page.render({ canvasContext: canvas.getContext('2d'), viewport: vp }).promise;
                                        });
                                    });
                                })(n);
                            }
                            return seq;
                        })
                        .catch(function() {
                            body.innerHTML =
                                '<div class="text-center p-5">' +
                                '<i class="bi bi-exclamation-triangle display-1 text-warning d-block mb-3"></i>' +
                                '<p class="text-muted mb-4">Impossibile caricare l\'anteprima.<br>Prova a scaricare il file.</p>' +
                                '<a href="' + downloadUrl + '" class="btn btn-bocconi"><i class="bi bi-download me-2"></i>Scarica</a></div>';
                        });
                } else if (imageTypes.includes(fileType) || videoTypes.includes(fileType)) {
                    body.innerHTML =
                        '<div class="d-flex justify-content-center align-items-center" style="min-height:70vh;">' +
                        '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Caricamento...</span></div></div>';
                    fetch(previewUrl, { credentials: 'same-origin' })
                        .then(function(r) { return r.ok ? r.blob() : Promise.reject(r.status); })
                        .then(function(blob) {
                            var blobUrl = URL.createObjectURL(blob);
                            body._blobUrl = blobUrl;
                            if (imageTypes.includes(fileType)) {
                                body.innerHTML =
                                    '<div class="d-flex align-items-center justify-content-center p-3" style="min-height:70vh;">' +
                                    '<img src="' + blobUrl + '" style="max-width:100%;max-height:80vh;object-fit:contain;" /></div>';
                            } else {
                                body.innerHTML =
                                    '<video controls class="w-100 d-block" style="max-height:80vh;background:#000;">' +
                                    '<source src="' + blobUrl + '" /></video>';
                            }
                        })
                        .catch(function() {
                            body.innerHTML =
                                '<div class="text-center p-5">' +
                                '<i class="bi bi-exclamation-triangle display-1 text-warning d-block mb-3"></i>' +
                                '<p class="text-muted mb-4">Impossibile caricare l\'anteprima.<br>Prova a scaricare il file.</p>' +
                                '<a href="' + downloadUrl + '" class="btn btn-bocconi">' +
                                '<i class="bi bi-download me-2"></i>Scarica</a></div>';
                        });
                } else {
                    body.innerHTML =
                        '<div class="text-center p-5">' +
                        '<i class="bi bi-file-earmark-text display-1 text-muted d-block mb-3"></i>' +
                        '<p class="text-muted mb-4">Anteprima non disponibile per i file <strong>.' + fileType + '</strong>.<br>' +
                        'Scarica il file per visualizzarlo.</p>' +
                        '<a href="' + downloadUrl + '" class="btn btn-bocconi">' +
                        '<i class="bi bi-download me-2"></i>Scarica</a></div>';
                }
            }

            // Event delegation: works with DataTable pagination
            document.addEventListener('click', function (e) {
                var btn = e.target.closest('.btn-preview');
                if (!btn) return;
                e.preventDefault();
                openPreview(
                    btn.dataset.versionId,
                    (btn.dataset.fileType || '').toUpperCase(),
                    btn.dataset.fileName || '',
                    btn.dataset.materialId || null
                );
            });

            document.getElementById('previewModal').addEventListener('hidden.bs.modal', function () {
                var body = document.getElementById('previewModalBody');
                if (body._blobUrl) { URL.revokeObjectURL(body._blobUrl); body._blobUrl = null; }
                if (body._pdfDoc) { body._pdfDoc.destroy(); body._pdfDoc = null; }
                body.innerHTML = '';
            });

            window.bocconiOpenPreview = openPreview;
        })();
    </script>
}
