@model int
@{
    var steps = new[] { "Connessione", "Tabella", "Mapping", "Risultato" };
}
<div class="d-flex align-items-center mb-4 gap-0" aria-label="Wizard step @(Model+1) di @steps.Length">
    @for (int i = 0; i < steps.Length; i++)
    {
        var done    = i < Model;
        var current = i == Model;
        <div class="d-flex align-items-center @(i < steps.Length - 1 ? "flex-grow-1" : "")">
            <div class="d-flex flex-column align-items-center">
                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                     style="width:2rem;height:2rem;font-size:.85rem;
                            background:@(done ? "#198754" : current ? "var(--bocconi-blue)" : "#dee2e6");
                            color:@(done || current ? "#fff" : "#6c757d");">
                    @if (done) { <i class="bi bi-check-lg"></i> }
                    else { <span>@(i + 1)</span> }
                </div>
                <small class="mt-1 text-nowrap"
                       style="color:@(done ? "#198754" : current ? "var(--bocconi-blue)" : "#6c757d");
                              font-weight:@(current ? "600" : "400");font-size:.75rem;">
                    @steps[i]
                </small>
            </div>
            @if (i < steps.Length - 1)
            {
                <div class="flex-grow-1 mx-1 mb-3"
                     style="height:2px;background:@(done ? "#198754" : "#dee2e6");"></div>
            }
        </div>
    }
</div>
