@inject BocconiLMS.Services.AppVersionService _ver
<!DOCTYPE html>
<html lang="@T.CurrentLanguage">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bocconi LMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.3/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-bocconi shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold fs-4" asp-controller="Home" asp-action="Index">
            <i class="bi bi-mortarboard-fill me-2"></i>Bocconi LMS
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Course" asp-action="Index">
                        <i class="bi bi-book me-1"></i>@T["nav.courses"]
                    </a>
                </li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Dashboard">
                            <i class="bi bi-speedometer2 me-1"></i>@T["nav.dashboard"]
                        </a>
                    </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-gear me-1"></i>@T["nav.admin"]
                            </a>
                        </li>
                    }
                }
            </ul>
            <ul class="navbar-nav ms-auto align-items-center">

                @{
                    var currentLang = T.CurrentLanguage;
                    var allLangs = BocconiLMS.Services.TranslationService.AllLanguages;
                    var currentLangInfo = allLangs.FirstOrDefault(l => l.Code == currentLang);
                }
                <li class="nav-item dropdown me-2">
                    <a class="nav-link dropdown-toggle d-flex align-items-center gap-1" href="#"
                       data-bs-toggle="dropdown" title="Language / Lingua">
                        <span>@currentLangInfo.Flag</span>
                        <span class="text-uppercase small fw-semibold">@currentLang</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        @foreach (var lang in allLangs)
                        {
                            <li>
                                <form asp-controller="Language" asp-action="Set" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="lang" value="@lang.Code" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <button type="submit"
                                            class="dropdown-item d-flex align-items-center gap-2 @(lang.Code == currentLang ? "active" : "")">
                                        <span>@lang.Flag</span>
                                        <span>@lang.Name</span>
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </li>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><span class="dropdown-item-text text-muted small">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                    <i class="bi bi-key me-1"></i>Cambia password
                                </a>
                            </li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-1"></i>@T["nav.logout"]
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i>@T["nav.login"]
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<main class="py-4">
    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </div>
</main>

<footer class="footer mt-auto py-3 bg-light border-top">
    <div class="container text-center text-muted small">
        &copy; @DateTime.Now.Year Università Bocconi — @T["footer.copyright"]
        <span class="footer-rev" title="@_ver.Environment">
            &nbsp;·&nbsp;<span class="@(_ver.Environment == "Development" ? "rev-dev" : "rev-prod")">&#9679;</span>&nbsp;<code>@_ver.CommitHash</code>
        </span>
    </div>
</footer>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/2.0.3/js/dataTables.min.js"></script>
<script src="https://cdn.datatables.net/2.0.3/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.21.0/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
<script>
window.currentLang = '@T.CurrentLanguage';
window.dtIT = {
    search: "Cerca:", lengthMenu: "Mostra _MENU_ righe",
    info: "Da _START_ a _END_ di _TOTAL_ elementi",
    infoEmpty: "Nessun elemento", infoFiltered: "(su _MAX_ totali)",
    zeroRecords: "Nessun risultato trovato", emptyTable: "Tabella vuota",
    paginate: { first: "Primo", last: "Ultimo", next: "Succ.", previous: "Prec." }
};
window.dtLang = function() { return window.currentLang === 'it' ? window.dtIT : {}; };
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
