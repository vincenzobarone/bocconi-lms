@inject BocconiLMS.Services.AppVersionService _ver
@inject BocconiLMS.Services.FeatureFlagService _features
@inject BocconiLMS.Data.RolePermissionRepository _menuPerms
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _env
@functions {
    string ResolveAlert(object? raw)
    {
        if (raw is not string s || s.Length == 0) return string.Empty;
        if (s[0] != '§') return s;
        var parts = s[1..].Split('|');
        var translation = T[parts[0]];
        if (parts.Length == 1) return translation;
        try { return string.Format(translation, parts[1..]); }
        catch { return translation; }
    }
}
@{
    var coursesEnabled   = await _features.IsCoursesEnabledAsync();
    var materialsEnabled = await _features.IsMaterialsEnabledAsync();
    var _menuRoleName = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var canSeeMaterials = User.Identity?.IsAuthenticated == true
        && (User.IsInRole("Admin") || (materialsEnabled && await _menuPerms.HasMenuPermissionAsync(_menuRoleName, "menu.materials")));
    var canSeeUsers = User.Identity?.IsAuthenticated == true
        && (User.IsInRole("Admin") || await _menuPerms.HasMenuPermissionAsync(_menuRoleName, "menu.users"));
    var canSeeTranslations = User.Identity?.IsAuthenticated == true
        && (User.IsInRole("Admin") || await _menuPerms.HasMenuPermissionAsync(_menuRoleName, "menu.translations"));
}
<!DOCTYPE html>
<html lang="@T.CurrentLanguage">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Didasco</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.3/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<a class="visually-hidden-focusable" href="#main-content">@T["layout.skip_to_content"]</a>
<nav class="navbar navbar-expand-lg navbar-dark bg-bocconi shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold fs-4" asp-controller="Home" asp-action="Index">
            <i class="bi bi-mortarboard-fill me-2"></i>Didasco
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav me-auto">
                @if (coursesEnabled)
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Course" asp-action="Index">
                            <i class="bi bi-book me-1"></i>@T["nav.courses"]
                        </a>
                    </li>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Dashboard">
                            <i class="bi bi-speedometer2 me-1"></i>@T["nav.dashboard"]
                        </a>
                    </li>
                    @if (canSeeMaterials)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Materials" asp-action="Index">
                                <i class="bi bi-collection me-1"></i>@T["mat.nav"]
                            </a>
                        </li>
                    }
                    @if (canSeeUsers)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Users">
                                <i class="bi bi-people me-1"></i>@T["nav.users"]
                            </a>
                        </li>
                    }
                    @if (canSeeTranslations)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Dictionary">
                                <i class="bi bi-journal-bookmark me-1"></i>@T["nav.dictionary"]
                            </a>
                        </li>
                    }
                }
            </ul>
            <ul class="navbar-nav ms-auto align-items-center">

                @{
                    var currentLang = T.CurrentLanguage;
                    var enabledLangs = T.EnabledLanguages;
                    var currentLangInfo = enabledLangs.FirstOrDefault(l => l.Code == currentLang);
                    if (currentLangInfo == default) currentLangInfo = enabledLangs.First();
                }
                @if (enabledLangs.Count > 1)
                {
                <li class="nav-item dropdown me-2">
                    <a class="nav-link dropdown-toggle d-flex align-items-center gap-1" href="#"
                       data-bs-toggle="dropdown" title="Language / Lingua">
                        <span>@currentLangInfo.Flag</span>
                        <span class="text-uppercase small fw-semibold">@currentLang</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        @foreach (var lang in enabledLangs)
                        {
                            <li>
                                <form asp-controller="Language" asp-action="Set" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="lang" value="@lang.Code" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <button type="submit"
                                            class="dropdown-item d-flex align-items-center gap-2 @(lang.Code == currentLang ? "active" : "")">
                                        <span>@lang.Flag</span>
                                        <span>@lang.Name</span>
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </li>
                }

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><span class="dropdown-item-text text-muted small">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                    <i class="bi bi-key me-1"></i>@T["nav.change_password"]
                                </a>
                            </li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-1"></i>@T["nav.logout"]
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i>@T["nav.login"]
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<main id="main-content" class="py-4" tabindex="-1">
    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@ResolveAlert(TempData["Success"])
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle me-2"></i>@ResolveAlert(TempData["Error"])
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Warning"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@ResolveAlert(TempData["Warning"])
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </div>
</main>

<footer class="footer mt-auto py-3 bg-light border-top">
    <div class="container text-center text-muted small">
        &copy; @DateTime.Now.Year Università Bocconi — @T["footer.copyright"]
        @if (_ver.Environment == "Development" && _ver.CommitHash != "–")
        {
            <span class="footer-rev" title="@_ver.Environment">
                &nbsp;·&nbsp;<span class="rev-dev">&#9679;</span>&nbsp;<code>@_ver.CommitHash</code>
            </span>
        }
    </div>
</footer>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/2.0.3/js/dataTables.min.js"></script>
<script src="https://cdn.datatables.net/2.0.3/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.21.0/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
<script src="~/js/accessibility.js" asp-append-version="true"></script>
<script>
window.currentLang = '@T.CurrentLanguage';
window.dtIT = {
    search: "Cerca:", lengthMenu: "Mostra _MENU_ righe",
    info: "Da _START_ a _END_ di _TOTAL_ elementi",
    infoEmpty: "Nessun elemento", infoFiltered: "(su _MAX_ totali)",
    zeroRecords: "Nessun risultato trovato", emptyTable: "Tabella vuota"
};
window.dtLang = function() { return window.currentLang === 'it' ? window.dtIT : {}; };
function togglePwd(btn) {
    var inp = btn.closest('.input-group').querySelector('input[type=password],input[type=text]');
    var icon = btn.querySelector('i');
    if (inp.type === 'password') { inp.type = 'text'; icon.className = 'bi bi-eye-slash'; }
    else                         { inp.type = 'password'; icon.className = 'bi bi-eye'; }
}
setTimeout(function () {
    document.querySelectorAll('.alert.alert-dismissible').forEach(function (el) {
        var alert = bootstrap.Alert.getOrCreateInstance(el);
        alert.close();
    });
}, 6000);
</script>
@await RenderSectionAsync("Scripts", required: false)

<div class="modal fade" id="confirmModal" tabindex="-1" aria-modal="true" role="dialog">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body py-4 text-center">
                <i class="bi bi-exclamation-triangle-fill text-warning fs-2 d-block mb-3"></i>
                <p class="mb-0 fw-semibold" id="confirmModalBody"></p>
            </div>
            <div class="modal-footer justify-content-center border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    @T["common.cancel"]
                </button>
                <button type="button" class="btn btn-danger" id="confirmModalOk">
                    @T["common.confirm"]
                </button>
            </div>
        </div>
    </div>
</div>
<form id="globalDeleteForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>
<script>
(function() {
    var pendingForm = null;
    var pendingDeleteUrl = null;
    document.addEventListener('click', function(e) {
        var btn = e.target.closest('[data-confirm]');
        if (!btn) return;
        e.preventDefault();
        e.stopImmediatePropagation();
        pendingDeleteUrl = btn.dataset.deleteUrl || null;
        pendingForm = pendingDeleteUrl ? null : btn.closest('form');
        document.getElementById('confirmModalBody').textContent = btn.dataset.confirm;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('confirmModal')).show();
    });
    document.getElementById('confirmModalOk').addEventListener('click', function() {
        bootstrap.Modal.getInstance(document.getElementById('confirmModal')).hide();
        if (pendingDeleteUrl) {
            var f = document.getElementById('globalDeleteForm');
            if (f) { f.action = pendingDeleteUrl; f.submit(); }
            pendingDeleteUrl = null;
        } else if (pendingForm) {
            pendingForm.submit();
            pendingForm = null;
        }
    });
})();
function bocconiFileInput(inp, spanId) {
    var span = document.getElementById(spanId);
    span.textContent = inp.files.length > 0 ? inp.files[0].name : (span.dataset.placeholder || '');
}

// ── Disabilita il pulsante di salvataggio durante il submit ───────────────
(function () {
    var _pendingBtn = null;

    // Cattura quale pulsante è stato cliccato (fase capture, prima di tutto)
    document.addEventListener('click', function (e) {
        var btn = e.target.closest('button[type="submit"], input[type="submit"]');
        if (btn) _pendingBtn = btn;
    }, true);

    document.addEventListener('submit', function (e) {
        // Se jQuery Unobtrusive Validation ha già chiamato preventDefault → validazione fallita, non disabilitare
        if (e.defaultPrevented) { _pendingBtn = null; return; }

        var form  = e.target;
        var btn   = (_pendingBtn && form.contains(_pendingBtn))
                        ? _pendingBtn
                        : form.querySelector('button[type="submit"], input[type="submit"]');
        _pendingBtn = null;

        if (!btn || btn.disabled) return;

        btn.disabled = true;

        // Sostituisce l'icona Bootstrap Icons con uno spinner, altrimenti lo prepende
        var icon = btn.querySelector('i[class*="bi-"]');
        if (icon) {
            icon.className = 'spinner-border spinner-border-sm';
            icon.setAttribute('role', 'status');
            icon.setAttribute('aria-hidden', 'true');
        } else {
            var sp = document.createElement('span');
            sp.className = 'spinner-border spinner-border-sm me-1';
            sp.setAttribute('role', 'status');
            sp.setAttribute('aria-hidden', 'true');
            btn.prepend(sp);
        }
    }, false);
})();
</script>
@if (_env.IsDevelopment())
{
<script>
(function () {
    var connected = false;
    function trySSE() {
        var es = new EventSource('/_framework/aspnetcore-browser-refresh');
        es.onopen = function () { connected = true; };
        es.onmessage = function (e) {
            if (e.data && (e.data.indexOf('reload') !== -1 || e.data.indexOf('Reload') !== -1)) {
                window.location.reload();
            }
        };
        es.onerror = function () {
            es.close();
            connected = false;
            startPolling();
        };
    }
    function startPolling() {
        var wasDown = false;
        setInterval(function () {
            fetch('/health', { cache: 'no-store' })
                .then(function (r) {
                    if (wasDown && r.ok) { window.location.reload(); }
                    wasDown = !r.ok;
                })
                .catch(function () { wasDown = true; });
        }, 1000);
    }
    try { trySSE(); } catch (e) { startPolling(); }
})();
</script>
}
</body>
</html>
