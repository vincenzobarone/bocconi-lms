<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*"
             modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\BocconiLMS.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!--
            Development: disabilita la fail-fast guard SAML e lascia che
            PublicOrigin venga rilevato automaticamente dall'URL della richiesta
            (funziona sia con https://didasco.local che con qualsiasi altro host).
            Cambiare in "Production" solo quando si punta all'IdP Bocconi reale
            e si imposta SAML_IDP_METADATA_URL nella sezione sottostante.
          -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />

          <!--
            Connessione MySQL — obbligatoria. Stessa stringa usata in sviluppo.
            Alternativa: impostare MYSQL_CONNECTION_STRING come variabile di sistema
            di Windows / IIS Application Pool e rimuovere questa riga.
          -->
          <!-- <environmentVariable name="MYSQL_CONNECTION_STRING"
               value="Server=HOST;Port=3306;Database=BocconiEdu;User=UTENTE;Password=PASSWORD;" /> -->

          <!--
            Variabili SAML necessarie SOLO in produzione (ASPNETCORE_ENVIRONMENT=Production).
            In Development non servono: viene usato automaticamente lo StubIdP di test.
          -->
          <!-- <environmentVariable name="SAML_IDP_METADATA_URL"   value="https://idp.unibocconi.it/metadata/..." /> -->
          <!-- <environmentVariable name="SAML_IDP_ENTITY_ID"       value="https://idp.unibocconi-prod.it/idp/shibboleth" /> -->
          <!-- <environmentVariable name="SAML_SP_ENTITY_ID"        value="https://didasco.unibocconi.it" /> -->
          <!-- <environmentVariable name="SAML_SP_BASE_URL"         value="https://didasco.unibocconi.it" /> -->
          <!-- <environmentVariable name="SAML_SP_CERT_PFX"         value="BASE64_PKCS12_BUNDLE" /> -->
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
