<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Timestamp di build incorporato nel DLL — funziona su qualsiasi macchina/CI
         senza dipendenze da git. Formato: ddMMyyyyHHmm  es. 200520261643
         InformationalVersion è valutato qui (prima di tutti i target), poi
         IncludeSourceRevisionInInformationalVersion=false impedisce al SDK
         di sovrascriverlo aggiungendo l'hash git in coda. -->
    <InformationalVersion>$([System.DateTime]::UtcNow.ToString("ddMMyyyyHHmm"))</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="BocconiLMS.Tests/**" />
    <Content Remove="BocconiLMS.Tests/**" />
    <EmbeddedResource Remove="BocconiLMS.Tests/**" />
    <None Remove="BocconiLMS.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
    <PackageReference Include="QuestPDF" Version="2025.1.0" />
    <PackageReference Include="Sustainsys.Saml2.AspNetCore2" Version="2.11.0" />
  </ItemGroup>

</Project>
